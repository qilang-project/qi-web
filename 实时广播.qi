// Qi Web - 实时广播（PubSub / 跨连接共享实时页面）
//
// 定位：在 实时页面.qi（每连接独立状态、无广播）之上，补一层**框架级 PubSub**，
// 让「同一 topic（如同一个家庭）」的所有 WebSocket 连接**共享同一份状态并互相广播**。
// 任一连接触发事件 → 服务端改共享状态（通常落 DB）→ 广播重渲染给该 topic 全部连接。
//
// v2 新增：**广播频道句柄化**（对标 Phoenix.PubSub.broadcast）——
//   变量 频道: 整数 = 创建广播频道();
//   应用值 = 共享WS路由带频道(应用值, "/board/ws", 频道, 准入, 渲染, 处理);
//   ...
//   频道广播(频道, topic, 渲染(topic));        // 任意位置服务端主动推（定时任务、
//   频道指令(频道, topic, 指令_标题("有新消息")); // LLM 完成回调、HTTP handler 里都行）
//   频道在线数(频道, topic);                    // 该 topic 当前活跃连接数
// 老 共享WS路由 签名不变（内部自建频道），既有代码零改动。
// 新页面推荐使用：
//   共享实时块路由*          渲染函数直接返回 HTML块
//   共享实时块结果路由*      再加结构化 实时事件结果，可表达 no-op/当前/广播/指令
//
// ── 心跳：已从「必需」降级为「可选保活」（2026-07-16 运行时根治）──────────
// 【历史】早期运行时 WS 连接池是一把全局 Mutex，`WS::接收文本` 在阻塞读期间独占它，
//   导致向一个 park 在 接收文本 的连接 push 会一直阻塞——纯服务端广播发不出去。
//   当时的破解是客户端每 ~200ms 发 __心跳__ 逼 接收文本 周期性返回、释放锁。
// 【现在已修】运行时把 WS 池改成 Arc<连接>（qi-runtime/src/io/websocket_ffi.rs）：
//   recv 用 &TcpStream 读、不加锁；send 走各连接独立的 send_lock；两者互不阻塞。
//   → **广播 push 到正在 recv 的连接立即成功，不再依赖心跳**。心跳现在纯做
//   保活/探活，间隔可放大到数十秒甚至传 0 关掉。
//
// ── 并发与死锁 ────────────────────────────────────────────────
// 每个频道一把 同步锁 保护 topic→连接集合 的注册表。广播时**先在锁内抓一份
// 连接句柄快照，出锁后再逐个发送**——发送不阻塞（目标 recv 与 send 各用各的锁），
// 且此刻本 goroutine 不持有任何我们自己的锁，注册表锁与连接池锁永不嵌套，故无死锁。
//
// ── 协议 ──────────────────────────────────────────────────────
//   连接后客户端首帧必须是订阅：{"event":"__订阅__","payload": <订阅载荷JSON>}
//     准入函数(订阅载荷JSON) 校验（如验 session token）→ 返回 topic（空串=拒绝断开）
//   之后：
//     {"event":"__心跳__","payload":{}}         —— 保活探活；服务端不处理不渲染
//     {"event":"<业务事件>","payload":{...}}    —— 事件处理函数(topic,事件,载荷)：返回 1 广播 / 0 只回发自己
//   下行：{"html":"<片段>"} morph 进 #qi-live；{"commands":[...]} 浏览器指令
//   （客户端运行时与 实时页面.qi 完全同一份，见 实时运行时构建）
包 Web;

导入 标准库.字符串;
导入 标准库.WebSocket 作为 WS;
导入 标准库.JSON 作为 J;
导入 标准库.列表 作为 列表库;
导入 标准库.同步 作为 同步;
导入 标准库.Redis 作为 Redis;
导入 标准库.随机 作为 随机;
导入 标准库.时间 作为 时间;

// ── 广播频道 ────────────────────────────────────────────────────
//
// 频道 = 一个 J 对象句柄：{"锁": 同步锁句柄, "表": topic→连接列表 的 J 映射句柄}。
// App 持有频道句柄后可以在任何 goroutine 主动广播，不再局限于事件回调。

// 结构化事件结果：解决旧 1/0 返回值无法表达“数据没变，不要重渲染”的问题。
// 重渲染=0 时不发送 HTML；广播=1 时把新 HTML 发给 topic 全体，否则只发操作者。
// 指令只发给操作者，适合成功提示、跳转、滚动等反馈。
公开 类型 实时事件结果 {
    整数 重渲染;
    整数 广播;
    字符串 指令;
}

公开 函数 实时不更新() : 实时事件结果 {
    返回 新建 实时事件结果 { 重渲染: 0, 广播: 0, 指令: "" };
}

公开 函数 实时更新当前() : 实时事件结果 {
    返回 新建 实时事件结果 { 重渲染: 1, 广播: 0, 指令: "" };
}

公开 函数 实时广播更新() : 实时事件结果 {
    返回 新建 实时事件结果 { 重渲染: 1, 广播: 1, 指令: "" };
}

公开 函数 实时结果带指令(结果值: 实时事件结果, 指令文本: 字符串) : 实时事件结果 {
    结果值.指令 = 指令文本;
    返回 结果值;
}

// Command 的通用资源结果 → LiveView 更新策略。只有提交成功且数据确实变化才广播。
公开 函数 资源结果转实时(结果值: 资源结果) : 实时事件结果 {
    如果 (结果值.成功 == 1 与 结果值.已变化 == 1) { 返回 实时广播更新(); }
    返回 实时不更新();
}

// 带默认 UX：成功/失败都给操作者轻提示；只有成功且数据变化才广播。
公开 函数 资源结果转实时提示(结果值: 资源结果) : 实时事件结果 {
    变量 实时值: 实时事件结果 = 资源结果转实时(结果值);
    变量 类型值: 字符串 = "error";
    如果 (结果值.成功 == 1) { 类型值 = "success"; }
    返回 实时结果带指令(实时值, 指令_提示(结果值.消息, 类型值));
}

公开 函数 创建广播频道() : 整数 {
    变量 频道: 整数 = J.创建对象();
    J.设置整数(频道, "锁", 同步::创建锁());
    J.设置整数(频道, "表", J.创建对象());
    返回 频道;
}

// 服务端主动向 topic 全体广播一帧重渲染。返回成功发送的连接数。
公开 函数 频道广播(频道: 整数, topic: 字符串, 片段: 字符串) : 整数 {
    变量 数: 整数 = 广播(J.获取整数(频道, "锁"), J.获取整数(频道, "表"), topic, 片段);
    转发到Redis(频道, topic, "html", 片段);
    返回 数;
}

// 服务端主动向 topic 全体下发一条浏览器指令（用 实时页面.qi 的 指令_* 构造）。
公开 函数 频道指令(频道: 整数, topic: 字符串, 指令文本: 字符串) : 整数 {
    变量 帧文本: 字符串 = "{\"commands\":[" + 指令文本 + "]}";
    变量 数: 整数 = 广播帧(J.获取整数(频道, "锁"), J.获取整数(频道, "表"), topic, 帧文本);
    转发到Redis(频道, topic, "raw", 帧文本);
    返回 数;
}

// ── 跨进程广播（Redis 中继）────────────────────────────────────
//
// 上面那套广播只到**本进程**为止：连接表就在这个进程的内存里。单机单进程
// 没问题，起第二个实例就露馅 —— 甲连在 A 进程、乙连在 B 进程，甲的操作
// 乙永远看不到，而且**两边都不报错**，只是「有时候不刷新」。
//
// 接上 Redis 之后：本地广播照发，同时 PUBLISH 一份；每个进程有一个中继泵
// 在 SUBSCRIBE 上收，收到就在自己这边发一遍。
//
//   变量 频道: 整数 = 创建广播频道();
//   频道接Redis(频道, "redis://127.0.0.1:46379/0", "myapp:live");
//
// **自己发的自己不重发**：每个进程启动时生成一个实例号带在消息里，收到
// 自己的就丢掉。不去重的话本进程会收到自己刚发的那帧、再发一次 ——
// 页面不会错，但每次广播都白跑一轮 morph，连接多了很显眼。
公开 函数 频道接Redis(频道: 整数, 连接串: 字符串, 中继频道名: 字符串) : 整数 {
    变量 发布句柄: 整数 = Redis.连接(连接串);
    如果 (发布句柄 < 0) {
        返回 0;
    }
    变量 订阅句柄: 整数 = Redis.订阅(连接串, 中继频道名);
    如果 (订阅句柄 < 0) {
        Redis.关闭(发布句柄);
        返回 0;
    }

    J.设置整数(频道, "redis", 发布句柄);
    J.设置字符串(频道, "relay", 中继频道名);
    J.设置字符串(频道, "redisurl", 连接串);
    J.设置字符串(频道, "instance", 随机.UUID());

    启动 中继泵(频道, 订阅句柄);
    返回 1;
}

// 本进程发的广播复制一份到 Redis。没接 Redis 时是空操作。
函数 转发到Redis(频道: 整数, topic: 字符串, 种类: 字符串, 载荷: 字符串) : 整数 {
    如果 (J.是否包含键(频道, "redis") == 0) {
        返回 0;
    }
    变量 发布句柄: 整数 = J.获取整数(频道, "redis");
    如果 (发布句柄 <= 0) {
        返回 0;
    }
    变量 信封: 整数 = J.创建对象();
    J.设置字符串(信封, "from", J.获取字符串(频道, "instance"));
    J.设置字符串(信封, "topic", topic);
    J.设置字符串(信封, "kind", 种类);
    J.设置字符串(信封, "body", 载荷);
    变量 文本: 字符串 = J.转字符串(信封);
    J.删除(信封);
    返回 Redis.发布(发布句柄, J.获取字符串(频道, "relay"), 文本);
}

// 中继泵：收别的进程发来的广播，在本进程发一遍。
//
// 超时收（2 秒）而不是死等：死等的话这个 goroutine 永远醒不过来，
// 进程要退出时它还钉在 read 上。收到空串就是超时，转一圈接着收。
函数 中继泵(频道: 整数, 起始订阅: 整数) : 整数 {
    变量 自己: 字符串 = J.获取字符串(频道, "instance");
    变量 广播锁: 整数 = J.获取整数(频道, "锁");
    变量 连接表: 整数 = J.获取整数(频道, "表");
    变量 订阅句柄: 整数 = 起始订阅;
    当 (真) {
        // Redis 重启、网络抖一下，这条订阅就没了。**断掉之后 订阅接收 只会
        // 一直返回空串，跟「没人发消息」长得一模一样** —— 不主动问一句
        // 订阅活着，这个进程就悄悄变成聋子，页面表现是「有时候不刷新」。
        如果 (Redis.订阅活着(订阅句柄) == 0) {
            Redis.退订(订阅句柄);
            变量 新的: 整数 = Redis.订阅(J.获取字符串(频道, "redisurl"),
                                        J.获取字符串(频道, "relay"));
            如果 (新的 < 0) {
                // 还连不上就歇一会儿再试。这里**故意不做指数退避** ——
                // 中继断着的每一秒都是页面不同步，宁可多敲几次门。
                时间.睡眠毫秒(1000);
                继续;
            }
            订阅句柄 = 新的;
        }
        // 订阅接收 给的是**外层**帧 {"频道":…,"消息":…}，我们的信封在 消息 里 ——
        // 直接拿外层去读 from/topic 会一路读到空串，然后什么都不发、
        // 也什么都不报，看着就像中继没接上。
        变量 外层文本: 字符串 = Redis.订阅接收(订阅句柄, 2000);
        如果 (字符串::字节长度(外层文本) > 0) {
            变量 外层: 整数 = J.解码(外层文本);
            变量 帧: 字符串 = "";
            如果 (外层 > 0) {
                帧 = J.获取字符串(外层, "消息");
                J.删除(外层);
            }
            变量 信封: 整数 = J.解码(帧);
            如果 (信封 > 0) {
                变量 来自: 字符串 = J.获取字符串(信封, "from");
                // 自己发的已经在本地发过了，再发一遍纯属浪费
                如果 (字符串::等于(来自, 自己) == 0) {
                    变量 topic: 字符串 = J.获取字符串(信封, "topic");
                    变量 种类: 字符串 = J.获取字符串(信封, "kind");
                    变量 载荷: 字符串 = J.获取字符串(信封, "body");
                    如果 (字符串::等于(种类, "html") == 1) {
                        广播(广播锁, 连接表, topic, 载荷);
                    } 否则 {
                        广播帧(广播锁, 连接表, topic, 载荷);
                    }
                }
                J.删除(信封);
            }
        }
    }
    返回 0;
}

// topic 当前活跃连接数（简易 Presence：谁在线的计数）
公开 函数 频道在线数(频道: 整数, topic: 字符串) : 整数 {
    变量 广播锁: 整数 = J.获取整数(频道, "锁");
    变量 连接表: 整数 = J.获取整数(频道, "表");
    同步::加锁(广播锁);
    变量 数量: 整数 = 0;
    如果 (J.是否包含键(连接表, topic) == 1) {
        数量 = 列表库::整数列表大小(J.获取整数(连接表, topic));
    }
    同步::解锁(广播锁);
    返回 数量;
}

// ── 注册 WS 广播端点 ────────────────────────────────────────────
//
// 只注册 WebSocket 端点（不含页面）；页面由 App 自己用 共享实时脚本 内嵌运行时后
// 通过 获取 挂载（这样 App 能做鉴权门禁、套自己的暖色布局）。
//   ws路径          WebSocket 路径（ASCII，如 "/board/ws"）
//   准入函数        函数(订阅载荷JSON:字符串):字符串 —— 校验并返回 topic（空=拒绝）
//   渲染函数        函数(topic:字符串):字符串 —— topic → HTML 片段（通常读 DB）
//   事件处理函数    函数(topic:字符串, 事件名:字符串, 载荷JSON:字符串):整数
//                     返回 1 = 处理后广播重渲染给该 topic 全体；0 = 只回发当前连接

// 兼容入口：内部自建频道（拿不到频道句柄，服务端主动推需用 带频道 版本）
公开 函数 共享WS路由(应用值: 应用, ws路径: 字符串, 准入函数: 函数(字符串): 字符串, 渲染函数: 函数(字符串): 字符串, 事件处理函数: 函数(字符串, 字符串, 字符串): 整数) : 应用 {
    返回 共享WS路由带频道(应用值, ws路径, 创建广播频道(), 准入函数, 渲染函数, 事件处理函数);
}

// 频道由 App 创建并持有：事件驱动的广播照旧，另外随时可 频道广播/频道指令 主动推
公开 函数 共享WS路由带频道(应用值: 应用, ws路径: 字符串, 频道: 整数, 准入函数: 函数(字符串): 字符串, 渲染函数: 函数(字符串): 字符串, 事件处理函数: 函数(字符串, 字符串, 字符串): 整数) : 应用 {
    变量 广播锁: 整数 = J.获取整数(频道, "锁");
    变量 连接表: 整数 = J.获取整数(频道, "表");

    变量 ws处理器: 函数(整数): 整数 = 闭包(ws句柄: 整数): 整数 {
        返回 广播连接循环(ws句柄, 广播锁, 连接表, 准入函数, 渲染函数, 事件处理函数);
    };
    应用值 = WS路由(应用值, ws路径, ws处理器);
    返回 应用值;
}

// HTML块 版本：业务渲染函数保持结构化，框架统一在 WebSocket 边界序列化。
公开 函数 共享实时块路由(应用值: 应用, ws路径: 字符串, 准入函数: 函数(字符串): 字符串, 块渲染函数: 函数(字符串): HTML块, 事件处理函数: 函数(字符串, 字符串, 字符串): 整数) : 应用 {
    返回 共享实时块路由带频道(应用值, ws路径, 创建广播频道(), 准入函数, 块渲染函数, 事件处理函数);
}

公开 函数 共享实时块路由带频道(应用值: 应用, ws路径: 字符串, 频道: 整数, 准入函数: 函数(字符串): 字符串, 块渲染函数: 函数(字符串): HTML块, 事件处理函数: 函数(字符串, 字符串, 字符串): 整数) : 应用 {
    变量 渲染函数: 函数(字符串): 字符串 = 闭包(topic: 字符串): 字符串 {
        返回 渲染块(块渲染函数(topic));
    };
    返回 共享WS路由带频道(应用值, ws路径, 频道, 准入函数, 渲染函数, 事件处理函数);
}

// 结构化结果版本：支持 no-op、当前连接重渲染、topic 广播重渲染和操作者指令。
公开 函数 共享实时块结果路由(应用值: 应用, ws路径: 字符串, 准入函数: 函数(字符串): 字符串, 块渲染函数: 函数(字符串): HTML块, 事件处理函数: 函数(字符串, 字符串, 字符串): 实时事件结果) : 应用 {
    返回 共享实时块结果路由带频道(应用值, ws路径, 创建广播频道(), 准入函数, 块渲染函数, 事件处理函数);
}

公开 函数 共享实时块结果路由带频道(应用值: 应用, ws路径: 字符串, 频道: 整数, 准入函数: 函数(字符串): 字符串, 块渲染函数: 函数(字符串): HTML块, 事件处理函数: 函数(字符串, 字符串, 字符串): 实时事件结果) : 应用 {
    变量 广播锁: 整数 = J.获取整数(频道, "锁");
    变量 连接表: 整数 = J.获取整数(频道, "表");
    变量 渲染函数: 函数(字符串): 字符串 = 闭包(topic: 字符串): 字符串 {
        返回 渲染块(块渲染函数(topic));
    };
    变量 ws处理器: 函数(整数): 整数 = 闭包(ws句柄: 整数): 整数 {
        返回 广播结果连接循环(ws句柄, 广播锁, 连接表, 准入函数, 渲染函数, 事件处理函数);
    };
    返回 WS路由(应用值, ws路径, ws处理器);
}

// ── 每连接事件循环 ──────────────────────────────────────────────

函数 广播连接循环(ws句柄: 整数, 广播锁: 整数, 连接表: 整数, 准入函数: 函数(字符串): 字符串, 渲染函数: 函数(字符串): 字符串, 事件处理函数: 函数(字符串, 字符串, 字符串): 整数) : 整数 {
    // 1. 首帧握手：必须是 __订阅__，取出订阅载荷交给准入函数校验
    变量 首帧: 字符串 = WS::接收文本(ws句柄);
    如果 (字符串::字节长度(首帧) == 0) {
        返回 0;
    }
    变量 订阅载荷: 字符串 = 取载荷串(首帧, "__订阅__");
    如果 (字符串::字节长度(订阅载荷) == 0) {
        返回 0;
    }
    变量 topic: 字符串 = 准入函数(订阅载荷);
    如果 (字符串::字节长度(topic) == 0) {
        // 校验失败：先告诉客户端为什么再断，否则页面只会一直重连、停在占位符上
        发送拒绝(ws句柄, "登录已失效，请重新登录");
        返回 0;
    }

    // 2. 订阅该 topic，并推一帧初始渲染给自己
    广播订阅(广播锁, 连接表, topic, ws句柄);
    广播发送整区(ws句柄, 渲染函数(topic));

    // 3. 事件循环
    变量 继续循环: 整数 = 1;
    当 (继续循环 == 1 与 WS::已连接(ws句柄) == 1) {
        变量 消息: 字符串 = WS::接收文本(ws句柄);
        如果 (字符串::字节长度(消息) == 0) {
            继续循环 = 0;
        } 否则 {
            变量 消息对象: 整数 = J.解码(消息);
            如果 (消息对象 > 0) {
                变量 事件名: 字符串 = J.获取字符串(消息对象, "event");
                // 心跳帧：纯保活；不处理不渲染
                如果 (字符串::等于(事件名, "__心跳__") == 1) {
                    // no-op
                } 否则 {
                    如果 (字符串::字节长度(事件名) > 0) {
                        变量 载荷串: 字符串 = "{}";
                        如果 (J.是否包含键(消息对象, "payload") == 1) {
                            变量 载荷对象: 整数 = J.获取对象(消息对象, "payload");
                            如果 (载荷对象 > 0) {
                                载荷串 = J.转字符串(载荷对象);
                            }
                        }
                        变量 需广播: 整数 = 事件处理函数(topic, 事件名, 载荷串);
                        如果 (需广播 == 1) {
                            // 广播重渲染给该 topic 全体（含自己）
                            广播(广播锁, 连接表, topic, 渲染函数(topic));
                        } 否则 {
                            // 只回发自己
                            广播发送整区(ws句柄, 渲染函数(topic));
                        }
                    }
                }
                J.删除(消息对象);
            }
        }
    }

    // 4. 断开：退订
    广播退订(广播锁, 连接表, topic, ws句柄);
    返回 0;
}

函数 广播结果连接循环(ws句柄: 整数, 广播锁: 整数, 连接表: 整数, 准入函数: 函数(字符串): 字符串, 渲染函数: 函数(字符串): 字符串, 事件处理函数: 函数(字符串, 字符串, 字符串): 实时事件结果) : 整数 {
    变量 首帧: 字符串 = WS::接收文本(ws句柄);
    如果 (字符串::字节长度(首帧) == 0) { 返回 0; }
    变量 订阅载荷: 字符串 = 取载荷串(首帧, "__订阅__");
    如果 (字符串::字节长度(订阅载荷) == 0) { 返回 0; }
    变量 topic: 字符串 = 准入函数(订阅载荷);
    如果 (字符串::字节长度(topic) == 0) { 返回 0; }

    广播订阅(广播锁, 连接表, topic, ws句柄);
    广播发送整区(ws句柄, 渲染函数(topic));

    变量 继续循环: 整数 = 1;
    当 (继续循环 == 1 与 WS::已连接(ws句柄) == 1) {
        变量 消息: 字符串 = WS::接收文本(ws句柄);
        如果 (字符串::字节长度(消息) == 0) {
            继续循环 = 0;
        } 否则 {
            变量 消息对象: 整数 = J.解码(消息);
            如果 (消息对象 > 0) {
                变量 事件名: 字符串 = J.获取字符串(消息对象, "event");
                如果 (字符串::等于(事件名, "__心跳__") == 0 与 字符串::字节长度(事件名) > 0) {
                    变量 载荷串: 字符串 = "{}";
                    如果 (J.是否包含键(消息对象, "payload") == 1) {
                        变量 载荷对象: 整数 = J.获取对象(消息对象, "payload");
                        如果 (载荷对象 > 0) { 载荷串 = J.转字符串(载荷对象); }
                    }
                    变量 结果值: 实时事件结果 = 事件处理函数(topic, 事件名, 载荷串);
                    如果 (结果值.重渲染 == 1) {
                        如果 (结果值.广播 == 1) {
                            广播(广播锁, 连接表, topic, 渲染函数(topic));
                        } 否则 {
                            广播发送整区(ws句柄, 渲染函数(topic));
                        }
                    }
                    如果 (字符串::字节长度(结果值.指令) > 0) {
                        WS::发送文本(ws句柄, "{\"commands\":[" + 结果值.指令 + "]}");
                    } 否则如果 (结果值.重渲染 == 0) {
                        // ACK：即使业务 no-op 也清除客户端 qi-loading 状态。
                        WS::发送文本(ws句柄, "{\"commands\":[]}");
                    }
                }
                J.删除(消息对象);
            }
        }
    }
    广播退订(广播锁, 连接表, topic, ws句柄);
    返回 0;
}

// 从一帧 JSON 里取指定事件名的载荷子对象文本；事件名不匹配返回 ""
函数 取载荷串(帧文本: 字符串, 期望事件: 字符串) : 字符串 {
    变量 帧对象: 整数 = J.解码(帧文本);
    如果 (帧对象 <= 0) {
        返回 "";
    }
    变量 事件名: 字符串 = J.获取字符串(帧对象, "event");
    如果 (字符串::等于(事件名, 期望事件) == 0) {
        J.删除(帧对象);
        返回 "";
    }
    变量 载荷串: 字符串 = "{}";
    如果 (J.是否包含键(帧对象, "payload") == 1) {
        变量 载荷对象: 整数 = J.获取对象(帧对象, "payload");
        如果 (载荷对象 > 0) {
            载荷串 = J.转字符串(载荷对象);
        }
    }
    J.删除(帧对象);
    返回 载荷串;
}

// ── PubSub 注册表：订阅 / 退订 / 广播 ────────────────────────────
//
// 注册表结构：连接表 是一个 J 对象，键=topic，值=一个 标准库.列表 的「整数列表句柄」
// （存该 topic 下所有活跃 WS 句柄）。所有读写都在 广播锁 内串行，故底层 J / 列表
// 句柄无需各自线程安全。

公开 函数 广播订阅(广播锁: 整数, 连接表: 整数, topic: 字符串, ws句柄: 整数) : 整数 {
    同步::加锁(广播锁);
    变量 列表句柄: 整数 = 取或建列表(连接表, topic);
    如果 (列表库::包含整数(列表句柄, ws句柄) == 0) {
        列表库::添加整数(列表句柄, ws句柄);
    }
    同步::解锁(广播锁);
    返回 1;
}

公开 函数 广播退订(广播锁: 整数, 连接表: 整数, topic: 字符串, ws句柄: 整数) : 整数 {
    同步::加锁(广播锁);
    如果 (J.是否包含键(连接表, topic) == 1) {
        变量 列表句柄: 整数 = J.获取整数(连接表, topic);
        变量 索引: 整数 = 列表库::查找整数索引(列表句柄, ws句柄);
        如果 (索引 >= 0) {
            列表库::删除整数元素(列表句柄, 索引);
        }
    }
    同步::解锁(广播锁);
    返回 1;
}

// 向 topic 全体连接广播一帧重渲染片段。返回成功发送的连接数。
公开 函数 广播(广播锁: 整数, 连接表: 整数, topic: 字符串, 片段: 字符串) : 整数 {
    // 帧只序列化一次
    变量 帧对象: 整数 = J.创建对象();
    J.设置字符串(帧对象, "html", 片段);
    变量 帧文本: 字符串 = J.转字符串(帧对象);
    J.删除(帧对象);
    返回 广播帧(广播锁, 连接表, topic, 帧文本);
}

// 向 topic 全体连接原样广播一帧文本。
// 关键：先在锁内抓句柄快照，出锁后再发送——此时不持有 广播锁，
// 注册表锁与连接池锁永不嵌套，杜绝死锁。
函数 广播帧(广播锁: 整数, 连接表: 整数, topic: 字符串, 帧文本: 字符串) : 整数 {
    // 锁内抓快照
    同步::加锁(广播锁);
    变量 快照: 整数 = 列表库::创建整数列表();
    如果 (J.是否包含键(连接表, topic) == 1) {
        变量 列表句柄: 整数 = J.获取整数(连接表, topic);
        变量 总数: 整数 = 列表库::整数列表大小(列表句柄);
        变量 索引: 整数 = 0;
        当 (索引 < 总数) {
            列表库::添加整数(快照, 列表库::获取整数(列表句柄, 索引));
            索引 = 索引 + 1;
        }
    }
    同步::解锁(广播锁);

    // 出锁发送
    变量 成功数: 整数 = 0;
    变量 快照大小: 整数 = 列表库::整数列表大小(快照);
    变量 i: 整数 = 0;
    当 (i < 快照大小) {
        变量 目标句柄: 整数 = 列表库::获取整数(快照, i);
        如果 (WS::发送文本(目标句柄, 帧文本) == 1) {
            成功数 = 成功数 + 1;
        }
        i = i + 1;
    }
    列表库::删除列表(快照);
    返回 成功数;
}

// topic 不存在则新建一个整数列表并挂到连接表；返回列表句柄。调用方须已持锁。
函数 取或建列表(连接表: 整数, topic: 字符串) : 整数 {
    如果 (J.是否包含键(连接表, topic) == 1) {
        返回 J.获取整数(连接表, topic);
    }
    变量 列表句柄: 整数 = 列表库::创建整数列表();
    J.设置整数(连接表, topic, 列表句柄);
    返回 列表句柄;
}

// 下行一帧 {"html":"..."} 给单个连接
函数 广播发送整区(ws句柄: 整数, 片段: 字符串) : 整数 {
    变量 帧对象: 整数 = J.创建对象();
    J.设置字符串(帧对象, "html", 片段);
    变量 帧文本: 字符串 = J.转字符串(帧对象);
    J.删除(帧对象);
    返回 WS::发送文本(ws句柄, 帧文本);
}

// ── 客户端运行时脚本 ────────────────────────────────────────────
//
// 与 实时页面.qi 同一份运行时（实时运行时构建），广播模式差异只在：
// 连上先发 __订阅__ 帧、可选心跳、事件载荷自动并入订阅里的 昵称/成员id、
// 表单提交后 reset。页面里须有 <div id="qi-live">初始片段</div>。
//   ws路径        WebSocket 路径（如 "/board/ws"）
//   订阅载荷JSON  首帧 __订阅__ 的载荷（如 {"token":"..","家庭id":".."}）
//   心跳毫秒      保活间隔；广播已不依赖心跳（见文件头），30000 足矣，0 = 关闭
公开 函数 共享实时脚本(ws路径: 字符串, 订阅载荷JSON: 字符串, 心跳毫秒: 整数) : 字符串 {
    返回 实时运行时构建(ws路径, 订阅载荷JSON, 心跳毫秒);
}
