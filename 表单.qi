// Qi Web - 表单（对标 Phoenix 的 changeset / to_form / <.input>）
//
// ── 它解决什么 ────────────────────────────────────────────────────
//
// 每张表单都要重写同样三件事：
//   1. 校验不过时**把用户填的东西还回去** —— 不然一个字段写错，整张表白填
//   2. 错误文案得挂在**出错的那个字段旁边**，不是页面顶上笼统来一句
//   3. 「必填」「至少 6 位」「两次密码要一样」这些判断，一处一份地抄
//
// 这里把这三件事收成一个 表单 值：字段当前值 + 每字段错误 + 一个「动过没有」标记。
//
// ── 用法 ──────────────────────────────────────────────────────────
//
//   函数 校验(表: 表单) : 表单 {
//       表 = 校验必填(表, "name", "请填名字");
//       表 = 校验最短(表, "pass", 6, "密码至少 6 位");
//       表 = 校验相等(表, "pass", "pass2", "两次密码不一样");
//       返回 表;
//   }
//
//   函数 渲染(状态: 整数) : HTML块 {
//       变量 表: 表单 = 取表单(状态);
//       返回 HTML {
//           <form data-change="校验" data-submit="注册">
//               {文本字段(表, "name", "名字")}
//               {密码字段(表, "pass", "密码")}
//               {密码字段(表, "pass2", "再打一遍")}
//               <button type="submit">注册</button>
//           </form>
//       };
//   }
//
//   函数 处理事件(状态: 整数, 事件名: 字符串, 载荷JSON: 字符串) : 整数 {
//       如果 (字符串::等于(事件名, "校验") == 1) {
//           存表单(状态, 校验(动过(表单载入(取表单(状态), 载荷JSON))));
//       }
//       如果 (字符串::等于(事件名, "注册") == 1) {
//           变量 表: 表单 = 校验(动过(表单载入(取表单(状态), 载荷JSON)));
//           如果 (表单有错(表) == 0) { …真正去注册… }
//           存表单(状态, 表);
//       }
//       返回 状态;
//   }
//
// `data-change` 是表单级的：里面任何字段一变就把**整张表**送上来（校验常常要
// 看全表，比如两次密码是否一致）。默认防抖 200ms。
//
// ── 「动过」是干什么的 ────────────────────────────────────────────
//
// 一进页面就把「请填名字」红字糊到用户脸上，是很讨厌的。所以错误只有在
// `动过(表)` 之后才渲染出来 —— 也就是用户确实输入过或者点过提交之后。
// 校验本身照常跑（表单有错 一直是准的），只是不显示。
//
// ── 边界 ──────────────────────────────────────────────────────────
//
// 这里**不碰数据库**，也不猜类型。它只管「用户填了什么、哪里不对、怎么显示」。
// 值一律按字符串存（HTML 表单本来就只有字符串），要数字自己转。
包 Web;

导入 标准库.字符串;
导入 标准库.正则;
导入 标准库.JSON 作为 J;

公开 类型 表单 {
    值JSON: 字符串,      // 字段名 → 用户当前填的值
    错误JSON: 字符串,    // 字段名 → 错误文案（每字段只留第一条）
    动过标记: 整数,      // 0 = 还没输入/提交过，错误先不显示
}

公开 函数 新表单() : 表单 {
    返回 新建 表单 { 值JSON: "{}", 错误JSON: "{}", 动过标记: 0 };
}

// 从一份已有的值建表单 —— 编辑已有记录时用（值JSON 是 字段名→值 的对象文本）
公开 函数 从值建表单(值JSON: 字符串) : 表单 {
    变量 表: 表单 = 新表单();
    如果 (字符串::字节长度(值JSON) > 0) {
        变量 探: 整数 = J.解码(值JSON);
        如果 (探 > 0) {
            表.值JSON = J.转字符串(探);
            J.删除(探);
        }
    }
    返回 表;
}

// ── 取值与赋值 ──────────────────────────────────────────────────

公开 函数 表单值(表: 表单, 字段: 字符串) : 字符串 {
    返回 取字段(表.值JSON, 字段);
}

// 名字里多一个「值」是为了避开 请求.qi 已有的 表单整数(上下文, 名称, 默认值)
// —— 同包同名同元数，编译器会直接拒绝
公开 函数 表单值整数(表: 表单, 字段: 字符串, 默认值: 整数) : 整数 {
    变量 文本: 字符串 = 表单值(表, 字段);
    如果 (字符串::字节长度(文本) == 0) { 返回 默认值; }
    返回 字符串转整数(文本);
}

公开 函数 表单填(表: 表单, 字段: 字符串, 值: 字符串) : 表单 {
    表.值JSON = 设字段(表.值JSON, 字段, 值);
    返回 表;
}

// 从事件载荷一次性吃进所有字段（data-change / data-submit 上来的就是这个形状）。
//
// **会先把错误清空**：错误是从值推出来的，值变了就得整套重算。不清的话
// 表单置错 的「每字段只留第一条」会让上一轮的错误永远挂着 —— 用户把邮箱改对了，
// 「请填邮箱」还红在那儿。这个坑我自己写示例时当场踩了一次：单看代码完全合理，
// 只有在浏览器里连着改几个字段才看得出来。
//
// 副作用：手工 表单置错 的错误（比如「这个名字已经有人用了」）也会在下一次
// 输入时清掉 —— 这正是想要的，用户改了名字那条就不该还挂着。
公开 函数 表单载入(表: 表单, 载荷JSON: 字符串) : 表单 {
    表 = 表单清错(表);
    变量 载荷: 整数 = J.解码(载荷JSON);
    如果 (载荷 <= 0) { 返回 表; }
    变量 值: 整数 = J.解码(表.值JSON);
    如果 (值 <= 0) { 值 = J.创建对象(); }
    对于 键 在 J.键列表(载荷) {
        如果 (是保留键(键) == 0) {
            J.设置字符串(值, 键, J.获取字符串(载荷, 键));
        }
    }
    表.值JSON = J.转字符串(值);
    J.删除(值);
    J.删除(载荷);
    返回 表;
}

// 框架自己塞进载荷的键（组件路由目标之类）不该变成表单值。
// 只挡 __…__ 这种形状 —— 业务字段叫 token / nick 都是合法的，不能顺手滤掉。
函数 是保留键(键: 字符串) : 整数 {
    如果 (字符串::开始于(键, "__") == 1 与 字符串::结束于(键, "__") == 1) { 返回 1; }
    返回 0;
}

// 标记「用户动过了」—— 之后错误才会渲染出来
公开 函数 动过(表: 表单) : 表单 {
    表.动过标记 = 1;
    返回 表;
}

公开 函数 是否动过(表: 表单) : 整数 {
    返回 表.动过标记;
}

// ── 错误 ────────────────────────────────────────────────────────

公开 函数 表单错(表: 表单, 字段: 字符串) : 字符串 {
    返回 取字段(表.错误JSON, 字段);
}

// 每个字段只留**第一条**错误：一次把「必填」「至少 6 位」「格式不对」全糊上去
// 没有任何帮助，用户只会看第一条。
公开 函数 表单置错(表: 表单, 字段: 字符串, 文案: 字符串) : 表单 {
    如果 (字符串::字节长度(取字段(表.错误JSON, 字段)) > 0) { 返回 表; }
    表.错误JSON = 设字段(表.错误JSON, 字段, 文案);
    返回 表;
}

公开 函数 表单清错(表: 表单) : 表单 {
    表.错误JSON = "{}";
    返回 表;
}

公开 函数 表单有错(表: 表单) : 整数 {
    如果 (字符串::等于(表.错误JSON, "{}") == 1) { 返回 0; }
    返回 1;
}

// ── 校验（都是「已经有错就不再压一条」）────────────────────────

公开 函数 校验必填(表: 表单, 字段: 字符串, 提示: 字符串) : 表单 {
    如果 (字符串::字节长度(字符串::去空白(表单值(表, 字段))) == 0) {
        返回 表单置错(表, 字段, 提示);
    }
    返回 表;
}

公开 函数 校验最短(表: 表单, 字段: 字符串, 最少字符: 整数, 提示: 字符串) : 表单 {
    // 按**字符数**不是字节数 —— 中文按字节算「至少 6 位」会把 2 个汉字放过去
    如果 (字符串::字符数量(表单值(表, 字段)) < 最少字符) {
        返回 表单置错(表, 字段, 提示);
    }
    返回 表;
}

公开 函数 校验最长(表: 表单, 字段: 字符串, 最多字符: 整数, 提示: 字符串) : 表单 {
    如果 (字符串::字符数量(表单值(表, 字段)) > 最多字符) {
        返回 表单置错(表, 字段, 提示);
    }
    返回 表;
}

公开 函数 校验相等(表: 表单, 甲字段: 字符串, 乙字段: 字符串, 提示: 字符串) : 表单 {
    如果 (字符串::等于(表单值(表, 甲字段), 表单值(表, 乙字段)) == 0) {
        // 错误挂在**第二个**字段上 —— 用户是在那儿打错的
        返回 表单置错(表, 乙字段, 提示);
    }
    返回 表;
}

公开 函数 校验匹配(表: 表单, 字段: 字符串, 正则式: 字符串, 提示: 字符串) : 表单 {
    变量 值: 字符串 = 表单值(表, 字段);
    // 空值交给 校验必填 管，这里不重复报
    如果 (字符串::字节长度(值) > 0 与 正则.是否匹配(正则式, 值) == 0) {
        返回 表单置错(表, 字段, 提示);
    }
    返回 表;
}

公开 函数 校验整数范围(表: 表单, 字段: 字符串, 下限: 整数, 上限: 整数, 提示: 字符串) : 表单 {
    变量 值: 字符串 = 表单值(表, 字段);
    如果 (字符串::字节长度(值) == 0) { 返回 表; }
    变量 数: 整数 = 字符串转整数(值);
    如果 (数 < 下限 或 数 > 上限) {
        返回 表单置错(表, 字段, 提示);
    }
    返回 表;
}

// ── 渲染 ────────────────────────────────────────────────────────
//
// 标签 + 输入框 + 错误文案，一次给齐。样式走 qiui.css 的 .qi-field / .qi-err。

公开 函数 文本字段(表: 表单, 字段: 字符串, 标签: 字符串) : HTML块 {
    返回 一个字段(表, 字段, 标签, "text", "");
}

公开 函数 密码字段(表: 表单, 字段: 字符串, 标签: 字符串) : HTML块 {
    返回 一个字段(表, 字段, 标签, "password", "");
}

公开 函数 邮箱字段(表: 表单, 字段: 字符串, 标签: 字符串) : HTML块 {
    返回 一个字段(表, 字段, 标签, "email", "");
}

公开 函数 数字字段(表: 表单, 字段: 字符串, 标签: 字符串) : HTML块 {
    返回 一个字段(表, 字段, 标签, "number", "");
}

公开 函数 文本字段带提示(表: 表单, 字段: 字符串, 标签: 字符串, 占位: 字符串) : HTML块 {
    返回 一个字段(表, 字段, 标签, "text", 占位);
}

函数 一个字段(表: 表单, 字段: 字符串, 标签: 字符串, 输入类型: 字符串, 占位: 字符串) : HTML块 {
    变量 错文: 字符串 = 显示用错误(表, 字段);
    变量 输入类名: 字符串 = "qi-input";
    如果 (字符串::字节长度(错文) > 0) { 输入类名 = "qi-input bad"; }
    返回 HTML {
        <label class="qi-field">
            <span class="qi-field-label">{标签}</span>
            <input class={输入类名} type={输入类型} name={字段}
                   value={表单值(表, 字段)} placeholder={占位}>
            {错误块(表, 字段)}
        </label>
    };
}

公开 函数 多行字段(表: 表单, 字段: 字符串, 标签: 字符串) : HTML块 {
    变量 错文: 字符串 = 显示用错误(表, 字段);
    变量 类名: 字符串 = "qi-input";
    如果 (字符串::字节长度(错文) > 0) { 类名 = "qi-input bad"; }
    返回 HTML {
        <label class="qi-field">
            <span class="qi-field-label">{标签}</span>
            <textarea class={类名} name={字段}>{表单值(表, 字段)}</textarea>
            {错误块(表, 字段)}
        </label>
    };
}

// 单独渲染某个字段的错误（自己排版时用）
公开 函数 错误块(表: 表单, 字段: 字符串) : HTML块 {
    变量 错文: 字符串 = 显示用错误(表, 字段);
    如果 (字符串::字节长度(错文) == 0) {
        返回 创建片段();
    }
    返回 HTML { <span class="qi-err">{错文}</span> };
}

// 没「动过」之前不显示错误 —— 一进页面就红一片是很讨厌的
函数 显示用错误(表: 表单, 字段: 字符串) : 字符串 {
    如果 (表.动过标记 == 0) { 返回 ""; }
    返回 表单错(表, 字段);
}

// ── 状态里存取（约定挂在保留键 "__表单__"）────────────────────

公开 函数 存表单(状态: 整数, 表: 表单) : 整数 {
    变量 打包: 整数 = J.创建对象();
    J.设置字符串(打包, "v", 表.值JSON);
    J.设置字符串(打包, "e", 表.错误JSON);
    J.设置整数(打包, "t", 表.动过标记);
    变量 文本: 字符串 = J.转字符串(打包);
    J.删除(打包);
    J.设置字符串(状态, "__表单__", 文本);
    返回 1;
}

公开 函数 取表单(状态: 整数) : 表单 {
    如果 (J.是否包含键(状态, "__表单__") == 0) { 返回 新表单(); }
    变量 打包: 整数 = J.解码(J.获取字符串(状态, "__表单__"));
    如果 (打包 <= 0) { 返回 新表单(); }
    变量 表: 表单 = 新表单();
    表.值JSON = J.获取字符串(打包, "v");
    表.错误JSON = J.获取字符串(打包, "e");
    表.动过标记 = J.获取整数(打包, "t");
    J.删除(打包);
    返回 表;
}

// ── JSON 小工具 ────────────────────────────────────────────────

函数 取字段(对象文本: 字符串, 字段: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(对象文本);
    如果 (对象 <= 0) { 返回 ""; }
    变量 值: 字符串 = "";
    如果 (J.是否包含键(对象, 字段) == 1) { 值 = J.获取字符串(对象, 字段); }
    J.删除(对象);
    返回 值;
}

函数 设字段(对象文本: 字符串, 字段: 字符串, 值: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(对象文本);
    如果 (对象 <= 0) { 对象 = J.创建对象(); }
    J.设置字符串(对象, 字段, 值);
    变量 出: 字符串 = J.转字符串(对象);
    J.删除(对象);
    返回 出;
}
