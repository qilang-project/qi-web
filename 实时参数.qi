// Qi Web - 实时参数（对标 Phoenix live_patch / handle_params）
//
// ── 它解决什么 ────────────────────────────────────────────────────
//
// 标签页、筛选、翻页、点开详情 —— 这些都该改 URL（能收藏、能分享、后退键要管用），
// 但**不该重建连接**。以前只能 `指令_跳转`：整页刷新 + 新 WS + 状态全丢，
// 滚动位置也没了。切个标签页而已，代价太大。
//
// 这里让 URL 变化走一条轻路：客户端 pushState 改地址栏，然后把新 URL 发给服务端，
// 服务端在**同一个状态**上跑一遍 参数处理函数、重渲、回一帧。连接不断、状态不丢。
//
// ── 用法 ──────────────────────────────────────────────────────────
//
//   应用值 = 实时路由带参数(应用值, "/board", 初始状态, 渲染, 处理事件, 处理参数);
//
//   函数 处理参数(状态: 整数, 路径: 字符串, 查询JSON: 字符串) : 整数 {
//       J.设置字符串(状态, "标签页", 取查询(查询JSON, "tab"));
//       返回 状态;
//   }
//
//   函数 渲染(状态: 整数) : 字符串 {
//       返回 渲染块(HTML {
//           <nav>
//               <a data-patch="?tab=待办" href="?tab=待办">待办</a>
//               <a data-patch="?tab=已完成" href="?tab=已完成">已完成</a>
//           </nav>
//           …
//       });
//   }
//
// `data-patch` 写目标 URL（相对绝对都行）。同时写 `href` 是为了右键新开标签页、
// 以及禁用 JS 时还能用 —— 客户端会 preventDefault 走轻路。
//
// ── 什么时候会调 参数处理函数 ─────────────────────────────────────
//
//   · 首屏 GET（服务端直出，带着真实 URL，所以**不会先渲一遍默认值再跳**）
//   · WS 连上之后客户端立刻报一次当前 URL
//   · 点了 data-patch
//   · 浏览器前进 / 后退（popstate）
//   · 服务端主动推：实时指令(状态, 指令_跳转参数("?tab=已完成"))
//
// ── 边界 ──────────────────────────────────────────────────────────
//
// 这是 **live_patch**，不是 live_navigate：patch 目标必须还是**这个页面**
// （同一套 初始状态 / 渲染 / 事件处理）。要换成另一个页面，用 指令_跳转 整页走。
// 路径本身可以变（`/board/7`，路由写成 `/board/:id`），参数处理函数 拿得到新路径。
//
// 查询JSON 是客户端解析好的对象文本，形如 {"tab":"待办","page":"2"}。
// 值一律是**字符串**（URL 里本来就没有类型），要数字自己 字符串转整数。
包 Web;

导入 标准库.字符串;
导入 标准库.JSON 作为 J;
导入 标准库.列表 作为 列表库;

// 客户端上报 URL 用的保留事件名。业务事件不要用这个名字。
函数 参数事件名() : 字符串 {
    返回 "__参数__";
}

// 从 参数处理函数 收到的 查询JSON 里取一个值；没有返回空串。
//
// ⚠ 这个收的是**查询串 JSON**，不是上下文。在普通路由里（手上是 上下文）
// 该用 Web::查询参数(上下文值, 名称) —— 一步到位，别写
// `取查询(查询串转JSON(原始查询(c)), "k")` 这一长串。
//
// 写成 `取查询(上下文值, "k")` 现在会**编译失败**（结构体喂给标量形参是硬错），
// 修之前它编译得过、运行时恒返回空串 —— 页面表现是「保存后『已保存』永远
// 不出现，而 cookie 其实存对了」，没有任何报错。
公开 函数 取查询(查询JSON: 字符串, 名称: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(查询JSON);
    如果 (对象 <= 0) { 返回 ""; }
    变量 值: 字符串 = "";
    如果 (J.是否包含键(对象, 名称) == 1) {
        值 = J.获取字符串(对象, 名称);
    }
    J.删除(对象);
    返回 值;
}

// 取整数查询值；缺失或不是数字返回 默认值。
公开 函数 取查询整数(查询JSON: 字符串, 名称: 字符串, 默认值: 整数) : 整数 {
    变量 文本: 字符串 = 取查询(查询JSON, 名称);
    如果 (字符串::字节长度(文本) == 0) { 返回 默认值; }
    返回 字符串转整数(文本);
}

// 服务端主动改 URL（对标 push_patch）：客户端 pushState 之后照常上报参数。
// 跟 指令_跳转 的区别是**不重新加载页面**、连接和状态都留着。
公开 函数 指令_跳转参数(目标: 字符串) : 字符串 {
    返回 装跳转参数(目标, 0);
}

// 同上，但**不进浏览历史**（replaceState）。
//
// 一次性动作（点标签页、翻页）该进历史 —— 后退键回到上一个标签页是对的。
// 高频同步的不该：搜索框每敲几个字就同步一次 URL，一路 push 下去，
// 打完「去公园玩」得按四次后退才退得出这一页，用户会以为后退键坏了。
//
// 对标 Phoenix 的 `push_patch(socket, to: …, replace: true)`。
公开 函数 指令_替换参数(目标: 字符串) : 字符串 {
    返回 装跳转参数(目标, 1);
}

函数 装跳转参数(目标: 字符串, 替换: 整数) : 字符串 {
    变量 对象: 整数 = J.创建对象();
    J.设置字符串(对象, "type", "patch");
    J.设置字符串(对象, "target", 目标);
    J.设置整数(对象, "replace", 替换);
    变量 文本: 字符串 = J.转字符串(对象);
    J.删除(对象);
    返回 文本;
}

// ── 注册 ────────────────────────────────────────────────────────

公开 函数 实时路由带参数(应用值: 应用, 路由路径: 字符串,
                        初始状态函数: 函数(): 整数,
                        渲染函数: 函数(整数): 字符串,
                        事件处理函数: 函数(整数, 字符串, 字符串): 整数,
                        参数处理函数: 函数(整数, 字符串, 字符串): 整数) : 应用 {
    变量 ws路径: 字符串 = 实时WS路径(路由路径);

    // 首屏直出就带上真实 URL 的参数 —— 不然会先渲一遍默认标签页、
    // 等 WS 连上再跳一下，肉眼可见地闪
    变量 页面处理器: 函数(上下文): 响应 = 闭包(上下文值: 上下文): 响应 {
        变量 首屏状态: 整数 = 初始状态函数();
        首屏状态 = 参数处理函数(首屏状态, 路径(上下文值), 查询串转JSON(原始查询(上下文值)));
        变量 初始片段: 字符串 = 安全首屏(渲染函数, 首屏状态);
        J.删除(首屏状态);
        返回 HTML(实时页面布局("Qi 实时页面", ws路径, 初始片段, 1));
    };
    应用值 = 获取(应用值, 路由路径, 页面处理器);

    // 事件循环整个复用现成的：把 __参数__ 在事件处理这一层截下来分派掉，
    // 就不用再抄一份连接循环
    变量 包装事件: 函数(整数, 字符串, 字符串): 整数 =
        闭包(状态: 整数, 事件名: 字符串, 载荷JSON: 字符串): 整数 {
            如果 (字符串::等于(事件名, 参数事件名()) == 1) {
                返回 参数处理函数(状态, 载荷路径(载荷JSON), 载荷查询(载荷JSON));
            }
            返回 事件处理函数(状态, 事件名, 载荷JSON);
        };

    变量 ws处理器: 函数(整数): 整数 = 闭包(ws句柄: 整数): 整数 {
        返回 实时连接循环(ws句柄, 初始状态函数, 渲染函数, 包装事件);
    };
    返回 WS路由(应用值, ws路径, ws处理器);
}

// HTML块 渲染版（多一层结构化 diff）
公开 函数 实时块路由带参数(应用值: 应用, 路由路径: 字符串,
                          初始状态函数: 函数(): 整数,
                          块渲染函数: 函数(整数): HTML块,
                          事件处理函数: 函数(整数, 字符串, 字符串): 整数,
                          参数处理函数: 函数(整数, 字符串, 字符串): 整数) : 应用 {
    变量 渲染函数: 函数(整数): 字符串 = 闭包(状态: 整数): 字符串 {
        返回 安全首屏块(块渲染函数, 状态);
    };
    返回 实时路由带参数(应用值, 路由路径, 初始状态函数, 渲染函数, 事件处理函数, 参数处理函数);
}

// 轻路由 + 服务端主动推，两样都要。
//
// 单开一个函数而不是让调用方自己拼，是因为这个组合太常见了：换标签页要改 URL，
// 同时页面上又有「AI 正在生成」这种要后台跑的活。分开写的话
// 实时路由带参数 用的是被动循环，收不到邮箱消息 —— 一定会踩。
公开 函数 实时块路由带参数带消息(应用值: 应用, 路由路径: 字符串,
                              初始状态函数: 函数(): 整数,
                              块渲染函数: 函数(整数): HTML块,
                              事件处理函数: 函数(整数, 字符串, 字符串): 整数,
                              参数处理函数: 函数(整数, 字符串, 字符串): 整数,
                              消息处理函数: 函数(整数, 字符串, 字符串): 整数) : 应用 {
    变量 ws路径: 字符串 = 实时WS路径(路由路径);
    变量 渲染函数: 函数(整数): 字符串 = 闭包(状态: 整数): 字符串 {
        返回 安全首屏块(块渲染函数, 状态);
    };

    变量 页面处理器: 函数(上下文): 响应 = 闭包(上下文值: 上下文): 响应 {
        变量 首屏状态: 整数 = 初始状态函数();
        首屏状态 = 参数处理函数(首屏状态, 路径(上下文值), 查询串转JSON(原始查询(上下文值)));
        变量 初始片段: 字符串 = 安全首屏(渲染函数, 首屏状态);
        J.删除(首屏状态);
        返回 HTML(实时页面布局("Qi 实时页面", ws路径, 初始片段, 1));
    };
    应用值 = 获取(应用值, 路由路径, 页面处理器);

    变量 包装事件: 函数(整数, 字符串, 字符串): 整数 =
        闭包(状态: 整数, 事件名: 字符串, 载荷JSON: 字符串): 整数 {
            如果 (字符串::等于(事件名, 参数事件名()) == 1) {
                返回 参数处理函数(状态, 载荷路径(载荷JSON), 载荷查询(载荷JSON));
            }
            返回 事件处理函数(状态, 事件名, 载荷JSON);
        };

    变量 ws处理器: 函数(整数): 整数 = 闭包(ws句柄: 整数): 整数 {
        返回 消息连接循环(ws句柄, 初始状态函数, 渲染函数, 包装事件, 消息处理函数);
    };
    返回 WS路由(应用值, ws路径, ws处理器);
}

// 带参数 + 带消息 + **带准入**：轻路由、后台任务、以及「知道当前是谁」三样齐活。
//
// ── 为什么需要它 ──────────────────────────────────────────────────
//
// 实时块路由带参数带消息 的状态函数**没有 上下文 参数**，读不到 cookie，
// 于是 LiveView 里干不了任何按用户的事：内容署名、每人配额、私有数据。
// 带准入的路由（实时路由带准入 / 实时WS路由带准入）能认人，但不支持轻路由
// 和邮箱消息。两边各缺一半，这个函数把它们合起来。
//
// ── 认人是怎么串起来的 ────────────────────────────────────────────
//
//   1. 首屏 GET（有 上下文）→ 订阅载荷函数 读 cookie，产出一份凭据 JSON
//   2. 那份凭据被烤进页面的 window.QI_LIVE.sub
//   3. 客户端连上 WS，首帧原样把它发回来
//   4. 准入函数 验凭据 → 身份字符串（空串 = 拒绝，客户端会收到明确原因）
//   5. 初始状态函数(身份) 拿到身份建状态
//
// 首屏也走一遍 准入函数 —— 这样服务端直出的第一屏就是登录态，不会先闪一下
// 匿名视图再跳。代价是首屏多跑一次 准入函数（通常就是查一次会话表）。
//
// 未登录**不一定要拒**：准入函数 可以返回 "游客" 之类的身份串，让业务自己
// 决定给游客看什么、限多少。只有返回空串才断连接。
公开 函数 实时块路由带参数带消息带准入(应用值: 应用, 路由路径: 字符串,
                                订阅载荷函数: 函数(上下文): 字符串,
                                准入函数: 函数(字符串): 字符串,
                                初始状态函数: 函数(字符串): 整数,
                                块渲染函数: 函数(整数): HTML块,
                                事件处理函数: 函数(整数, 字符串, 字符串): 整数,
                                参数处理函数: 函数(整数, 字符串, 字符串): 整数,
                                消息处理函数: 函数(整数, 字符串, 字符串): 整数) : 应用 {
    // 不给 头部函数 = 沿用框架默认的 <head>（标题「Qi 实时页面」，没有 meta）。
    // 想要 SEO / 分享卡片就用下面那个带头的版本。
    变量 空头部: 函数(整数): 字符串 = 闭包(状态: 整数): 字符串 { 返回 ""; };
    返回 实时块路由带参数带消息带准入(应用值, 路由路径, 订阅载荷函数, 准入函数,
        初始状态函数, 块渲染函数, 事件处理函数, 参数处理函数, 消息处理函数, 空头部);
}

// 多一个 头部函数 的版本：**按首屏状态**产出这一页的 <head>。
//
// 为什么参数是状态而不是上下文：首屏 GET 里状态已经建好、参数也处理过了
// （场景、主题、课文都在里面），标题和 og:image 本来就该从它算。给上下文的话
// 业务得把 URL 再解析一遍，两处解析迟早不一致。
//
// 头部函数 返回的字符串会**整个替换** <head> 里框架原本输出的 <title>，
// 所以你必须自己给 <title>。详见 实时页面.qi 的 实时页面布局带头。
//
// 注意它只影响**首屏 HTML**。之后的更新走 WebSocket 增量帧，不重发 <head> ——
// 这正是想要的：抓取器和 IM 的爬虫只看首屏，永远不会连 WS。
公开 函数 实时块路由带参数带消息带准入(应用值: 应用, 路由路径: 字符串,
                                订阅载荷函数: 函数(上下文): 字符串,
                                准入函数: 函数(字符串): 字符串,
                                初始状态函数: 函数(字符串): 整数,
                                块渲染函数: 函数(整数): HTML块,
                                事件处理函数: 函数(整数, 字符串, 字符串): 整数,
                                参数处理函数: 函数(整数, 字符串, 字符串): 整数,
                                消息处理函数: 函数(整数, 字符串, 字符串): 整数,
                                头部函数: 函数(整数): 字符串) : 应用 {
    变量 ws路径: 字符串 = 实时WS路径(路由路径);
    变量 渲染函数: 函数(整数): 字符串 = 闭包(状态: 整数): 字符串 {
        返回 安全首屏块(块渲染函数, 状态);
    };

    变量 页面处理器: 函数(上下文): 响应 = 闭包(上下文值: 上下文): 响应 {
        变量 载荷: 字符串 = 订阅载荷函数(上下文值);
        变量 首屏状态: 整数 = 初始状态函数(准入函数(载荷));
        首屏状态 = 参数处理函数(首屏状态, 路径(上下文值), 查询串转JSON(原始查询(上下文值)));
        变量 初始片段: 字符串 = 安全首屏(渲染函数, 首屏状态);
        // 头部要在 删除 之前算 —— 它读的就是这份状态
        变量 头部: 字符串 = 头部函数(首屏状态);
        J.删除(首屏状态);
        返回 HTML(实时页面布局带头("Qi 实时页面", ws路径, 初始片段, 1, 载荷,
                              "zh-CN", 头部));
    };
    应用值 = 获取(应用值, 路由路径, 页面处理器);

    变量 包装事件: 函数(整数, 字符串, 字符串): 整数 =
        闭包(状态: 整数, 事件名: 字符串, 载荷JSON: 字符串): 整数 {
            如果 (字符串::等于(事件名, 参数事件名()) == 1) {
                返回 参数处理函数(状态, 载荷路径(载荷JSON), 载荷查询(载荷JSON));
            }
            返回 事件处理函数(状态, 事件名, 载荷JSON);
        };

    变量 ws处理器: 函数(整数): 整数 = 闭包(ws句柄: 整数): 整数 {
        返回 消息准入连接循环(ws句柄, 准入函数, 初始状态函数,
                          渲染函数, 包装事件, 消息处理函数);
    };
    返回 WS路由(应用值, ws路径, ws处理器);
}

// ── 让 初始状态 直接看见订阅载荷 ────────────────────────────────
//
// 框架只把 上下文 给 订阅载荷函数 —— 准入 / 初始状态 / 渲染 都读不到 cookie。
// 而「这个用户的语言、年龄段、主题偏好」几乎每个 LiveView 页都要。
//
// 于是业务只能**从 准入 的返回值偷渡**：准入 本来该返回一个身份串
//（"u:7" / "a:3f9c"），被迫改成返回一整个 JSON 把设置塞进去，
// 初始状态 再拆开。小小英语真这么干过 —— 代码里得写一句
// 「准入 的返回值语义是身份，这里当运输管道用」才说得清。
//
// 这个版本把**订阅载荷原样**也交给 初始状态：
//
//     函数 初始状态(身份: 字符串, 载荷JSON: 字符串) : 整数
//
// 准入 从此保持干净（只管认人），设置从载荷里读 —— 载荷本来就是
// 订阅载荷函数 从上下文装出来的，想放什么放什么。
公开 函数 实时块路由带请求(应用值: 应用, 路由路径: 字符串,
                        订阅载荷函数: 函数(上下文): 字符串,
                        准入函数: 函数(字符串): 字符串,
                        初始状态函数: 函数(字符串, 字符串): 整数,
                        块渲染函数: 函数(整数): HTML块,
                        事件处理函数: 函数(整数, 字符串, 字符串): 整数,
                        参数处理函数: 函数(整数, 字符串, 字符串): 整数,
                        消息处理函数: 函数(整数, 字符串, 字符串): 整数) : 应用 {
    变量 空头部: 函数(整数): 字符串 = 闭包(状态: 整数): 字符串 { 返回 ""; };
    返回 实时块路由带请求(应用值, 路由路径, 订阅载荷函数, 准入函数, 初始状态函数,
        块渲染函数, 事件处理函数, 参数处理函数, 消息处理函数, 空头部);
}

公开 函数 实时块路由带请求(应用值: 应用, 路由路径: 字符串,
                        订阅载荷函数: 函数(上下文): 字符串,
                        准入函数: 函数(字符串): 字符串,
                        初始状态函数: 函数(字符串, 字符串): 整数,
                        块渲染函数: 函数(整数): HTML块,
                        事件处理函数: 函数(整数, 字符串, 字符串): 整数,
                        参数处理函数: 函数(整数, 字符串, 字符串): 整数,
                        消息处理函数: 函数(整数, 字符串, 字符串): 整数,
                        头部函数: 函数(整数): 字符串) : 应用 {
    // WS 那条路只拿得到客户端回传的载荷（就是首屏烤进页面的那份），
    // 所以两条路看到的载荷是同一份 —— 首屏和重连后的状态一致。
    变量 转接初始: 函数(字符串): 整数 = 闭包(载荷JSON: 字符串): 整数 {
        返回 初始状态函数(准入函数(载荷JSON), 载荷JSON);
    };
    // 转接之后 准入 已经在 转接初始 里调过了，这儿再套一层恒等的
    // ——「非空即放行」的语义要保住：准入返回空串必须断连。
    变量 转接准入: 函数(字符串): 字符串 = 闭包(载荷JSON: 字符串): 字符串 {
        如果 (字符串::字节长度(准入函数(载荷JSON)) == 0) { 返回 ""; }
        返回 载荷JSON;
    };
    返回 实时块路由带参数带消息带准入(应用值, 路由路径, 订阅载荷函数,
        转接准入, 转接初始, 块渲染函数, 事件处理函数, 参数处理函数,
        消息处理函数, 头部函数);
}

// ── 载荷拆包 ────────────────────────────────────────────────────

函数 载荷路径(载荷JSON: 字符串) : 字符串 {
    变量 载荷: 整数 = J.解码(载荷JSON);
    如果 (载荷 <= 0) { 返回 "/"; }
    变量 出: 字符串 = "/";
    如果 (J.是否包含键(载荷, "path") == 1) { 出 = J.获取字符串(载荷, "path"); }
    J.删除(载荷);
    返回 出;
}

// 客户端送上来的 query 是个已经解析好的对象；原样取出它的 JSON 文本
函数 载荷查询(载荷JSON: 字符串) : 字符串 {
    变量 载荷: 整数 = J.解码(载荷JSON);
    如果 (载荷 <= 0) { 返回 "{}"; }
    变量 出: 字符串 = "{}";
    如果 (J.是否包含键(载荷, "query") == 1) {
        变量 查询对象: 整数 = J.获取对象(载荷, "query");
        如果 (查询对象 > 0) {
            出 = J.转字符串(查询对象);
            J.删除(查询对象);
        }
    }
    J.删除(载荷);
    返回 出;
}

// ── 首屏用：查询串 → JSON 对象文本 ──────────────────────────────
//
// WS 那条路的查询是客户端解析好的，这里只服务首屏直出。
// 键和值都要百分号解码（中文标签页名在 URL 里是 %E5%… 的）。
公开 函数 查询串转JSON(查询串: 字符串) : 字符串 {
    变量 对象: 整数 = J.创建对象();
    如果 (字符串::字节长度(查询串) > 0) {
        变量 段表: 数组<字符串> = 列表库::转字符串数组(字符串::分割(查询串, "&"));
        对于 一段 在 段表 {
            如果 (字符串::字节长度(一段) > 0) {
                变量 等号: 整数 = 字符串::查找(一段, "=");
                如果 (等号 > 0) {
                    变量 键: 字符串 = 百分号解码(字符串::子串(一段, 0, 等号));
                    变量 值: 字符串 = 百分号解码(
                        字符串::子串(一段, 等号 + 1, 字符串::字节长度(一段) - 等号 - 1));
                    J.设置字符串(对象, 键, 值);
                } 否则 {
                    // 光有键没有值（?flag）也当存在，值为空串
                    J.设置字符串(对象, 百分号解码(一段), "");
                }
            }
        }
    }
    变量 文本: 字符串 = J.转字符串(对象);
    J.删除(对象);
    返回 文本;
}
