// Qi Web - 上传（对标 Phoenix allow_upload / live_file_input）
//
// ── 它解决什么 ────────────────────────────────────────────────────
//
// 传统 multipart POST 能传文件，但传的时候页面什么都干不了：没有进度、不能取消、
// 传到一半失败只能整个重来，而且校验（大小/类型/张数）要等文件整个传完才知道。
// 相册就是这么写的 —— 选完图点提交，然后盯着转圈。
//
// 这里让文件跟着**已有的 WebSocket** 走：客户端切成块一块块送，服务端边收边落盘，
// 每收一块就更新一次进度。进度条就是普通的状态 → HTML，不需要任何页面脚本。
//
// ── 用法 ──────────────────────────────────────────────────────────
//
//   函数 初始状态() : 整数 {
//       变量 状态: 整数 = J.创建对象();
//       允许上传(状态, 上传设置("照片", "image/*", 8000000, 3, "上传目录"));
//       返回 状态;
//   }
//
//   函数 渲染(状态: 整数) : HTML块 {
//       返回 HTML {
//           <div>
//               {上传输入(状态, "照片", "选照片")}
//               {上传进度(状态, "照片")}
//               <button data-click="保存" 如果={上传空闲(状态, "照片")}>保存</button>
//           </div>
//       };
//   }
//
//   函数 处理事件(状态: 整数, 事件名: 字符串, 载荷JSON: 字符串) : 整数 {
//       // 上传相关的帧先让框架挑走
//       如果 (上传处理(状态, 事件名, 载荷JSON) == 1) { 返回 状态; }
//       如果 (字符串::等于(事件名, "保存") == 1) {
//           对于 一条 在 上传完成表(状态, "照片") {   // 每条是 {id,名字,大小,路径}
//               …把 路径 记进数据库…
//           }
//           清空上传(状态, "照片");
//       }
//       返回 状态;
//   }
//
// ── 校验 ──────────────────────────────────────────────────────────
//
// 客户端先按 `最大字节 / 最多个数 / 接受` 挡一道（选了个 200MB 的文件立刻就说
// 太大，不用等它传），服务端**再独立校验一遍** —— 客户端那道只是体验，
// 不能当安全边界。
//
// 文件名会被清洗：只留字母数字、点、横杠、下划线和中文，路径分隔符和 `..`
// 一律去掉。落盘用的是「时间戳_序号_清洗后的名字」，不会被上传方决定写到哪。
//
// ── 传输 ──────────────────────────────────────────────────────────
//
// 走 WS 文本帧，每块 base64（比原始字节多 1/3）。选它是因为**复用已经鉴权过的
// 连接**：不用再开一个 HTTP 端点、不用把 WS 会话和 HTTP 请求对起来。
// 代价是不适合超大文件 —— 几十 MB 以上建议单开一个直传端点。
// 默认上限 8MB，用 上传设置 自己调。
//
// ── 状态里的保留键 ────────────────────────────────────────────────
//   "__上传__"  上传组与条目，由框架维护。渲染函数不要用这个键。
包 Web;

导入 标准库.字符串;
导入 标准库.JSON 作为 J;
导入 标准库.字节切片 作为 字节库;
导入 标准库.输入输出 作为 IO;
导入 标准库.时间 作为 时间;
导入 标准库.列表 作为 列表库;

公开 类型 上传配置 {
    名称: 字符串,
    接受: 字符串,        // 直接给 <input accept>，如 "image/*" 或 ".jpg,.png"
    最大字节: 整数,
    最多个数: 整数,
    目录: 字符串,        // 落盘目录（会自动创建）
}

公开 函数 上传设置(名称: 字符串, 接受: 字符串, 最大字节: 整数,
                  最多个数: 整数, 目录: 字符串) : 上传配置 {
    如果 (字符串::字节长度(名称) == 0) { 抛出 "上传组必须有名字"; }
    返回 新建 上传配置 {
        名称: 名称, 接受: 接受, 最大字节: 最大字节,
        最多个数: 最多个数, 目录: 目录
    };
}

// 在 初始状态函数 里调一次，声明这个页面允许哪几组上传。
公开 函数 允许上传(状态: 整数, 配置: 上传配置) : 整数 {
    IO.创建目录(配置.目录);
    变量 全部: 整数 = 取上传根(状态);
    变量 一组: 整数 = J.创建对象();
    J.设置字符串(一组, "accept", 配置.接受);
    J.设置整数(一组, "max", 配置.最大字节);
    J.设置整数(一组, "count", 配置.最多个数);
    J.设置字符串(一组, "dir", 配置.目录);
    J.设置数组(一组, "entries", J.创建数组());
    J.设置对象(全部, 配置.名称, 一组);
    J.删除(一组);
    存上传根(状态, 全部);
    返回 1;
}

// ── 事件入口 ────────────────────────────────────────────────────

// 上传相关的帧在这里全部处理掉；返回 1 表示「这一帧是上传的，业务不用管」。
// 在 事件处理函数 的开头调。
公开 函数 上传处理(状态: 整数, 事件名: 字符串, 载荷JSON: 字符串) : 整数 {
    如果 (字符串::等于(事件名, "__上传开始__") == 1) {
        开始上传(状态, 载荷JSON);
        返回 1;
    }
    如果 (字符串::等于(事件名, "__上传块__") == 1) {
        收一块(状态, 载荷JSON);
        返回 1;
    }
    如果 (字符串::等于(事件名, "__上传取消__") == 1) {
        取消一条(状态, 载荷JSON);
        返回 1;
    }
    返回 0;
}

// 客户端报来这一批要传的文件；这里独立校验并登记条目。
函数 开始上传(状态: 整数, 载荷JSON: 字符串) : 整数 {
    变量 载荷: 整数 = J.解码(载荷JSON);
    如果 (载荷 <= 0) { 返回 0; }
    变量 组名: 字符串 = J.获取字符串(载荷, "up");
    变量 全部: 整数 = 取上传根(状态);
    如果 (J.是否包含键(全部, 组名) == 0) {
        J.删除(载荷); J.删除(全部);
        返回 0;
    }
    变量 一组: 整数 = J.获取对象(全部, 组名);
    变量 条目表: 整数 = J.获取数组(一组, "entries");
    变量 最大: 整数 = J.获取整数(一组, "max");
    变量 上限个数: 整数 = J.获取整数(一组, "count");
    变量 目录: 字符串 = J.获取字符串(一组, "dir");
    变量 接受: 字符串 = J.获取字符串(一组, "accept");

    变量 新来: 整数 = J.获取数组(载荷, "entries");
    变量 总数: 整数 = J.数组长度(新来);
    变量 i: 整数 = 0;
    当 (i < 总数) {
        变量 来: 整数 = J.数组获取对象(新来, i);
        如果 (来 > 0) {
            变量 条目: 整数 = J.创建对象();
            变量 编号: 字符串 = J.获取字符串(来, "cid");
            变量 原名: 字符串 = J.获取字符串(来, "name");
            变量 大小: 整数 = J.获取整数(来, "size");
            J.设置字符串(条目, "id", 编号);
            J.设置字符串(条目, "name", 原名);
            J.设置整数(条目, "size", 大小);
            J.设置整数(条目, "got", 0);
            J.设置整数(条目, "done", 0);
            // 服务端独立校验：客户端那道只是体验，不是安全边界
            变量 错: 字符串 = "";
            如果 (J.数组长度(条目表) >= 上限个数) {
                错 = "最多只能传 " + 整数转字符串(上限个数) + " 个";
            } 否则如果 (大小 > 最大) {
                错 = "文件太大（上限 " + 兆字节文案(最大) + "）";
            } 否则如果 (字符串::字节长度(字符串::去空白(原名)) == 0) {
                错 = "文件名为空";
            } 否则如果 (类型合规(接受, 原名, J.获取字符串(来, "type")) == 0) {
                错 = "类型不符（只收 " + 接受 + "）";
            }
            J.设置字符串(条目, "err", 错);
            如果 (字符串::字节长度(错) == 0) {
                // 临时文件：收完再挪到正式位置，中途断了不会留下半个正式文件
                J.设置字符串(条目, "tmp", 目录 + "/." + 编号 + ".part");
                J.设置字符串(条目, "path", "");
                J.数组添加对象(条目表, 条目);
            }
            如果 (字符串::字节长度(错) > 0) {
                J.数组添加对象(条目表, 条目);
            }
            J.删除(条目);
            J.删除(来);
        }
        i = i + 1;
    }
    J.设置数组(一组, "entries", 条目表);
    J.设置对象(全部, 组名, 一组);
    存上传根(状态, 全部);
    J.删除(条目表); J.删除(一组); J.删除(新来); J.删除(全部); J.删除(载荷);
    返回 1;
}

// 收一块：base64 解码后追加到临时文件，更新进度；最后一块就收尾。
函数 收一块(状态: 整数, 载荷JSON: 字符串) : 整数 {
    变量 载荷: 整数 = J.解码(载荷JSON);
    如果 (载荷 <= 0) { 返回 0; }
    变量 组名: 字符串 = J.获取字符串(载荷, "up");
    变量 编号: 字符串 = J.获取字符串(载荷, "id");
    变量 数据: 字符串 = J.获取字符串(载荷, "b");
    变量 是最后: 整数 = J.获取整数(载荷, "last");
    J.删除(载荷);

    变量 全部: 整数 = 取上传根(状态);
    如果 (J.是否包含键(全部, 组名) == 0) { J.删除(全部); 返回 0; }
    变量 一组: 整数 = J.获取对象(全部, 组名);
    变量 条目表: 整数 = J.获取数组(一组, "entries");
    变量 目录: 字符串 = J.获取字符串(一组, "dir");
    变量 最大: 整数 = J.获取整数(一组, "max");

    变量 位置: 整数 = 找条目(条目表, 编号);
    如果 (位置 < 0) {
        // 没登记 / 已被取消 / 校验就没过 —— 块直接丢掉
        J.删除(条目表); J.删除(一组); J.删除(全部);
        返回 0;
    }
    变量 条目: 整数 = J.数组获取对象(条目表, 位置);
    如果 (字符串::字节长度(J.获取字符串(条目, "err")) > 0
          或 J.获取整数(条目, "done") == 1) {
        J.删除(条目); J.删除(条目表); J.删除(一组); J.删除(全部);
        返回 0;
    }

    变量 临时: 字符串 = J.获取字符串(条目, "tmp");
    变量 已收: 整数 = J.获取整数(条目, "got");
    如果 (字符串::字节长度(数据) > 0) {
        变量 切片: 整数 = 字节库::从Base64(数据);
        如果 (切片 > 0) {
            变量 这块: 整数 = 字节库::长度(切片);
            // 再拦一道：客户端可以谎报 size，真正的账按**实际收到的字节**算
            如果 (已收 + 这块 > 最大) {
                J.设置字符串(条目, "err", "文件太大（上限 " + 兆字节文案(最大) + "）");
                IO.删除文件(临时);
                字节库::释放切片(切片);
                写回条目(全部, 组名, 一组, 条目表, 位置, 条目, 状态);
                返回 0;
            }
            字节库::追加到文件(切片, 临时);
            字节库::释放切片(切片);
            已收 = 已收 + 这块;
            J.设置整数(条目, "got", 已收);
        }
    }

    如果 (是最后 == 1) {
        变量 正式: 字符串 = 目录 + "/" + 生成文件名(编号, J.获取字符串(条目, "name"));
        如果 (IO.重命名(临时, 正式) == 1) {
            J.设置字符串(条目, "path", 正式);
            J.设置整数(条目, "done", 1);
            J.设置整数(条目, "size", 已收);
        } 否则 {
            J.设置字符串(条目, "err", "落盘失败");
            IO.删除文件(临时);
        }
    }
    写回条目(全部, 组名, 一组, 条目表, 位置, 条目, 状态);
    返回 1;
}

函数 取消一条(状态: 整数, 载荷JSON: 字符串) : 整数 {
    变量 载荷: 整数 = J.解码(载荷JSON);
    如果 (载荷 <= 0) { 返回 0; }
    变量 组名: 字符串 = J.获取字符串(载荷, "up");
    变量 编号: 字符串 = J.获取字符串(载荷, "id");
    J.删除(载荷);

    变量 全部: 整数 = 取上传根(状态);
    如果 (J.是否包含键(全部, 组名) == 0) { J.删除(全部); 返回 0; }
    变量 一组: 整数 = J.获取对象(全部, 组名);
    变量 条目表: 整数 = J.获取数组(一组, "entries");
    变量 剩下: 整数 = J.创建数组();
    变量 总数: 整数 = J.数组长度(条目表);
    变量 i: 整数 = 0;
    当 (i < 总数) {
        变量 条目: 整数 = J.数组获取对象(条目表, i);
        如果 (条目 > 0) {
            如果 (字符串::等于(J.获取字符串(条目, "id"), 编号) == 1) {
                // 半截的临时文件和已经落盘的正式文件都要清掉，不留垃圾
                清掉文件(J.获取字符串(条目, "tmp"));
                清掉文件(J.获取字符串(条目, "path"));
            } 否则 {
                J.数组添加对象(剩下, 条目);
            }
            J.删除(条目);
        }
        i = i + 1;
    }
    J.设置数组(一组, "entries", 剩下);
    J.设置对象(全部, 组名, 一组);
    存上传根(状态, 全部);
    J.删除(剩下); J.删除(条目表); J.删除(一组); J.删除(全部);
    返回 1;
}

// ── 查询 ────────────────────────────────────────────────────────

// 这一组的全部条目（JSON 数组文本）。每条：
//   {"id","name","size","got","done","err","path"}
公开 函数 上传条目表(状态: 整数, 组名: 字符串) : 字符串 {
    变量 全部: 整数 = 取上传根(状态);
    如果 (J.是否包含键(全部, 组名) == 0) { J.删除(全部); 返回 "[]"; }
    变量 一组: 整数 = J.获取对象(全部, 组名);
    变量 条目表: 整数 = J.获取数组(一组, "entries");
    变量 出: 字符串 = J.转字符串(条目表);
    J.删除(条目表); J.删除(一组); J.删除(全部);
    返回 出;
}

// 只要已经收完、没出错的那些（消费用）
公开 函数 上传完成表(状态: 整数, 组名: 字符串) : 字符串 {
    变量 全表: 整数 = J.解码(上传条目表(状态, 组名));
    如果 (全表 <= 0) { 返回 "[]"; }
    变量 好的: 整数 = J.创建数组();
    变量 总数: 整数 = J.数组长度(全表);
    变量 i: 整数 = 0;
    当 (i < 总数) {
        变量 条目: 整数 = J.数组获取对象(全表, i);
        如果 (条目 > 0) {
            如果 (J.获取整数(条目, "done") == 1) { J.数组添加对象(好的, 条目); }
            J.删除(条目);
        }
        i = i + 1;
    }
    变量 出: 字符串 = J.转字符串(好的);
    J.删除(好的); J.删除(全表);
    返回 出;
}

公开 函数 上传条目数(状态: 整数, 组名: 字符串) : 整数 {
    变量 表: 整数 = J.解码(上传条目表(状态, 组名));
    如果 (表 <= 0) { 返回 0; }
    变量 数: 整数 = J.数组长度(表);
    J.删除(表);
    返回 数;
}

// 没有正在传的条目（全传完了或者一个都没选）—— 提交按钮拿它判能不能点
公开 函数 上传空闲(状态: 整数, 组名: 字符串) : 布尔 {
    变量 表: 整数 = J.解码(上传条目表(状态, 组名));
    如果 (表 <= 0) { 返回 真; }
    变量 忙: 整数 = 0;
    变量 总数: 整数 = J.数组长度(表);
    变量 i: 整数 = 0;
    当 (i < 总数) {
        变量 条目: 整数 = J.数组获取对象(表, i);
        如果 (条目 > 0) {
            如果 (J.获取整数(条目, "done") == 0
                  与 字符串::字节长度(J.获取字符串(条目, "err")) == 0) {
                忙 = 1;
            }
            J.删除(条目);
        }
        i = i + 1;
    }
    J.删除(表);
    如果 (忙 == 1) { 返回 假; }
    返回 真;
}

// 消费完之后清掉条目（**不删文件** —— 文件已经归业务了）
公开 函数 清空上传(状态: 整数, 组名: 字符串) : 整数 {
    变量 全部: 整数 = 取上传根(状态);
    如果 (J.是否包含键(全部, 组名) == 0) { J.删除(全部); 返回 0; }
    变量 一组: 整数 = J.获取对象(全部, 组名);
    J.设置数组(一组, "entries", J.创建数组());
    J.设置对象(全部, 组名, 一组);
    存上传根(状态, 全部);
    J.删除(一组); J.删除(全部);
    返回 1;
}

// 连接结束时清掉所有没传完的临时文件。由连接循环在释放状态之前调用。
//
// 不做的话就是**磁盘上的垃圾会一直攒**：用户传到一半关了标签页、网断了、
// 服务重启了 —— 每一次都留一个 .part 在上传目录里，没有任何东西会去收。
// 传完的正式文件不动（那些已经归业务了）。
公开 函数 上传连接结束(状态: 整数) : 整数 {
    如果 (J.是否包含键(状态, "__上传__") == 0) { 返回 0; }
    变量 全部: 整数 = 取上传根(状态);
    变量 清了: 整数 = 0;
    对于 组名 在 J.键列表(全部) {
        变量 一组: 整数 = J.获取对象(全部, 组名);
        如果 (一组 > 0) {
            变量 条目表: 整数 = J.获取数组(一组, "entries");
            如果 (条目表 > 0) {
                变量 总数: 整数 = J.数组长度(条目表);
                变量 i: 整数 = 0;
                当 (i < 总数) {
                    变量 条目: 整数 = J.数组获取对象(条目表, i);
                    如果 (条目 > 0) {
                        // 只清没收完的临时文件；done 的那些已经 rename 走了
                        如果 (J.获取整数(条目, "done") == 0) {
                            变量 临时: 字符串 = J.获取字符串(条目, "tmp");
                            如果 (字符串::字节长度(临时) > 0 与 IO.文件存在(临时) == 1) {
                                IO.删除文件(临时);
                                清了 = 清了 + 1;
                            }
                        }
                        J.删除(条目);
                    }
                    i = i + 1;
                }
                J.删除(条目表);
            }
            J.删除(一组);
        }
    }
    J.删除(全部);
    返回 清了;
}

// ── 渲染 ────────────────────────────────────────────────────────

// 文件选择框。限制写进 data-* 让客户端也能先挡一道（体验），服务端照样独立校验。
公开 函数 上传输入(状态: 整数, 组名: 字符串, 按钮文案: 字符串) : HTML块 {
    变量 全部: 整数 = 取上传根(状态);
    变量 接受: 字符串 = "";
    变量 最大: 整数 = 0;
    变量 个数: 整数 = 1;
    如果 (J.是否包含键(全部, 组名) == 1) {
        变量 一组: 整数 = J.获取对象(全部, 组名);
        接受 = J.获取字符串(一组, "accept");
        最大 = J.获取整数(一组, "max");
        个数 = J.获取整数(一组, "count");
        J.删除(一组);
    }
    J.删除(全部);
    返回 HTML {
        <label class="qi-upload">
            <span class="qi-upload-btn">{按钮文案}</span>
            <input type="file" data-upload={组名} accept={接受}
                   data-upload-max={整数转字符串(最大)}
                   data-upload-count={整数转字符串(个数)}>
        </label>
    };
}

// 进度列表：每条一行，带进度条 / 错误 / 取消按钮
公开 函数 上传进度(状态: 整数, 组名: 字符串) : HTML块 {
    变量 出: HTML块 = 创建块("ul");
    出 = 块属性(出, "class", "qi-upload-list");
    变量 表: 整数 = J.解码(上传条目表(状态, 组名));
    如果 (表 <= 0) { 返回 出; }
    变量 总数: 整数 = J.数组长度(表);
    变量 i: 整数 = 0;
    当 (i < 总数) {
        变量 条目: 整数 = J.数组获取对象(表, i);
        如果 (条目 > 0) {
            出 = 块加子块(出, 一条进度(组名, 条目));
            J.删除(条目);
        }
        i = i + 1;
    }
    J.删除(表);
    返回 出;
}

函数 一条进度(组名: 字符串, 条目: 整数) : HTML块 {
    变量 编号: 字符串 = J.获取字符串(条目, "id");
    变量 错: 字符串 = J.获取字符串(条目, "err");
    变量 大小: 整数 = J.获取整数(条目, "size");
    变量 已收: 整数 = J.获取整数(条目, "got");
    变量 百分比: 整数 = 0;
    如果 (大小 > 0) { 百分比 = 已收 * 100 / 大小; }
    如果 (百分比 < 0) { 百分比 = 0; }
    如果 (百分比 > 100) { 百分比 = 100; }
    如果 (J.获取整数(条目, "done") == 1) { 百分比 = 100; }

    变量 行: HTML块 = 块键(块属性(创建块("li"), "class", "qi-upload-item"), 编号);
    行 = 块加子块(行, HTML {
        <span class="qi-upload-name">{J.获取字符串(条目, "name")}</span>
    });
    如果 (字符串::字节长度(错) > 0) {
        行 = 块加子块(行, HTML { <span class="qi-err">{错}</span> });
    } 否则 {
        行 = 块加子块(行, 进度条(百分比));
    }
    行 = 块加子块(行, HTML {
        <button class="icon" data-click="__上传取消__"
                data-value-up={组名} data-value-id={编号}>×</button>
    });
    返回 行;
}

// 进度条的宽度只能走内联 style，而 块属性 明令拒绝 style（动态 style 要 CSS
// 上下文转义，一般情况下确实该拒）。这里的值是**我们自己夹在 0..100 的整数**，
// 不可能带出引号或分号，所以用 块加原文 走一条受控的口子 —— 并且只在这里。
函数 进度条(百分比: 整数) : HTML块 {
    变量 安全值: 整数 = 百分比;
    如果 (安全值 < 0) { 安全值 = 0; }
    如果 (安全值 > 100) { 安全值 = 100; }
    变量 宽: 字符串 = 整数转字符串(安全值);
    返回 块加原文(创建片段(),
        "<span class=\"qi-track\"><span class=\"qi-fill\" style=\"width:"
        + 宽 + "%\"></span></span>");
}

// ── 内部 ────────────────────────────────────────────────────────

// 上限的人话说法。这里的 MB 按 10^6 算（开发者写 4000000 就该显示 4MB）——
// 按 1024×1024 除的话 4000000 会显示成「3MB」，比不显示还糟。
函数 兆字节文案(字节数: 整数) : 字符串 {
    如果 (字节数 < 1000000) {
        返回 整数转字符串((字节数 + 1023) / 1024) + "KB";
    }
    返回 整数转字符串((字节数 + 999999) / 1000000) + "MB";
}

// 服务端这一侧的 accept 校验。规则同 <input accept>：
//   ".jpg" 比扩展名、"image/*" 比 MIME 前缀、"image/png" 比完整 MIME；
//   逗号分隔，空的表示不限。
//
// ⚠ 文件名和 MIME **都是客户端报的**，能被伪造。这道只是把「选错文件」挡在
// 传输之前，不是内容安全边界 —— 真要认内容得读文件头，那是业务自己的事。
函数 类型合规(接受: 字符串, 文件名: 字符串, MIME: 字符串) : 整数 {
    变量 规则串: 字符串 = 字符串::去空白(接受);
    如果 (字符串::字节长度(规则串) == 0) { 返回 1; }
    变量 低名: 字符串 = 字符串::转小写(文件名);
    变量 低型: 字符串 = 字符串::转小写(MIME);
    对于 一条 在 列表库::转字符串数组(字符串::分割(规则串, ",")) {
        变量 规则: 字符串 = 字符串::转小写(字符串::去空白(一条));
        如果 (字符串::字节长度(规则) > 0) {
            如果 (字符串::开始于(规则, ".") == 1) {
                如果 (字符串::结束于(低名, 规则) == 1) { 返回 1; }
            } 否则如果 (字符串::结束于(规则, "/*") == 1) {
                变量 前缀: 字符串 = 字符串::子串(规则, 0, 字符串::字节长度(规则) - 1);
                如果 (字符串::开始于(低型, 前缀) == 1) { 返回 1; }
            } 否则 {
                如果 (字符串::等于(低型, 规则) == 1) { 返回 1; }
            }
        }
    }
    返回 0;
}

函数 取上传根(状态: 整数) : 整数 {
    如果 (J.是否包含键(状态, "__上传__") == 1) {
        变量 已有: 整数 = J.解码(J.获取字符串(状态, "__上传__"));
        如果 (已有 > 0) { 返回 已有; }
    }
    返回 J.创建对象();
}

函数 存上传根(状态: 整数, 全部: 整数) : 整数 {
    J.设置字符串(状态, "__上传__", J.转字符串(全部));
    返回 1;
}

函数 写回条目(全部: 整数, 组名: 字符串, 一组: 整数, 条目表: 整数,
              位置: 整数, 条目: 整数, 状态: 整数) : 整数 {
    // J 没有「数组按下标覆盖对象」，所以重建一遍数组（条目通常个位数）
    变量 新表: 整数 = J.创建数组();
    变量 总数: 整数 = J.数组长度(条目表);
    变量 i: 整数 = 0;
    当 (i < 总数) {
        如果 (i == 位置) {
            J.数组添加对象(新表, 条目);
        } 否则 {
            变量 别的: 整数 = J.数组获取对象(条目表, i);
            如果 (别的 > 0) { J.数组添加对象(新表, 别的); J.删除(别的); }
        }
        i = i + 1;
    }
    J.设置数组(一组, "entries", 新表);
    J.设置对象(全部, 组名, 一组);
    存上传根(状态, 全部);
    J.删除(新表); J.删除(条目); J.删除(条目表); J.删除(一组); J.删除(全部);
    返回 1;
}

函数 找条目(条目表: 整数, 编号: 字符串) : 整数 {
    变量 总数: 整数 = J.数组长度(条目表);
    变量 i: 整数 = 0;
    当 (i < 总数) {
        变量 条目: 整数 = J.数组获取对象(条目表, i);
        如果 (条目 > 0) {
            变量 命中: 整数 = 字符串::等于(J.获取字符串(条目, "id"), 编号);
            J.删除(条目);
            如果 (命中 == 1) { 返回 i; }
        }
        i = i + 1;
    }
    返回 0 - 1;
}

函数 清掉文件(路径: 字符串) : 整数 {
    如果 (字符串::字节长度(路径) > 0) { IO.删除文件(路径); }
    返回 1;
}

// 落盘文件名：时间戳_编号_清洗后的原名。
//
// **上传方不能决定写到哪** —— 原名里的 `/`、`\`、`..` 全部去掉，只留
// 字母数字点横杠下划线和中文。不清洗的话一个叫 `../../etc/x` 的文件名
// 就能写出目录。
函数 生成文件名(编号: 字符串, 原名: 字符串) : 字符串 {
    变量 干净: 字符串 = 清洗文件名(原名);
    如果 (字符串::字节长度(干净) == 0) { 干净 = "file"; }
    返回 整数转字符串(时间.现在()) + "_" + 清洗文件名(编号) + "_" + 干净;
}

函数 清洗文件名(原名: 字符串) : 字符串 {
    变量 出: 字符串 = 原名;
    出 = 字符串::替换(出, "/", "");
    出 = 字符串::替换(出, "\\", "");
    出 = 字符串::替换(出, "..", "");
    出 = 字符串::替换(出, ":", "");
    出 = 字符串::替换(出, "\"", "");
    出 = 字符串::替换(出, "'", "");
    出 = 字符串::替换(出, " ", "_");
    出 = 字符串::替换(出, "\n", "");
    出 = 字符串::替换(出, "\r", "");
    出 = 字符串::替换(出, "\t", "");
    出 = 字符串::替换(出, "␀", "");
    // 太长的名字对文件系统不友好，截到 80 个字符
    如果 (字符串::字符数量(出) > 80) {
        出 = 字符串::字符子串(出, 0, 80);
    }
    返回 出;
}
