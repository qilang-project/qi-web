// 应用样式表：设计令牌 + 基础元素 + 组件类。换主题只要覆盖 :root 里的 --qi-*
公开 函数 样式源() : 字符串 {
    返回 `:root{--qi-accent: #6366f1;--qi-accent-hover: #4f46e5;--qi-accent-soft: #eef2ff;--qi-accent-ink: #4338ca;--qi-bg: #f4f6fb;--qi-surface: #ffffff;--qi-ink: #1f2937;--qi-ink-soft: #4b5563;--qi-ink-faint: #9ca3af;--qi-muted: #6b7280;--qi-line: #e5e7eb;--qi-line-strong: #d1d5db;--qi-hover: #f3f4f6;--qi-danger: #dc2626;--qi-danger-soft: #fef2f2;--qi-danger-line: #fecaca;--qi-ok: #059669;--qi-ok-soft: #ecfdf5;--qi-radius: 14px;--qi-radius-sm: 9px;--qi-shadow: 0 1px 3px rgba(0, 0, 0, .08);--qi-shadow-lift: 0 2px 8px rgba(0, 0, 0, .1);--qi-width: 720px;--qi-pad: 20px;--qi-gap: 14px;--qi-font: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", system-ui, "Segoe UI", sans-serif;--qi-font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace}*{box-sizing:border-box}body{margin:0;padding:var(--qi-pad);background:var(--qi-bg);color:var(--qi-ink);font-family:var(--qi-font);font-size:15px;line-height:1.6;-webkit-text-size-adjust:100%}h1,h2,h3{margin:0 0 6px;line-height:1.35}h1{font-size:24px}h2{font-size:20px}h3{font-size:15px;color:var(--qi-ink-soft)}p{margin:6px 0}a{color:var(--qi-muted);text-decoration:none}a:hover{color:var(--qi-accent)}form{margin:0 0 10px}form:last-child{margin-bottom:0}input,textarea,select{width:100%;padding:10px 12px;border:1.5px solid var(--qi-line-strong);border-radius:var(--qi-radius-sm);background:var(--qi-surface);color:var(--qi-ink);font-family:inherit;font-size:15px}input:focus,textarea:focus,select:focus{outline:none;border-color:var(--qi-accent)}textarea{resize:vertical;line-height:1.6}input::placeholder,textarea::placeholder{color:var(--qi-ink-faint)}button{padding:10px 16px;border:none;border-radius:var(--qi-radius-sm);background:var(--qi-accent);color:#fff;font-family:inherit;font-size:15px;font-weight:600;cursor:pointer;transition:background .15s}button:hover{background:var(--qi-accent-hover)}button:disabled{opacity:.5;cursor:default}button.ghost{background:var(--qi-line);color:var(--qi-ink-soft)}button.ghost:hover{background:var(--qi-line-strong)}button.quiet{background:var(--qi-surface);border:1.5px solid var(--qi-line);color:var(--qi-ink)}button.quiet:hover{background:var(--qi-accent-soft);border-color:var(--qi-accent);color:var(--qi-accent-ink)}button.danger{background:var(--qi-danger)}button.danger:hover{filter:brightness(.92)}button.block{width:100%}button.icon{background:none;color:var(--qi-line-strong);padding:2px 7px;font-size:18px;line-height:1}button.icon:hover{background:none;color:var(--qi-danger)}.qi-bar{max-width:var(--qi-width);margin:0 auto var(--qi-gap);padding:12px 20px;background:var(--qi-surface);border-radius:var(--qi-radius);box-shadow:var(--qi-shadow);display:flex;justify-content:space-between;align-items:center;gap:12px}.qi-bar a+a{margin-left:12px}.qi-panel{padding:16px 20px;background:var(--qi-surface);border-radius:var(--qi-radius);box-shadow:var(--qi-shadow)}.qi-card{max-width:var(--qi-width);margin:0 auto var(--qi-gap);padding:16px 20px;background:var(--qi-surface);border-radius:var(--qi-radius);box-shadow:var(--qi-shadow)}.qi-card.pad-sm{padding:12px 16px}.qi-card.accent{border:2px solid var(--qi-accent)}.qi-row{display:flex;gap:8px;align-items:center}.qi-row.top{align-items:flex-start}.qi-row>input,.qi-row>textarea,.qi-row>.grow{flex:1;min-width:0}.qi-stack{display:flex;flex-direction:column;gap:8px}.qi-grid{max-width:var(--qi-width);margin:0 auto;display:grid;gap:var(--qi-gap);align-items:start;grid-template-columns:repeat(var(--qi-cols, 2),minmax(0,1fr))}.qi-grid.cols-3{--qi-cols: 3}.qi-grid.cols-4{--qi-cols: 4}@media(max-width:760px){.qi-grid{--qi-cols: 1 !important}}.qi-between{display:flex;justify-content:space-between;align-items:center;gap:10px}.qi-muted{color:var(--qi-muted);font-size:14px}.qi-faint{color:var(--qi-ink-faint);font-size:12px}.qi-badge{display:inline-block;padding:3px 10px;border-radius:999px;background:var(--qi-accent-soft);color:var(--qi-accent-ink);font-size:13px;font-weight:600;white-space:nowrap}.qi-badge.plain{background:var(--qi-hover);color:var(--qi-muted);font-weight:400}.qi-badge.solid{background:var(--qi-accent);color:#fff}.qi-badge.ok{background:var(--qi-ok-soft);color:var(--qi-ok)}.qi-num{font-variant-numeric:tabular-nums;font-weight:700}.qi-track{height:8px;margin:7px 0 5px;background:var(--qi-accent-soft);border-radius:5px;overflow:hidden}.qi-fill{height:100%;width:0;background:var(--qi-accent);border-radius:5px;transition:width .45s cubic-bezier(.4,0,.2,1)}.qi-empty{padding:26px 12px;text-align:center;color:var(--qi-ink-faint);font-size:14px}.qi-item{padding:10px 12px;background:var(--qi-bg);border:1.5px solid var(--qi-line);border-radius:var(--qi-radius-sm)}.qi-item:hover{box-shadow:var(--qi-shadow-lift)}.qi-drag{cursor:grab;transition:box-shadow .15s,transform .15s}.qi-drag.dragging{opacity:.45;transform:rotate(1.5deg);cursor:grabbing}.qi-drop{display:flex;flex-direction:column;gap:8px;min-height:90px;padding:4px;border-radius:var(--qi-radius-sm);transition:background .15s}.qi-drop.over{background:var(--qi-accent-soft);outline:2px dashed var(--qi-accent)}.qi-sep{margin:14px 0 12px;border:none;border-top:1px dashed var(--qi-line-strong)}.qi-pre{white-space:pre-wrap;word-break:break-word}.qi-pre.box{max-height:220px;padding:10px 12px;overflow:auto;background:var(--qi-hover);border-radius:var(--qi-radius-sm);color:var(--qi-ink-soft);font-family:var(--qi-font-mono);font-size:12px}.qdd{position:relative;width:100%;margin:6px 0}.qdd-head{display:flex;align-items:center;justify-content:space-between;gap:6px;width:100%;height:44px;padding:0 12px;background:var(--qi-surface);color:var(--qi-ink);border:1.5px solid var(--qi-line-strong);border-radius:var(--qi-radius-sm);font-size:15px;font-weight:600;cursor:pointer;user-select:none}.qdd-txt{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.qdd-ar{flex:none;color:var(--qi-ink-faint);font-size:12px;transition:transform .15s}.qdd.open .qdd-ar{transform:rotate(180deg);color:var(--qi-accent)}.qdd-menu{display:none;position:absolute;top:calc(100% + 4px);left:0;right:0;z-index:60;max-height:260px;overflow-y:auto;background:var(--qi-surface);border:1.5px solid var(--qi-line-strong);border-radius:var(--qi-radius-sm);box-shadow:var(--qi-shadow-lift)}.qdd.open .qdd-menu{display:block}.qdd-opt{padding:11px 12px;border-bottom:1px solid var(--qi-line);font-size:15px;white-space:nowrap;cursor:pointer}.qdd-opt:last-child{border-bottom:none}.qdd-opt:hover,.qdd-opt.sel{background:var(--qi-accent-soft)}.qdd-opt.sel{font-weight:700}.md{display:block;line-height:1.7}.md>*:first-child{margin-top:0}.md>*:last-child{margin-bottom:0}.md h1,.md h2,.md h3{font-size:16px;margin:8px 0 4px}.md p{margin:6px 0}.md ul,.md ol{margin:6px 0;padding-left:22px}.md li{margin:2px 0}.md code{padding:1px 5px;background:var(--qi-hover);border-radius:5px;font-family:var(--qi-font-mono);font-size:13px}.md table{margin:8px 0;border-collapse:collapse;font-size:14px}.md th,.md td{padding:5px 9px;border:1.5px solid var(--qi-line);text-align:left}.md th{background:var(--qi-hover)}.md a{color:var(--qi-accent);font-weight:700}.qi-tool{display:inline-flex;align-items:center;gap:6px;margin:5px 0;padding:4px 11px;background:var(--qi-accent-soft);border:1.5px solid var(--qi-accent);border-radius:10px;color:var(--qi-accent-ink);font-size:13px;font-weight:700}@media(max-width:640px){:root{--qi-pad: 12px;--qi-gap: 10px}input,textarea,select,.qdd-head,.qdd-opt{font-size:16px}h1{font-size:21px}.qi-card,.qi-bar{padding-left:14px;padding-right:14px}}`;
}
