// qi-web · HTTP 请求指标。建在 指标.qi 的通用注册表之上 ——
// 它不是特例，只是第一个用户。
//
// ── 基数是这类东西唯一会出的大事 ────────────────────────────────
//
// 标签取的是**路由模板**（`/learn/{id}`），不是真实路径。按真实路径的话
// 一万个主题就是一万条时间序列，把 Prometheus 撑爆 —— 这事有个专门的名字
// 叫 cardinality explosion。模板从 路由.路由模式(处理器索引) 来，
// 那张登记簿是注册路由时顺手记下的。
//
// 状态码用真实码（semconv 要求），但每条路由的码就那么几个，乘出来仍然很小。
包 Web;

导入 标准库.字符串;
导入 标准库.时间;

公开 函数 时延指标名() : 字符串 { 返回 "http_server_request_duration_seconds"; }
公开 函数 请求数指标名() : 字符串 { 返回 "http_server_requests_total"; }
公开 函数 在飞指标名() : 字符串 { 返回 "http_server_active_requests"; }

// 模板存的是「GET /learn/{id}」，拆成两个属性 —— semconv 里
// http.request.method 和 http.route 是分开的。
函数 模板的方法(模板: 字符串) : 字符串 {
    变量 位: 整数 = 字符串::查找(模板, " ");
    如果 (位 < 0) { 返回 "_OTHER"; }
    返回 字符串::子串(模板, 0, 位);
}

函数 模板的路由(模板: 字符串) : 字符串 {
    变量 位: 整数 = 字符串::查找(模板, " ");
    如果 (位 < 0) { 返回 模板; }
    返回 字符串::子串(模板, 位 + 1, 字符串::字节长度(模板) - 位 - 1);
}

公开 函数 记一次请求(路由模板: 字符串, 状态码: 整数, 耗时毫秒: 整数) : 整数 {
    变量 模板: 字符串 = 路由模板;
    // 没匹配上任何路由的请求也要记 —— 一堆 __unmatched__ 就是有人在扫目录，
    // 或者前端在请求一个不存在的接口。这两件事都值得看见。
    如果 (字符串::字节长度(模板) == 0) { 模板 = "__unmatched__"; }

    变量 标签串: 字符串 = 标签三(
        "http_request_method", 模板的方法(模板),
        "http_route", 模板的路由(模板),
        "http_response_status_code", 整数转字符串(状态码));

    记录耗时(时延指标名(), 标签串, 耗时毫秒);
    计数一(请求数指标名(), 标签串);
    返回 1;
}

公开 函数 指标中间件(下一步: 函数(上下文): 响应, 上下文值: 上下文) : 响应 {
    量表加(在飞指标名(), "", 1);
    变量 起: 整数 = 时间.现在毫秒();
    变量 响应值: 响应 = 下一步(上下文值);
    变量 耗: 整数 = 时间.现在毫秒() - 起;
    量表加(在飞指标名(), "", 0 - 1);

    变量 码: 整数 = 响应值.状态码;
    // 状态码 0 = handler 自己流式写完了（SSE / 分块），当 200 记 ——
    // 跟访问日志那边一个口径，不然两处数字对不上。
    如果 (码 == 0) { 码 = 200; }
    记一次请求(路由模式(上下文值.处理器索引), 码, 耗);
    返回 响应值;
}

公开 函数 使用指标(应用值: 应用) : 应用 {
    初始化指标();
    指标说明(时延指标名(), "HTTP 服务端处理时延");
    指标说明(请求数指标名(), "HTTP 请求总数");
    指标说明(在飞指标名(), "正在处理中的 HTTP 请求数");
    // 先把三条名字登记出来，这样一次请求都还没来的时候 /metrics 上也有
    // TYPE 行 —— 抓取方（尤其是告警规则）见到「指标不存在」和「值为 0」
    // 的反应完全不同：前者是 no data，规则会静默不触发。
    注册指标(时延指标名(), 类_直方图());
    注册指标(请求数指标名(), 类_计数器());
    量表设(在飞指标名(), "", 0);
    返回 使用中间件(应用值, 指标中间件);
}
