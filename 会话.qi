包 Web.会话;

导入 标准库.字符串;
导入 标准库.哈希表 作为 表库;
导入 标准库.Redis 作为 Redis;
导入 标准库.随机;
导入 标准库.加密 作为 加密;
导入 Web::{百分号编码, 百分号解码};
导入 Web.请求::{上下文, 请求头};
导入 Web.响应::{响应, 设置响应头};

// ===== Cookie 解析 =====

公开 函数 Cookie(上下文值: 上下文, 名称: 字符串) : 字符串 {
    变量 曲奇文本: 字符串 = 请求头(上下文值, "Cookie");
    如果 (字符串::字节长度(曲奇文本) == 0) {
        返回 "";
    }

    变量 查找键: 字符串 = 名称 + "=";
    变量 开始位置: 整数 = 0;
    变量 总长度: 整数 = 字符串::字节长度(曲奇文本);

    当 (开始位置 < 总长度) {
        变量 分隔位置: 整数 = 字符串::查找从位置(曲奇文本, ";", 开始位置);
        如果 (分隔位置 < 0) {
            分隔位置 = 总长度;
        }

        变量 当前项: 字符串 = 字符串::子串(曲奇文本, 开始位置, 分隔位置 - 开始位置);
        如果 (字符串::开始于(当前项, " ") == 1) {
            当前项 = 字符串::子串从位置(当前项, 1);
        }

        如果 (字符串::开始于(当前项, 查找键) == 1) {
            // **百分号解码**：cookie 值的惯例是写时编码、读时解码。
            // 客户端写的（指令_设置Cookie 用 encodeURIComponent）必然是编码过的 ——
            // 不解的话 "暗" 读回来是 "%E6%9A%97"，跟服务端写进去的同名 cookie
            // 长得不一样，业务里比字符串就永远不相等。
            // 纯 ASCII 值（adult / zh / A1）解码是恒等变换，老数据零影响。
            返回 百分号解码(字符串::子串从位置(当前项, 字符串::字节长度(查找键)));
        }

        开始位置 = 分隔位置 + 1;
    }

    返回 "";
}

// ===== Cookie 写入 =====

// 写时百分号编码，跟 Cookie() 读时解码对称。
// 不编码的话，值里有 `;` 或 `,` 会把 Set-Cookie 头切断（后半截当成属性），
// 而中文值虽然多数服务器容忍，规范上并不合法。
公开 函数 设置Cookie(响应值: 响应, 名称: 字符串, 值: 字符串) : 响应 {
    返回 设置响应头(响应值, "Set-Cookie",
        名称 + "=" + 百分号编码(值) + "; Path=/; HttpOnly");
}

// 完整选项：path / max_age 秒 / secure / http_only / same_site
公开 函数 设置Cookie完整(响应值: 响应, 名称: 字符串, 值: 字符串,
                          路径: 字符串, 最大寿命秒: 整数,
                          安全: 整数, 仅HTTP: 整数, 同站策略: 字符串) : 响应 {
    变量 头值: 字符串 = 名称 + "=" + 百分号编码(值);
    如果 (字符串::字节长度(路径) > 0) {
        头值 = 头值 + "; Path=" + 路径;
    } 否则 {
        头值 = 头值 + "; Path=/";
    }
    如果 (最大寿命秒 > 0) {
        头值 = 头值 + "; Max-Age=" + 整数转字符串(最大寿命秒);
    }
    如果 (仅HTTP == 1) {
        头值 = 头值 + "; HttpOnly";
    }
    如果 (安全 == 1) {
        头值 = 头值 + "; Secure";
    }
    如果 (字符串::字节长度(同站策略) > 0) {
        头值 = 头值 + "; SameSite=" + 同站策略;
    }
    返回 设置响应头(响应值, "Set-Cookie", 头值);
}

公开 函数 删除Cookie(响应值: 响应, 名称: 字符串) : 响应 {
    返回 设置响应头(响应值, "Set-Cookie", 名称 + "=; Path=/; Max-Age=0; HttpOnly");
}

// ===== Express signed cookies 等价：HMAC-SHA256 签名 =====
//
// 写：cookie 值变成 "原值.签名(base64)" — Set-Cookie 头里
// 读：从 cookie 读 "值.签名"，校验签名是否匹配，匹配返回原值，否则 ""
// 用 加密.HMAC_SHA256(密钥, 值) → bytes → base64 编码

// 签名后的 cookie 值（不含 Set-Cookie 选项，仅值部分）
公开 函数 签名值(密钥: 字符串, 值: 字符串) : 字符串 {
    变量 mac: 字符串 = 加密.HMAC_SHA256(密钥, 值);
    // mac 已是 hex 字符串（qi 的 HMAC_SHA256 返回 hex），直接拼
    返回 值 + "." + mac;
}

// 设置带签名的 cookie。其余选项跟 设置Cookie完整 一致。
公开 函数 设置签名Cookie(响应值: 响应, 名称: 字符串, 值: 字符串, 密钥: 字符串) : 响应 {
    返回 设置Cookie(响应值, 名称, 签名值(密钥, 值));
}

公开 函数 设置签名Cookie完整(响应值: 响应, 名称: 字符串, 值: 字符串, 密钥: 字符串,
                              路径: 字符串, 最大寿命秒: 整数,
                              安全: 整数, 仅HTTP: 整数, 同站策略: 字符串) : 响应 {
    返回 设置Cookie完整(响应值, 名称, 签名值(密钥, 值), 路径, 最大寿命秒, 安全, 仅HTTP, 同站策略);
}

// 读签名 cookie：拿到原值并校验签名。失败（无 cookie / 签名不匹配 / 格式错）返回 ""
// 校验失败 ≠ cookie 不存在 — 都返回 ""，安全模式（避免攻击者伪造）
公开 函数 读签名Cookie(上下文值: 上下文, 名称: 字符串, 密钥: 字符串) : 字符串 {
    变量 原始: 字符串 = Cookie(上下文值, 名称);
    如果 (字符串::字节长度(原始) == 0) {
        返回 "";
    }
    // 找最后一个 . — 因为值本身可能含点
    变量 索引: 整数 = 字符串::字节长度(原始) - 1;
    变量 点位置: 整数 = -1;
    当 (索引 >= 0) {
        如果 (字符串::等于(字符串::子串(原始, 索引, 1), ".") == 1) {
            点位置 = 索引;
            索引 = -1; // break
        } 否则 {
            索引 = 索引 - 1;
        }
    }
    如果 (点位置 < 0) {
        返回 "";
    }
    变量 值: 字符串 = 字符串::子串(原始, 0, 点位置);
    变量 sig: 字符串 = 字符串::子串从位置(原始, 点位置 + 1);
    变量 期望: 字符串 = 加密.HMAC_SHA256(密钥, 值);
    如果 (字符串::等于(sig, 期望) == 1) {
        返回 值;
    }
    返回 "";
}

// ===== 服务器端 Session 存储 =====
//
// sid (字符串) → 序列化数据 (字符串，"k1=v1&k2=v2" 形式)。两种后端：
//
//   内存（默认）  进程内 hashmap。**只够单进程**：起第二个实例，用户在 A
//                 登录、下一个请求打到 B 就掉登录。开发和单机部署够用。
//   Redis        调一次 会话用Redis() 就切过去，多进程/多机共享同一份会话。
//
// 切换是运行时的一句配置，不是编译期开关 —— 同一份代码本地跑内存、
// 线上跑 Redis，中间不需要改代码或改构建。

变量 会话存储: 整数 = 0;

// Redis 后端：句柄 <= 0 表示没配，走内存
变量 会话库: 整数 = 0;
// 键前缀用 ASCII —— 这些键要在 redis-cli 里被人肉眼看、被运维扫，
// 而且可能被非 qi 的工具读到。中文只留在 qi 源码里。
变量 会话键前缀: 字符串 = "qi:sess:";
// 会话多久没人碰就自然消失。**每次写都会续期**，所以这是「闲置多久」，
// 不是「登录后多久」。内存后端没有这个概念（进程活着就一直在）。
变量 会话存活秒: 整数 = 86400;

函数 确保会话存储() : 整数 {
    如果 (会话存储 <= 0) {
        会话存储 = 表库::创建字符串表();
    }
    返回 会话存储;
}

// 把会话存到 Redis 上。启动时调一次，成功返回 1、连不上返回 0。
//
//   会话用Redis("redis://127.0.0.1:46379/0", "", 0)      默认前缀和存活期
//   会话用Redis(串, "myapp:sess:", 7 * 24 * 3600)         自己定
//
// 连不上时**不静默退回内存**：返回 0 让调用方自己决定是硬失败还是降级。
// 静默降级最坏 —— 线上以为在用 Redis，实际每个实例各存各的，
// 表现是「有时候要重新登录」，查起来能查一整天。
公开 函数 会话用Redis(连接串: 字符串, 键前缀: 字符串, 存活秒: 整数) : 整数 {
    变量 句柄: 整数 = Redis.连接(连接串);
    如果 (句柄 < 0) {
        返回 0;
    }
    会话库 = 句柄;
    如果 (字符串::字节长度(键前缀) > 0) {
        会话键前缀 = 键前缀;
    }
    如果 (存活秒 > 0) {
        会话存活秒 = 存活秒;
    }
    返回 1;
}

// 现在走的是哪个后端 —— 健康检查页面用得上
公开 函数 会话后端() : 字符串 {
    如果 (会话库 > 0) {
        返回 "redis";
    }
    返回 "memory";
}

函数 会话键(会话ID: 字符串) : 字符串 {
    返回 会话键前缀 + 会话ID;
}

公开 函数 会话标识(上下文值: 上下文) : 字符串 {
    返回 Cookie(上下文值, "qi_session");
}

公开 函数 设置会话(响应值: 响应, 会话ID: 字符串) : 响应 {
    返回 设置Cookie(响应值, "qi_session", 会话ID);
}

公开 函数 清除会话(响应值: 响应) : 响应 {
    返回 删除Cookie(响应值, "qi_session");
}

// 生成新 session ID（UUID）
公开 函数 新会话ID() : 字符串 {
    返回 随机.UUID();
}

// 通过 sid 读取整个 session 数据字符串
公开 函数 读取会话数据(会话ID: 字符串) : 字符串 {
    如果 (字符串::字节长度(会话ID) == 0) {
        返回 "";
    }
    如果 (会话库 > 0) {
        返回 Redis.取(会话库, 会话键(会话ID));
    }
    确保会话存储();
    返回 表库::获取字符串(会话存储, 会话ID);
}

// 写入整个 session 数据字符串
公开 函数 写入会话数据(会话ID: 字符串, 数据: 字符串) : 整数 {
    如果 (字符串::字节长度(会话ID) == 0) {
        返回 0;
    }
    如果 (会话库 > 0) {
        // 写和续期是**同一条命令**（SETEX）。分成 设() + 设过期() 两步的话，
        // 中间进程被杀就留下一个永不过期的会话键，攒够了没人会发现。
        如果 (Redis.设并过期(会话库, 会话键(会话ID), 数据, 会话存活秒) < 0) {
            返回 0;
        }
        返回 1;
    }
    确保会话存储();
    表库::设置字符串(会话存储, 会话ID, 数据);
    返回 1;
}

// 在数据字符串里读取一个键
公开 函数 会话取值(会话ID: 字符串, 键: 字符串) : 字符串 {
    变量 数据: 字符串 = 读取会话数据(会话ID);
    如果 (字符串::字节长度(数据) == 0) {
        返回 "";
    }
    返回 会话提取键值(数据, 键);
}

// 写一个键到 session 数据
公开 函数 会话设值(会话ID: 字符串, 键: 字符串, 值: 字符串) : 整数 {
    变量 旧数据: 字符串 = 读取会话数据(会话ID);
    变量 新数据: 字符串 = 替换或追加键值(旧数据, 键, 值);
    返回 写入会话数据(会话ID, 新数据);
}

// 销毁会话
公开 函数 销毁会话(会话ID: 字符串) : 整数 {
    如果 (字符串::字节长度(会话ID) == 0) {
        返回 0;
    }
    如果 (会话库 > 0) {
        Redis.删(会话库, 会话键(会话ID));
        返回 1;
    }
    确保会话存储();
    表库::设置字符串(会话存储, 会话ID, "");
    返回 1;
}

// ===== 内部辅助函数 =====

函数 会话提取键值(数据: 字符串, 键: 字符串) : 字符串 {
    如果 (字符串::字节长度(数据) == 0) {
        返回 "";
    }
    变量 查找键: 字符串 = 键 + "=";
    变量 开始: 整数 = 0;
    变量 总长: 整数 = 字符串::字节长度(数据);

    当 (开始 < 总长) {
        变量 分隔: 整数 = 字符串::查找从位置(数据, "&", 开始);
        如果 (分隔 < 0) {
            分隔 = 总长;
        }
        变量 项: 字符串 = 字符串::子串(数据, 开始, 分隔 - 开始);
        如果 (字符串::开始于(项, 查找键) == 1) {
            返回 字符串::子串从位置(项, 字符串::字节长度(查找键));
        }
        开始 = 分隔 + 1;
    }
    返回 "";
}

函数 替换或追加键值(数据: 字符串, 键: 字符串, 值: 字符串) : 字符串 {
    变量 新项: 字符串 = 键 + "=" + 值;
    如果 (字符串::字节长度(数据) == 0) {
        返回 新项;
    }
    变量 查找键: 字符串 = 键 + "=";
    变量 开始: 整数 = 0;
    变量 总长: 整数 = 字符串::字节长度(数据);
    变量 结果文本: 字符串 = "";
    变量 找到: 整数 = 0;

    当 (开始 < 总长) {
        变量 分隔: 整数 = 字符串::查找从位置(数据, "&", 开始);
        如果 (分隔 < 0) {
            分隔 = 总长;
        }
        变量 项: 字符串 = 字符串::子串(数据, 开始, 分隔 - 开始);
        如果 (字符串::字节长度(结果文本) > 0) {
            结果文本 = 结果文本 + "&";
        }
        如果 (字符串::开始于(项, 查找键) == 1) {
            结果文本 = 结果文本 + 新项;
            找到 = 1;
        } 否则 {
            结果文本 = 结果文本 + 项;
        }
        开始 = 分隔 + 1;
    }

    如果 (找到 == 0) {
        如果 (字符串::字节长度(结果文本) > 0) {
            结果文本 = 结果文本 + "&";
        }
        结果文本 = 结果文本 + 新项;
    }

    返回 结果文本;
}
