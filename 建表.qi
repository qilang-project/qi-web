// qi-web · 建表 —— 方言无关的建表 DDL 助手（SQLite / PostgreSQL / MySQL）
//
// 为什么单独一层：查询能在中间层抹平（对外永远 `?`，发往 PG 前改写成 $n），
// 建表抹不平 —— 自增主键 / 布尔 / 时间戳 / 当前时间默认值，三家写法互不兼容，
// 而且这些差异只在「建表那一刻」出现，运行期的读写路径根本碰不到。
// Rails 的 SchemaStatements、Django 的 BaseDatabaseSchemaEditor、Flyway 的
// 方言包都把它放在迁移层而不是驱动层，本文件是同一个位置。
// 依据：docs/多数据库设计.md 4.3 与实施切片 S5。
//
// 用法（一份声明，三个后端）：
//
//     变量 定义 = 新建表(当前后端(库), "卡片");
//     定义 = 列自增主键(定义, "id");
//     定义 = 非空(列整数(定义, "用户id"));
//     定义 = 默认文本(非空(列文本(定义, "标题")), "无题");
//     定义 = 默认当前时间(列时间戳(定义, "创建时间"));
//     事务建表(事务, 定义);        // 迁移回调里；连接级用 库建表(库, 定义)
//
// 风格照 查询.qi：值语义结构体 + 每个链式函数收结构体、改字段、返回新结构体。
// 修饰符（非空 / 唯一 / 默认*）作用于**最近一列** —— 结构体里留一个未封口的
// 「待定列」，下一次 列* 调用或生成 SQL 时才封口。这样修饰符不用重复列名，
// 也不用位标志参数（`列文本(定义, "标题", 非空 + 唯一)` 那种写法在 qi 里只能
// 退化成整数掩码，可读性和类型安全都更差）。
//
// 已有的裸 DDL 不强制迁移：它们在 SQLite 上照常工作，只有真要换后端时才改写。
包 Web.建表;

导入 标准库.字符串;
导入 标准库.数据库;
导入 标准库.环境;
导入 标准库.正则;
导入 标准库.JSON 作为 J;

// ────────────────────────────── 数据结构 ──────────────────────────────

// 建表定义：一条 CREATE TABLE 的可链式累加状态。
公开 类型 表定义 {
    字符串 后端;      // "sqlite" / "postgres" / "mysql"（已规范化）
    字符串 表名;      // 已校验
    字符串 列串;      // 已封口的列 DDL，", " 连接
    整数 列数;
    // ↓ 待定列：还能被 非空/唯一/默认* 修饰，名为 "" 表示当前没有待定列
    字符串 待定名;
    字符串 待定类型;  // 已按方言展开，如 "BIGINT" / "VARCHAR(255)"
    整数 待定非空;
    字符串 待定默认;  // 已渲染成 SQL 字面量，"" 表示无默认值
    整数 待定唯一;
    整数 待定长文本;  // 1 = 该列在 MySQL 上落成 TEXT（不能唯一、不能有默认值）
    字符串 约束串;    // 表级约束，形如 ", UNIQUE (甲, 乙)"
}

// ────────────────────────────── 后端判定 ──────────────────────────────

公开 函数 规范后端(名: 字符串) : 字符串 {
    如果 字符串::等于(名, "sqlite") == 1 { 返回 "sqlite"; }
    如果 字符串::等于(名, "postgres") == 1 { 返回 "postgres"; }
    如果 字符串::等于(名, "postgresql") == 1 { 返回 "postgres"; }
    如果 字符串::等于(名, "pg") == 1 { 返回 "postgres"; }
    如果 字符串::等于(名, "mysql") == 1 { 返回 "mysql"; }
    如果 字符串::等于(名, "mariadb") == 1 { 返回 "mysql"; }
    抛出 "未知数据库后端：" + 名 + "（只认 sqlite / postgres / mysql）";
    返回 "sqlite";
}

// 取连接当前的后端。
//
// ⚠ 临时实现：驱动层的 `数据库.后端(句柄) : 字符串` 还没落地
// （docs/多数据库设计.md 第五节，另一条工作线在做）。它一到位，把函数体换成
//     返回 规范后端(数据库.后端(库));
// 即可，调用方一行不用改。在那之前用 QI_DB_BACKEND 注入；不设即 sqlite ——
// 与驱动「无 scheme 即文件路径」的旧行为一致。
公开 函数 当前后端(库: 整数) : 字符串 {
    返回 当前后端();
}

// 无句柄版。迁移回调只拿得到事务句柄（拿不到连接句柄），离线生成 DDL 时更是
// 一个句柄都没有 —— 那时用这个。驱动层的 数据库.后端 落地后，两者会分岔：
// 带句柄的问连接，不带句柄的继续读 QI_DB_BACKEND。
公开 函数 当前后端() : 字符串 {
    变量 注入: 字符串 = 环境.获取("QI_DB_BACKEND");
    如果 字符串::等于(注入, "") == 1 { 返回 "sqlite"; }
    返回 规范后端(注入);
}

函数 是后端(定义: 表定义, 名: 字符串) : 布尔 {
    如果 字符串::等于(定义.后端, 名) == 1 { 返回 真; }
    返回 假;
}

// ────────────────────────────── 校验 ──────────────────────────────

// 表名 / 列名白名单，与 查询.qi 的 断言标识符 同一条规则（中文/字母/下划线开头）。
// 这里不复用 查询.qi 是有意的：建表层只依赖标准库，跟迁移.qi 一样保持自足。
函数 断言名字(名: 字符串) {
    如果 (正则.是否匹配("^[\\p{L}_][\\p{L}\\p{N}_]*$", 名) == 0) {
        抛出 "非法表名/列名：" + 名;
    }
}

函数 断言名字清单(清单: 字符串) {
    变量 一项: 字符串 = "[\\p{L}_][\\p{L}\\p{N}_]*";
    如果 (正则.是否匹配("^\\s*" + 一项 + "(\\s*,\\s*" + 一项 + ")*\\s*$", 清单) == 0) {
        抛出 "非法列清单：" + 清单;
    }
}

函数 断言有待定列(定义: 表定义, 修饰: 字符串) {
    如果 字符串::等于(定义.待定名, "") == 1 {
        抛出 "「" + 修饰 + "」没有可修饰的列 —— 它只作用于最近一次 列* 调用"
            + "（自增主键列已自带 PRIMARY KEY，不接受修饰）";
    }
}

// DDL 里的默认值没法走参数绑定（三家都不允许 `DEFAULT ?`），只能拼字面量，
// 所以这里比 查询.qi 的 转义SQL 更严：单引号按 SQL 标准双写，反斜杠直接拒绝 ——
// MySQL 默认把 \ 当转义字符而 SQLite/PG 不当，同一段 DDL 会在两边存出不同的值。
函数 文本字面(值: 字符串) : 字符串 {
    如果 字符串::包含(值, "\\") == 1 {
        抛出 "默认值不能含反斜杠（MySQL 与 SQLite/PG 的转义规则不同）：" + 值;
    }
    返回 "'" + 字符串::替换(值, "'", "''") + "'";
}

// ────────────────────────────── 起点与封口 ──────────────────────────────

公开 函数 新建表(后端: 字符串, 表名: 字符串) : 表定义 {
    断言名字(表名);
    返回 新建 表定义 {
        后端: 规范后端(后端),
        表名: 表名,
        列串: "",
        列数: 0,
        待定名: "",
        待定类型: "",
        待定非空: 0,
        待定默认: "",
        待定唯一: 0,
        待定长文本: 0,
        约束串: ""
    };
}

函数 追加列(定义: 表定义, 本列: 字符串) : 表定义 {
    如果 定义.列数 == 0 {
        定义.列串 = 本列;
    } 否则 {
        定义.列串 = 定义.列串 + ", " + 本列;
    }
    定义.列数 = 定义.列数 + 1;
    返回 定义;
}

// 把待定列拼成一段列 DDL 并并入列串。
// 修饰顺序钉死成「类型 NOT NULL DEFAULT x UNIQUE」：SQLite 与 PG 不挑顺序，
// MySQL 的列定义文法挑（DEFAULT 必须排在 NOT NULL 之后、UNIQUE 之前）。
函数 封口(定义: 表定义) : 表定义 {
    如果 字符串::等于(定义.待定名, "") == 1 { 返回 定义; }
    变量 本列: 字符串 = 定义.待定名 + " " + 定义.待定类型;
    如果 定义.待定非空 == 1 { 本列 = 本列 + " NOT NULL"; }
    如果 字符串::等于(定义.待定默认, "") == 0 { 本列 = 本列 + " DEFAULT " + 定义.待定默认; }
    如果 定义.待定唯一 == 1 { 本列 = 本列 + " UNIQUE"; }
    定义 = 追加列(定义, 本列);
    定义.待定名 = "";
    定义.待定类型 = "";
    定义.待定非空 = 0;
    定义.待定默认 = "";
    定义.待定唯一 = 0;
    定义.待定长文本 = 0;
    返回 定义;
}

函数 起新列(定义: 表定义, 列名: 字符串, 类型串: 字符串) : 表定义 {
    断言名字(列名);
    定义 = 封口(定义);
    定义.待定名 = 列名;
    定义.待定类型 = 类型串;
    返回 定义;
}

// ────────────────────────────── 列类型 ──────────────────────────────

// 自增主键。三家的写法是「类型 + 约束」黏死的固定串，顺序还各不相同，
// 所以本列直接封口、不接受后续修饰（NOT NULL 与 UNIQUE 已被 PRIMARY KEY 蕴含）。
//
// PG 用 BIGSERIAL 而不是设计稿里的 SERIAL、MySQL 用 BIGINT 而不是 INT：
// qi 的 整数 是 i64，SQLite 的 rowid 本来就是 64 位，主键落到 int4 上既会在
// 21 亿行处翻车，也和 数据库.最后插入id 的整数返回类型对不齐。
公开 函数 列自增主键(定义: 表定义, 列名: 字符串) : 表定义 {
    断言名字(列名);
    定义 = 封口(定义);
    如果 是后端(定义, "postgres") {
        返回 追加列(定义, 列名 + " BIGSERIAL PRIMARY KEY");
    }
    如果 是后端(定义, "mysql") {
        返回 追加列(定义, 列名 + " BIGINT AUTO_INCREMENT PRIMARY KEY");
    }
    返回 追加列(定义, 列名 + " INTEGER PRIMARY KEY AUTOINCREMENT");
}

// 整数列。同上，PG/MySQL 一律 BIGINT 对齐 qi 的 i64。
公开 函数 列整数(定义: 表定义, 列名: 字符串) : 表定义 {
    如果 是后端(定义, "sqlite") { 返回 起新列(定义, 列名, "INTEGER"); }
    返回 起新列(定义, 列名, "BIGINT");
}

// 短文本列。MySQL 落成 VARCHAR(255) 而不是 TEXT，因为 MySQL 的 TEXT 既不能
// 整列建唯一索引（要前缀长度），5.7 上也不能有默认值 —— 想要 唯一/默认 的列
// 必须是 VARCHAR。SQLite/PG 的 TEXT 无长度概念，不受影响。
公开 函数 列文本(定义: 表定义, 列名: 字符串) : 表定义 {
    如果 是后端(定义, "mysql") { 返回 起新列(定义, 列名, "VARCHAR(255)"); }
    返回 起新列(定义, 列名, "TEXT");
}

// 长文本列：三家都是 TEXT。代价是在 MySQL 上不能加 唯一/默认（下面会拦住）。
公开 函数 列长文本(定义: 表定义, 列名: 字符串) : 表定义 {
    定义 = 起新列(定义, 列名, "TEXT");
    定义.待定长文本 = 1;
    返回 定义;
}

公开 函数 列浮点(定义: 表定义, 列名: 字符串) : 表定义 {
    如果 是后端(定义, "postgres") { 返回 起新列(定义, 列名, "DOUBLE PRECISION"); }
    如果 是后端(定义, "mysql") { 返回 起新列(定义, 列名, "DOUBLE"); }
    返回 起新列(定义, 列名, "REAL");
}

// 布尔列。SQLite 无布尔类型，沿用现有代码的 0/1 INTEGER 约定；
// MySQL 的 BOOLEAN 本身就是 TINYINT(1) 的别名，写实际类型少一层别名歧义。
公开 函数 列布尔(定义: 表定义, 列名: 字符串) : 表定义 {
    如果 是后端(定义, "postgres") { 返回 起新列(定义, 列名, "BOOLEAN"); }
    如果 是后端(定义, "mysql") { 返回 起新列(定义, 列名, "TINYINT(1)"); }
    返回 起新列(定义, 列名, "INTEGER");
}

// 时间戳列。SQLite 用 TEXT 而不是 TIMESTAMP：SQLite 没有日期类型，
// TIMESTAMP 会拿到 NUMERIC 亲和性，而仓库里现有的时间列（迁移表的 执行时间 等）
// 存的都是 "%Y-%m-%d %H:%M:%S" 文本。PG 用带时区的 TIMESTAMPTZ，读回来是字符串
// （见设计文档 4.2 的类型映射），与 SQLite 侧的文本读法一致。
公开 函数 列时间戳(定义: 表定义, 列名: 字符串) : 表定义 {
    如果 是后端(定义, "postgres") { 返回 起新列(定义, 列名, "TIMESTAMPTZ"); }
    如果 是后端(定义, "mysql") { 返回 起新列(定义, 列名, "DATETIME"); }
    返回 起新列(定义, 列名, "TEXT");
}

// ────────────────────────────── 列修饰 ──────────────────────────────

公开 函数 非空(定义: 表定义) : 表定义 {
    断言有待定列(定义, "非空");
    定义.待定非空 = 1;
    返回 定义;
}

公开 函数 唯一(定义: 表定义) : 表定义 {
    断言有待定列(定义, "唯一");
    // 与其产出一段只在 MySQL 上报错的 DDL，不如在生成时就说清楚该换哪个列类型。
    如果 定义.待定长文本 == 1 且 是后端(定义, "mysql") {
        抛出 "MySQL 不能对 TEXT 列建整列唯一索引：" + 定义.待定名 + "，改用 列文本";
    }
    定义.待定唯一 = 1;
    返回 定义;
}

公开 函数 默认文本(定义: 表定义, 值: 字符串) : 表定义 {
    断言有待定列(定义, "默认文本");
    如果 定义.待定长文本 == 1 且 是后端(定义, "mysql") {
        抛出 "MySQL 的 TEXT 列不能有默认值：" + 定义.待定名 + "，改用 列文本";
    }
    定义.待定默认 = 文本字面(值);
    返回 定义;
}

公开 函数 默认整数(定义: 表定义, 值: 整数) : 表定义 {
    断言有待定列(定义, "默认整数");
    定义.待定默认 = 整数转字符串(值);
    返回 定义;
}

公开 函数 默认浮点(定义: 表定义, 值: 浮点数) : 表定义 {
    断言有待定列(定义, "默认浮点");
    定义.待定默认 = 浮点数转字符串(值);
    返回 定义;
}

// PG 的布尔列只认 TRUE/FALSE（写 1 会报类型错），SQLite/MySQL 存 0/1。
公开 函数 默认布尔(定义: 表定义, 值: 布尔) : 表定义 {
    断言有待定列(定义, "默认布尔");
    如果 是后端(定义, "postgres") {
        如果 值 { 定义.待定默认 = "TRUE"; } 否则 { 定义.待定默认 = "FALSE"; }
        返回 定义;
    }
    如果 值 { 定义.待定默认 = "1"; } 否则 { 定义.待定默认 = "0"; }
    返回 定义;
}

// 当前时间默认值。注意与 当前时间表达式 的区别：这里是 DDL 的 DEFAULT 位置，
// SQLite 要求表达式默认值必须带括号，MySQL 的 DEFAULT 只认 CURRENT_TIMESTAMP 家族。
公开 函数 默认当前时间(定义: 表定义) : 表定义 {
    断言有待定列(定义, "默认当前时间");
    如果 是后端(定义, "postgres") { 定义.待定默认 = "now()"; 返回 定义; }
    如果 是后端(定义, "mysql") { 定义.待定默认 = "CURRENT_TIMESTAMP"; 返回 定义; }
    定义.待定默认 = "(datetime('now'))";
    返回 定义;
}

// ────────────────────────────── 表级约束 ──────────────────────────────

公开 函数 唯一组(定义: 表定义, 列清单: 字符串) : 表定义 {
    断言名字清单(列清单);
    定义 = 封口(定义);
    定义.约束串 = 定义.约束串 + ", UNIQUE (" + 列清单 + ")";
    返回 定义;
}

// ────────────────────────────── 终结：生成与执行 ──────────────────────────────

公开 函数 生成建表SQL(定义: 表定义) : 字符串 {
    定义 = 封口(定义);
    如果 定义.列数 == 0 {
        抛出 "建表定义没有列：" + 定义.表名;
    }
    变量 SQL: 字符串 = "CREATE TABLE IF NOT EXISTS " + 定义.表名
        + " (" + 定义.列串 + 定义.约束串 + ")";
    // MySQL 5.7 的库级默认字符集可能还是 latin1，而 qi 的表名列名本身就是中文；
    // 显式钉死 utf8mb4 比赌服务器配置可靠。InnoDB 则是事务的前提 —— 迁移全程在事务里。
    如果 是后端(定义, "mysql") {
        返回 SQL + " ENGINE=InnoDB DEFAULT CHARSET=utf8mb4";
    }
    返回 SQL;
}

函数 写成功(结果JSON: 字符串) : 整数 {
    变量 对象: 整数 = J.解码(结果JSON);
    如果 (对象 <= 0) { 返回 0; }
    变量 值: 整数 = J.获取整数(对象, "成功");
    J.删除(对象);
    返回 值;
}

// 事务里建表：返回 1 成功 / 0 失败 —— 正好是 迁移.qi 的 执行迁移 期待的回调返回值。
公开 函数 事务建表(事务: 整数, 定义: 表定义) : 整数 {
    返回 写成功(数据库.事务执行参数(事务, 生成建表SQL(定义), "[]"));
}

// 连接级建表（不在迁移里时用）。数据库.执行 返回影响行数或 -1，统一成 1/0。
公开 函数 库建表(库: 整数, 定义: 表定义) : 整数 {
    如果 数据库.执行(库, 生成建表SQL(定义)) < 0 { 返回 0; }
    返回 1;
}

// ────────────────────────────── DML 侧的方言片段 ──────────────────────────────

// 「现在」的 SQL 表达式，用在 INSERT/UPDATE 的值位置（不是 DDL 的 DEFAULT 位置）。
公开 函数 当前时间表达式(后端: 字符串) : 字符串 {
    变量 名: 字符串 = 规范后端(后端);
    如果 字符串::等于(名, "postgres") == 1 { 返回 "now()"; }
    如果 字符串::等于(名, "mysql") == 1 { 返回 "NOW()"; }
    返回 "datetime('now')";
}

// upsert 尾巴：SQLite 与 PG 共用 ON CONFLICT，MySQL 是另一套语法且不需要冲突列。
// 拼在 `INSERT INTO … VALUES (…)` 之后即可。
//
//     插入SQL + 冲突更新子句(后端, "用户id", "标题, 更新时间")
公开 函数 冲突更新子句(后端: 字符串, 冲突列清单: 字符串, 更新列清单: 字符串) : 字符串 {
    变量 名: 字符串 = 规范后端(后端);
    断言名字清单(冲突列清单);
    断言名字清单(更新列清单);

    变量 切JSON: 字符串 = 正则.切割(",", 更新列清单);
    变量 列数组: 整数 = J.解码(切JSON);
    变量 总数: 整数 = J.数组长度(列数组);
    变量 赋值串: 字符串 = "";
    变量 i: 整数 = 0;
    当 i < 总数 {
        变量 列名: 字符串 = 字符串::去空白(J.数组获取字符串(列数组, i));
        变量 一项: 字符串 = "";
        如果 字符串::等于(名, "mysql") == 1 {
            // MySQL 8.0.20 起推荐 `AS 新值 … SET 列 = 新值.列`，但 VALUES() 仍然通用，
            // 且不需要在 INSERT 头部加别名 —— 对拼接式 SQL 侵入更小。
            一项 = 列名 + " = VALUES(" + 列名 + ")";
        } 否则 {
            一项 = 列名 + " = excluded." + 列名;
        }
        如果 i == 0 { 赋值串 = 一项; } 否则 { 赋值串 = 赋值串 + ", " + 一项; }
        i = i + 1;
    }
    J.删除(列数组);

    如果 字符串::等于(名, "mysql") == 1 {
        返回 " ON DUPLICATE KEY UPDATE " + 赋值串;
    }
    返回 " ON CONFLICT (" + 冲突列清单 + ") DO UPDATE SET " + 赋值串;
}
