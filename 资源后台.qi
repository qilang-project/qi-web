// Qi Web - 资源后台：一张表 + 一份列规格 + 一份字段规格 → 列表/新建/编辑/删除四屏。
//
// ── 它只是把零件拼一次，不是新东西 ──────────────────────────────
//
// 底下全是已有的：查询器出 SQL、数据表渲染行、分页栏翻页、表单收数据和校验、
// 闪现说结果。这里只做"最常见的那种拼法"。
//
// **顺序很重要：先有零件，才有这层。** 反过来做的脚手架永远是同一个下场 ——
// 好用到某一天不好用，然后你发现掀不开盖子。所以这里的每一层都能单独用：
// 不想要列表页就自己调 列一页 + 数据表带选项；不想要整套就别用这个文件。
//
// ── 有意不做的 ──────────────────────────────────────────────────
//
// 关联字段（下拉选另一张表）、文件上传、批量操作、导出：都不做。
// 它们各自有太多种做法，塞进来只会让这层变成一个必须配置一百个开关的东西，
// 而配置一百个开关比自己写四屏还累。要这些就掉到零件层自己拼。
包 Web;

导入 标准库.字符串;
导入 标准库.JSON 作为 J;
导入 标准库.数据库 作为 数据库;
导入 Web.HTML块::{HTML块, HTML, 创建片段, 块加子块, 块加原文};
导入 Web.数据表::{
    列规格, 表选项, 表选项默认, 表选项路径, 数据表带选项, 列一页, 列表页, 读排序
};
导入 Web.分页::{分页参数, 创建分页参数, 实时分页栏};
导入 Web.表单::{
    表单, 新表单, 从值建表单, 表单值, 表单填, 表单载入, 表单错, 表单置错,
    表单清错, 表单有错, 校验必填, 文本字段, 数字字段, 多行字段,
    日期字段, 选择字段, 存表单
};
导入 Web.闪现::{闪现, 闪现错误, 闪现块};
导入 Web.查询::{表, 选取, 条件模糊, 或文本, 开始条件组, 结束条件组};

// ── 字段规格：表单那一半 ────────────────────────────────────────

公开 类型 字段规格 {
    字符串 列;
    字符串 标签;
    字符串 种;       // 文本 / 数字 / 多行 / 日期 / 选择
    整数 必填;
    整数 可改;       // 0 = 只在新建时能填（比如用户名）
    数组<字符串> 选项;   // 仅 种="选择"：值|显示 两两一组平铺
    字符串 仅当列;       // 条件显示：这一列
    字符串 仅当值;       //           等于这个值时才显示本字段
}

函数 基础字段(标签: 字符串, 列: 字符串, 种: 字符串) : 字段规格 {
    返回 新建 字段规格 {
        列: 列, 标签: 标签, 种: 种, 必填: 0, 可改: 1,
        选项: 数组<字符串>(0), 仅当列: "", 仅当值: ""
    };
}

公开 函数 字段文本(标签: 字符串, 列: 字符串) : 字段规格 {
    返回 基础字段(标签, 列, "文本");
}

公开 函数 字段数字(标签: 字符串, 列: 字符串) : 字段规格 {
    返回 基础字段(标签, 列, "数字");
}

公开 函数 字段多行(标签: 字符串, 列: 字符串) : 字段规格 {
    返回 基础字段(标签, 列, "多行");
}

公开 函数 字段日期(标签: 字符串, 列: 字符串) : 字段规格 {
    返回 基础字段(标签, 列, "日期");
}

// 下拉。选项 是「值|显示」两两一组的平铺数组，见 表单.选择字段。
公开 函数 字段选择(标签: 字符串, 列: 字符串, 选项表: 数组<字符串>) : 字段规格 {
    变量 f: 字段规格 = 基础字段(标签, 列, "选择");
    f.选项 = 选项表;
    返回 f;
}

公开 函数 字段必填(字段: 字段规格) : 字段规格 {
    字段.必填 = 1;
    返回 字段;
}

公开 函数 字段建后不可改(字段: 字段规格) : 字段规格 {
    字段.可改 = 0;
    返回 字段;
}

// 只在另一列取某个值时才显示这个字段。
//
// 判断在**浏览器里**做，不回服务端：换一下「类别」下拉就要走一趟网络
// 才看见对应字段，在填表途中是明显的卡顿。而这纯粹是显示与否，
// 服务端本来也不关心。
//
// 代价要说清楚：**隐藏的字段仍然会随表单提交**。所以这不是权限，
// 是「别让人看见跟当前选择无关的十个框」。真要禁止某些组合，
// 在 保存一条 之后自己校验 —— 这一层挡不住。
// 值 可以给**多个，空格分开** —— `字段仅当(f, "类别", "定期 活期理财")`。
//
// 需要多值是被真需求逼的：「年化」这一列定期和活期理财都要填，而两者
// 是不同的类别。用两个 字段仅当 各挂一个类别做不到 —— 它们指向同一列，
// 表单里就会出现两个同名 input，被隐藏的那个照样提交空值，把另一个
// 刚填的值冲掉。这正是本函数注释里那条「隐藏字段照样提交」的后果。
公开 函数 字段仅当(字段: 字段规格, 列: 字符串, 值: 字符串) : 字段规格 {
    字段.仅当列 = 列;
    字段.仅当值 = 值;
    返回 字段;
}

// ── 资源定义 ────────────────────────────────────────────────────

公开 类型 后台资源 {
    字符串 路径;       // 轻路由基路径，如 "/admin/members"
    字符串 表名;
    字符串 主键;
    字符串 单数名;     // "会员" —— 用在「新建会员」「删除这个会员」这些话里
    整数 每页;
}

公开 函数 资源(路径: 字符串, 表名: 字符串, 单数名: 字符串) : 后台资源 {
    返回 新建 后台资源 {
        路径: 路径, 表名: 表名, 主键: "id", 单数名: 单数名, 每页: 20
    };
}

公开 函数 资源主键(资: 后台资源, 主键: 字符串) : 后台资源 {
    返回 新建 后台资源 {
        路径: 资.路径, 表名: 资.表名, 主键: 主键, 单数名: 资.单数名, 每页: 资.每页
    };
}

公开 函数 资源每页(资: 后台资源, 每页: 整数) : 后台资源 {
    返回 新建 后台资源 {
        路径: 资.路径, 表名: 资.表名, 主键: 资.主键, 单数名: 资.单数名, 每页: 每页
    };
}

// ── 列表屏 ──────────────────────────────────────────────────────

// 搜索 + 排序 + 分页 + 表格 + 「新建」按钮。
//
// 搜索是**跨多列的模糊匹配**，列由调用方给（可搜列）。不给就没有搜索框 ——
// 摆一个搜不到任何东西的搜索框比没有更气人。
公开 函数 列表屏(库: 整数, 资: 后台资源, 列: 数组<列规格>,
                可搜列: 数组<字符串>, 状态: 整数) : HTML块 {
    变量 关键词: 字符串 = J.获取字符串(状态, "_搜");
    变量 页码: 整数 = J.获取整数(状态, "_页");
    如果 (页码 < 1) { 页码 = 1; }

    变量 查 = 选取(表(库, 资.表名), "*");
    如果 (字符串::字节长度(关键词) > 0 与 长度(可搜列) > 0) {
        // 条件组：把 OR 括起来。不括的话它会跟外层的 AND 连成
        // `A AND B OR C`，语义整个变了 —— 而这种错在有数据时看着像"搜出来的多了点"
        查 = 开始条件组(查, "AND");
        对于 i 在 0 直到 长度(可搜列) {
            如果 (i == 0) { 查 = 条件模糊(查, 可搜列[i], "%" + 关键词 + "%"); }
            否则 { 查 = 或文本(查, 可搜列[i], "LIKE", "%" + 关键词 + "%"); }
        }
        查 = 结束条件组(查);
    }

    变量 设: 表选项 = 表选项路径(读排序(J.转字符串(状态), 列, ""), 资.路径);
    变量 页: 列表页 = 列一页(查, 创建分页参数(页码, 资.每页, 资.每页, 200), 设);

    变量 搜块: HTML块 = 创建片段();
    如果 (长度(可搜列) > 0) {
        搜块 = HTML {
            <form class="qi-admin-search" data-change="搜">
                <input name="词" value={关键词} placeholder="搜索" autocomplete="off" />
            </form>
        };
    }

    返回 HTML {
        {闪现块(状态)}
        <div class="qi-admin-bar">
            {搜块}
            <button type="button" data-click="新建">＋ 新建{资.单数名}</button>
        </div>
        {数据表带选项(页.行JSON, 列, 设)}
        {实时分页栏(页.页信息, "翻页")}
    };
}

// ── 表单屏（新建 / 编辑共用）────────────────────────────────────
//
// 共用是有理由的：两屏差别只有标题和「哪些字段能改」。做成两份的话，
// 加一个字段要改两处，而漏改的那处不会报错，只会静静地少一个输入框。
公开 函数 表单屏(资: 后台资源, 字段: 数组<字段规格>, 表: 表单,
                是新建: 整数, 状态: 整数) : HTML块 {
    变量 标题: 字符串 = "编辑" + 资.单数名;
    如果 (是新建 == 1) { 标题 = "新建" + 资.单数名; }

    变量 域: HTML块 = 创建片段();
    对于 i 在 0 直到 长度(字段) {
        变量 f: 字段规格 = 字段[i];
        // 建后不可改的字段在编辑时**不渲染**，而不是渲染成禁用 ——
        // 禁用的输入框仍然在 FormData 里（空值），提交时会把原值冲掉
        如果 (是新建 == 1 或 f.可改 == 1) {
            域 = 块加子块(域, 一个字段(表, f));
        }
    }

    返回 HTML {
        {闪现块(状态)}
        <h3>{标题}</h3>
        <form class="qi-admin-form" data-submit="保存" data-hook="QiAdminWhen">
            {域}
            <div class="qi-admin-bar">
                <button type="submit">保存</button>
                <button type="button" data-click="取消">取消</button>
            </div>
        </form>
        {块加原文(创建片段(), 仅当脚本())}
    };
}

函数 一个字段(表: 表单, f: 字段规格) : HTML块 {
    变量 芯: HTML块 = 文本字段(表, f.列, f.标签);
    如果 (字符串::等于(f.种, "数字") == 1) { 芯 = 数字字段(表, f.列, f.标签); }
    如果 (字符串::等于(f.种, "多行") == 1) { 芯 = 多行字段(表, f.列, f.标签); }
    如果 (字符串::等于(f.种, "日期") == 1) { 芯 = 日期字段(表, f.列, f.标签); }
    如果 (字符串::等于(f.种, "选择") == 1) { 芯 = 选择字段(表, f.列, f.标签, f.选项); }

    如果 (字符串::字节长度(f.仅当列) == 0) { 返回 芯; }
    // 属性名全英文（HTML 属性名不用中文，见 CLAUDE.md）。
    // hidden 先加上：这样在脚本跑起来之前也不会闪一下再消失。
    返回 HTML {
        <div class="qi-admin-when" hidden
             data-when-field={f.仅当列} data-when-value={f.仅当值}>{芯}</div>
    };
}

// 条件字段的显示脚本。挂一次即可，放在表单屏里。
//
// 用事件委托绑在 form 上，而不是给每个 select 各绑一个 ——
// LiveView 会 morph 掉并重建这些节点，绑在节点上的监听器随之消失，
// 而 form 本身在 morph 中是稳定的。这个坑不表现为报错，
// 表现为「换过一次类别之后条件字段就再也不动了」。
函数 仅当脚本() : 字符串 {
    返回 `<script>
(function () {
  function sync(form) {
    form.querySelectorAll('.qi-admin-when').forEach(function (box) {
      var field = box.getAttribute('data-when-field');
      var want = (box.getAttribute('data-when-value') || '').split(/\s+/);
      var src = form.querySelector('[name="' + field + '"]');
      box.hidden = !src || want.indexOf(String(src.value)) < 0;
    });
  }
  document.addEventListener('change', function (e) {
    var form = e.target.closest && e.target.closest('form.qi-admin-form');
    if (form) sync(form);
  });
  function syncAll() {
    document.querySelectorAll('form.qi-admin-form').forEach(sync);
  }
  // 重渲染后的再同步走 hook —— **框架没有 qi:patched 这种全局事件**
  // （臆想过一次，代价是 morph 之后条件字段全部回到 hidden 初始态）。
  // mounted/updated 由 morph 在表单出现/变化时调用。
  window.qiHooks = window.qiHooks || {};
  window.qiHooks.QiAdminWhen = {
    mounted: function (el) { sync(el); },
    updated: function (el) { sync(el); }
  };
  document.addEventListener('DOMContentLoaded', syncAll);
  syncAll();
})();
</script>
`;
}

// ── 保存 ────────────────────────────────────────────────────────

// 校验 + INSERT/UPDATE。成功返回 1 并闪现，失败把错落在表单上并返回 0。
//
// **校验和写库在一个函数里**是有意的：分开的话调用方可能只调其中一个，
// 而"忘了校验直接写库"这种错在测试里发现不了 —— 测试都会填合法数据。
公开 函数 保存一条(库: 整数, 资: 后台资源, 字段: 数组<字段规格>,
                  表入: 表单, id: 整数, 状态: 整数) : 整数 {
    变量 表: 表单 = 表单清错(表入);
    对于 i 在 0 直到 长度(字段) {
        如果 (字段[i].必填 == 1) {
            表 = 校验必填(表, 字段[i].列, 字段[i].标签 + "不能空着");
        }
    }
    如果 (表单有错(表) == 1) {
        存表单(状态, 表);
        返回 0;
    }

    变量 列名: 字符串 = "";
    变量 占位: 字符串 = "";
    变量 参: 整数 = J.创建数组();
    变量 赋值: 字符串 = "";
    变量 n: 整数 = 0;
    对于 i 在 0 直到 长度(字段) {
        变量 f: 字段规格 = 字段[i];
        如果 (id > 0 与 f.可改 == 0) { 继续; }
        如果 (n > 0) { 列名 = 列名 + ", "; 占位 = 占位 + ", "; 赋值 = 赋值 + ", "; }
        列名 = 列名 + "\"" + f.列 + "\"";
        占位 = 占位 + "?";
        赋值 = 赋值 + "\"" + f.列 + "\" = ?";
        J.数组添加字符串(参, 表单值(表, f.列));
        n = n + 1;
    }
    如果 (n == 0) { J.删除(参); 返回 0; }

    变量 SQL: 字符串 = "";
    如果 (id > 0) {
        J.数组添加整数(参, id);
        SQL = "UPDATE \"" + 资.表名 + "\" SET " + 赋值
            + " WHERE \"" + 资.主键 + "\" = ?";
    } 否则 {
        SQL = "INSERT INTO \"" + 资.表名 + "\" (" + 列名 + ") VALUES (" + 占位 + ")";
    }
    变量 参数JSON: 字符串 = J.转字符串(参);
    J.删除(参);

    变量 结: 字符串 = 数据库.执行参数(库, SQL, 参数JSON);
    如果 (写成了(结) == 0) {
        // 把数据库那句话原样给出来。包装成「保存失败」等于把唯一有用的信息
        // （哪个约束、哪一列）扔掉，而那正是用户能自己解决的部分
        闪现错误(状态, "存不下来：" + 库里的话(结));
        返回 0;
    }
    如果 (id > 0) { 闪现(状态, 资.单数名 + "已更新"); }
    否则 { 闪现(状态, 资.单数名 + "已创建"); }
    返回 1;
}

公开 函数 删一条(库: 整数, 资: 后台资源, id: 整数, 状态: 整数) : 整数 {
    变量 参: 整数 = J.创建数组();
    J.数组添加整数(参, id);
    变量 参数JSON: 字符串 = J.转字符串(参);
    J.删除(参);
    变量 结: 字符串 = 数据库.执行参数(库,
        "DELETE FROM \"" + 资.表名 + "\" WHERE \"" + 资.主键 + "\" = ?", 参数JSON);
    如果 (写成了(结) == 0) {
        闪现错误(状态, "删不掉：" + 库里的话(结));
        返回 0;
    }
    闪现(状态, 资.单数名 + "已删除");
    返回 1;
}

// 按 id 读一条，装进表单。给编辑屏用。
公开 函数 读进表单(库: 整数, 资: 后台资源, id: 整数) : 表单 {
    变量 参: 整数 = J.创建数组();
    J.数组添加整数(参, id);
    变量 参数JSON: 字符串 = J.转字符串(参);
    J.删除(参);
    变量 行JSON: 字符串 = 数据库.查询参数(库,
        "SELECT * FROM \"" + 资.表名 + "\" WHERE \"" + 资.主键 + "\" = ? LIMIT 1",
        参数JSON);
    变量 表值: 整数 = J.解码(行JSON);
    变量 出: 表单 = 新表单();
    如果 (表值 > 0 与 J.数组长度(表值) > 0) {
        变量 行: 整数 = J.数组获取对象(表值, 0);
        出 = 从值建表单(J.转字符串(行));
        J.删除(行);
    }
    如果 (表值 > 0) { J.删除(表值); }
    返回 出;
}

// ── 小工具 ──────────────────────────────────────────────────────

函数 写成了(结果JSON: 字符串) : 整数 {
    变量 根: 整数 = J.解码(结果JSON);
    如果 (根 <= 0) { 返回 0; }
    变量 成: 整数 = J.获取整数(根, "成功");
    J.删除(根);
    返回 成;
}

函数 库里的话(结果JSON: 字符串) : 字符串 {
    变量 根: 整数 = J.解码(结果JSON);
    如果 (根 <= 0) { 返回 "未知错误"; }
    变量 话: 字符串 = J.获取字符串(根, "错误");
    J.删除(根);
    如果 (字符串::字节长度(话) == 0) { 返回 "未知错误"; }
    返回 话;
}



公开 函数 资源后台样式() : 字符串 {
    返回 `<style>
.qi-admin-bar{display:flex; gap:8px; align-items:center; margin:10px 0}
.qi-admin-search{flex:1}
.qi-admin-search input{
  width:100%; max-width:280px; font:inherit; padding:6px 10px;
  border:1px solid currentColor; border-radius:6px; background:transparent;
  color:inherit; opacity:.85;
}
.qi-admin-form{max-width:420px}
</style>
`;
}
