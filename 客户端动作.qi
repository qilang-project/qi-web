// Qi Web - 客户端动作（对标 Phoenix JS commands）
//
// ── 它解决什么 ────────────────────────────────────────────────────
//
// 展开折叠、高亮闪一下、聚焦输入框、给某个元素派个事件 —— 这类**纯视觉**交互
// 服务端根本不需要知道。以前只有两条路：
//   · 走 data-click 往返服务端一次 —— 白跑一趟，还要等网络
//   · 自己在页面里写 JS —— 于是「不用写前端」这句话就不成立了
// 这里给一组声明式操作，写进属性，客户端当场跑完。
//
// ── 用法 ──────────────────────────────────────────────────────────
//
//   HTML {
//       <button data-js-click={动作值(切类(新动作(), "#菜单", "open"))}>菜单</button>
//       <div id="菜单" class="qi-panel" data-js-keep>…</div>
//   }
//
// 串几步就一路接下去（每个函数都是「拿一个动作，返回加了一步的动作」，
// 和 块属性 那套一个形状）：
//
//   变量 展开: 动作 = 新动作();
//   展开 = 切类(展开, "#详情", "open");
//   展开 = 切类(展开, "#箭头", "转90");
//   展开 = 聚焦(展开, "#搜索框");
//   HTML { <button data-js-click={动作值(展开)}>展开</button> }
//
// 想让服务端也知道，就在同一个元素上照常写 `data-click` —— 两件事各做各的，
// 客户端动作立刻生效，服务端那一趟该多久还是多久。
//
// ── 选择器留空 = 触发的那个元素 ───────────────────────────────────
//
//   切类(新动作(), "", "选中")      // 点谁谁加 class
//
// ── ⚠ 下一帧可能把改动冲掉 ────────────────────────────────────────
//
// 这些操作改的是 DOM，而服务端每次重渲之后 morph 会把 class / style 同步回
// **服务端渲染的版本** —— 展开的菜单会在下一帧莫名其妙合上，哪怕那一帧跟菜单
// 毫无关系（比如一个定时器滴答）。
//
// 要让改动跨帧存活，在那个元素上写 `data-js-keep`：morph 就不再管它的
// class 和 style 了。代价是服务端也改不动这两项 —— 这个元素的外观整个交给
// 客户端。真需要服务端控制的状态，还是老老实实放服务端。
//
// ── 服务端也能下发 ────────────────────────────────────────────────
//
//   实时指令(状态, 指令_动作(闪一下(新动作(), "#行7", "hit", 600)));
//
// 「保存成功之后那一行闪一下」这种，不用页面自己监听事件。
包 Web;

导入 标准库.字符串;
导入 标准库.JSON 作为 J;

// 一串客户端操作。内部是个 JSON 数组文本，形如
// [["togc","#menu","open"],["focus","#q"]]。
公开 类型 动作 {
    操作JSON: 字符串,
}

公开 函数 新动作() : 动作 {
    返回 新建 动作 { 操作JSON: "[]" };
}

// 动作 → 属性值。放进 data-js-click，或交给 指令_动作 让服务端下发。
公开 函数 动作值(动作实例: 动作) : 字符串 {
    返回 动作实例.操作JSON;
}

// 这个动作一步都没有（用来判断「要不要输出这个属性」）
公开 函数 动作为空(动作实例: 动作) : 整数 {
    如果 (字符串::等于(动作实例.操作JSON, "[]") == 1) { 返回 1; }
    返回 0;
}

// ── 内部：往操作串尾部追加一步 ──────────────────────────────────
//
// 参数个数不定，所以按需要的个数分几个小函数，各自用 J 建数组保证转义
// （选择器和 class 名都可能带引号）。

函数 追加(动作实例: 动作, 一步: 整数) : 动作 {
    变量 一步文本: 字符串 = J.转字符串(一步);
    J.删除(一步);
    变量 旧: 字符串 = 动作实例.操作JSON;
    变量 长度值: 整数 = 字符串::字节长度(旧);
    如果 (长度值 <= 2) {
        动作实例.操作JSON = "[" + 一步文本 + "]";
        返回 动作实例;
    }
    变量 里面: 字符串 = 字符串::子串(旧, 1, 长度值 - 2);
    动作实例.操作JSON = "[" + 里面 + "," + 一步文本 + "]";
    返回 动作实例;
}

函数 一步1(动作名: 字符串, 选择器: 字符串) : 整数 {
    变量 步骤: 整数 = J.创建数组();
    J.数组添加字符串(步骤, 动作名);
    J.数组添加字符串(步骤, 选择器);
    返回 步骤;
}

函数 一步2(动作名: 字符串, 选择器: 字符串, 甲: 字符串) : 整数 {
    变量 步骤: 整数 = 一步1(动作名, 选择器);
    J.数组添加字符串(步骤, 甲);
    返回 步骤;
}

函数 一步3(动作名: 字符串, 选择器: 字符串, 甲: 字符串, 乙: 字符串) : 整数 {
    变量 步骤: 整数 = 一步2(动作名, 选择器, 甲);
    J.数组添加字符串(步骤, 乙);
    返回 步骤;
}

// ── 显示 / 隐藏 ─────────────────────────────────────────────────
//
// 走内联 display，不依赖任何 CSS 类。

公开 函数 切换显隐(动作实例: 动作, 选择器: 字符串) : 动作 {
    返回 追加(动作实例, 一步1("toggle", 选择器));
}

公开 函数 显示(动作实例: 动作, 选择器: 字符串) : 动作 {
    返回 追加(动作实例, 一步1("show", 选择器));
}

公开 函数 隐藏(动作实例: 动作, 选择器: 字符串) : 动作 {
    返回 追加(动作实例, 一步1("hide", 选择器));
}

// ── class ───────────────────────────────────────────────────────
//
// 类名可以写多个，空格分开。

公开 函数 加类(动作实例: 动作, 选择器: 字符串, 类名: 字符串) : 动作 {
    返回 追加(动作实例, 一步2("addc", 选择器, 类名));
}

公开 函数 去类(动作实例: 动作, 选择器: 字符串, 类名: 字符串) : 动作 {
    返回 追加(动作实例, 一步2("rmc", 选择器, 类名));
}

公开 函数 切类(动作实例: 动作, 选择器: 字符串, 类名: 字符串) : 动作 {
    返回 追加(动作实例, 一步2("togc", 选择器, 类名));
}

// 加上类名，过 毫秒 毫秒再去掉。「保存成功那一行闪一下」就是它。
公开 函数 闪一下(动作实例: 动作, 选择器: 字符串, 类名: 字符串, 毫秒: 整数) : 动作 {
    变量 步骤: 整数 = 一步2("flash", 选择器, 类名);
    J.数组添加整数(步骤, 毫秒);
    返回 追加(动作实例, 步骤);
}

// ── 属性 ────────────────────────────────────────────────────────

公开 函数 设属性(动作实例: 动作, 选择器: 字符串, 名称: 字符串, 值: 字符串) : 动作 {
    返回 追加(动作实例, 一步3("attr", 选择器, 名称, 值));
}

公开 函数 删属性(动作实例: 动作, 选择器: 字符串, 名称: 字符串) : 动作 {
    返回 追加(动作实例, 一步2("rmattr", 选择器, 名称));
}

// ── 焦点 / 滚动 / 自定义事件 ────────────────────────────────────

公开 函数 聚焦(动作实例: 动作, 选择器: 字符串) : 动作 {
    返回 追加(动作实例, 一步1("focus", 选择器));
}

公开 函数 滚动到(动作实例: 动作, 选择器: 字符串) : 动作 {
    返回 追加(动作实例, 一步1("scroll", 选择器));
}

// 在目标元素上派发一个冒泡的 CustomEvent，detail 是解析后的 载荷JSON。
// 页面自己的脚本 / 第三方挂件用 addEventListener 接。
公开 函数 派发事件(动作实例: 动作, 选择器: 字符串, 事件名: 字符串, 载荷JSON: 字符串) : 动作 {
    返回 追加(动作实例, 一步3("dispatch", 选择器, 事件名, 载荷JSON));
}

// ── 服务端下发 ──────────────────────────────────────────────────

// 让客户端跑一串动作（对标 JS.exec）。没有「触发元素」，所以每一步都得写选择器。
公开 函数 指令_动作(动作实例: 动作) : 字符串 {
    变量 对象: 整数 = J.创建对象();
    J.设置字符串(对象, "type", "js");
    变量 操作: 整数 = J.解码(动作实例.操作JSON);
    如果 (操作 > 0) {
        J.设置对象(对象, "ops", 操作);
        J.删除(操作);
    }
    变量 文本: 字符串 = J.转字符串(对象);
    J.删除(对象);
    返回 文本;
}
