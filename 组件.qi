// qi-web 组件 —— 需要客户端配合的那几个控件，标记由这里生成，行为在
// 前端运行时里（qi-web/前端/src/），应用不用自己写 JS。
//
// 样式在 qiui.css，用 样式标签() 引入即可。
包 Web;

// ── 自定义下拉（.qdd）────────────────────────────────────────────
//
// 替掉原生 <select>：原生的选项面板在移动端会脱离控件掉到屏幕底部，CSS 还管
// 不着；这个贴着框往下弹。值由内部的 hidden input 携带，所以表单提交和实时
// 运行时的 FormData 采集都照旧。
//
// 用法：先用 下拉项(值, 文本) 拼出选项行，再交给 下拉框()。
//
//     变量 选项: HTML块 = 创建片段();
//     选项 = 块加子块(选项, 下拉项("earn", "➕ 赚积分规则"));
//     选项 = 块加子块(选项, 下拉项("spend", "➖ 扣积分规则"));
//     变量 块: HTML块 = 下拉框("kind", "earn", "➕ 赚积分规则", 选项);
//
// 交互由运行时全局委托，DOM 被 morph 重绘也不会失效，不需要重新初始化。
公开 函数 下拉项(值: 字符串, 文本: 字符串) : HTML块 {
    返回 HTML { <div class="qdd-opt" data-v={值}>{文本}</div> };
}

公开 函数 下拉框(字段名: 字符串, 当前值: 字符串, 当前文本: 字符串, 选项行: HTML块) : HTML块 {
    返回 HTML {
        <div class="qdd">
            <div class="qdd-head"><span class="qdd-txt">{当前文本}</span><span class="qdd-ar">▾</span></div>
            <input type="hidden" name={字段名} value={当前值}>
            <div class="qdd-menu">{选项行}</div>
        </div>
    };
}
