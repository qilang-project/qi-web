// Qi Web - 实时流（对标 Phoenix Streams）
//
// ── 它解决什么 ────────────────────────────────────────────────────
//
// 结构化 diff 已经让「列表改一项」只发那一项的槽位。但它有个前提：**服务端每帧
// 都得把整个列表重新渲一遍**，才能拿去和上一帧比。聊天记录、日志、通知这类
// 只增不改、能到几千条的列表，这一步本身就是负担 —— 而且服务端得一直把整份
// 列表端在手里。
//
// 流反过来：服务端**不留列表**，只说「加了这一条」「删了那一条」，客户端把它
// 落到 DOM 上。一条消息就发那一条的 HTML，跟列表里已经有多少条完全无关。
//
// ── 用法 ──────────────────────────────────────────────────────────
//
//   // 模板：容器要有 id，并且用 data-ignore 把它挡在整页 morph 之外 ——
//   // 不然下一次整页重渲会把流进去的项全抹掉（页面模板里根本没有它们）。
//   函数 渲染(状态: 整数) : HTML块 {
//       返回 HTML {
//           <div>
//               <h1>聊天</h1>
//               <ul id="msgs" data-ignore></ul>
//           </div>
//       };
//   }
//
//   函数 处理事件(状态: 整数, 事件名: 字符串, 载荷: 字符串) : 整数 {
//       如果 (字符串::等于(事件名, "发言") == 1) {
//           变量 id: 字符串 = 下一个消息id();
//           流追加(状态, "msgs", id, HTML { <li data-key={id}>{取文本(载荷)}</li> });
//           实时指令(状态, 指令_滚动("#msgs"));
//       }
//       返回 状态;
//   }
//
// 就这样 —— 状态里一条消息都不用存。
//
// ── 四个操作 ──────────────────────────────────────────────────────
//   流追加(状态, 容器id, 键, 块)   末尾加；键已存在则**原地替换**（可当更新用）
//   流前插(状态, 容器id, 键, 块)   开头加；键已存在则移到开头并替换
//   流删除(状态, 容器id, 键)       按键删掉一项
//   流清空(状态, 容器id)           整个容器清掉
//
// 键就是列表项的 `data-key`，必须是跟着数据走的稳定 id（消息 id、UUID），
// 不能用下标 —— 和 morph 的 data-key 一个道理，用下标删一条之后全体错位。
//
// ── 什么时候**不**该用流 ──────────────────────────────────────────
//
// 列表项内部的字段会跟着状态变（比如每项有个「已完成」勾选框），还是用普通的
// `对于={}` + 结构化 diff：那条路服务端知道每项长什么样，改一个字段只发一个槽位。
// 流适合「一条进来就基本不动了」的场景 —— 要改就得自己再 流追加 一次整项。
//
// ── 协议 ──────────────────────────────────────────────────────────
// 状态里挂在保留键 `__流__` 上，连接循环在渲染帧之后打包下发并清空：
//   {"streams":[{"c":"msgs","ops":[["a","m7","<li…>"],["d","m3"],["r"]]}]}
// 客户端按 data-key 在容器里对账（a=追加/替换，p=前插，d=删，r=清空）。
包 Web;

导入 标准库.字符串;
导入 标准库.JSON 作为 J;
导入 标准库.WebSocket 作为 WS;

// 往状态挂一条流操作。容器 id 和键都用 ASCII（要进 CSS 选择器和 DOM）。
函数 挂操作(状态: 整数, 容器id: 字符串, 动作: 字符串, 键: 字符串, HTML文本: 字符串) : 整数 {
    如果 (字符串::字节长度(容器id) == 0) { 抛出 "流的容器 id 不能为空"; }
    变量 队列: 整数 = 取或建队列(状态);
    变量 一条: 整数 = J.创建对象();
    J.设置字符串(一条, "c", 容器id);
    J.设置字符串(一条, "o", 动作);
    J.设置字符串(一条, "k", 键);
    J.设置字符串(一条, "h", HTML文本);
    J.数组添加对象(队列, 一条);
    J.删除(一条);
    J.设置对象(状态, "__流__", 队列);
    J.删除(队列);
    返回 1;
}

函数 取或建队列(状态: 整数) : 整数 {
    如果 (J.是否包含键(状态, "__流__") == 1) {
        变量 已有: 整数 = J.获取数组(状态, "__流__");
        如果 (已有 > 0) { 返回 已有; }
    }
    返回 J.创建数组();
}

// 末尾追加一项；键已存在则原地替换（所以「更新某条」也走这个）
公开 函数 流追加(状态: 整数, 容器id: 字符串, 键: 字符串, 块值: HTML块) : 整数 {
    如果 (字符串::字节长度(键) == 0) { 抛出 "流的项必须有稳定的键"; }
    返回 挂操作(状态, 容器id, "a", 键, 渲染块(块值));
}

// 插到开头；键已存在则移到开头并替换（新消息在最上面的时间线）
公开 函数 流前插(状态: 整数, 容器id: 字符串, 键: 字符串, 块值: HTML块) : 整数 {
    如果 (字符串::字节长度(键) == 0) { 抛出 "流的项必须有稳定的键"; }
    返回 挂操作(状态, 容器id, "p", 键, 渲染块(块值));
}

公开 函数 流删除(状态: 整数, 容器id: 字符串, 键: 字符串) : 整数 {
    如果 (字符串::字节长度(键) == 0) { 抛出 "流删除要给出键"; }
    返回 挂操作(状态, 容器id, "d", 键, "");
}

公开 函数 流清空(状态: 整数, 容器id: 字符串) : 整数 {
    返回 挂操作(状态, 容器id, "r", "", "");
}

// 状态上有待发的流操作则打包 {"streams":[…]} 下发并清空；没有返回 0。
//
// 按容器分组：同一个容器的多条操作合成一条记录，客户端只查一次 DOM。
公开 函数 发送待发流(ws句柄: 整数, 状态: 整数) : 整数 {
    变量 帧文本: 字符串 = 取待发流帧(状态);
    如果 (字符串::字节长度(帧文本) == 0) { 返回 0; }
    返回 WS::发送文本(ws句柄, 帧文本);
}

// 单独拆出来是为了能测 —— 打包是纯计算，发送才要 WS 句柄。
// 有待发操作则返回帧文本并清空队列，没有返回空串。
公开 函数 取待发流帧(状态: 整数) : 字符串 {
    如果 (J.是否包含键(状态, "__流__") == 0) { 返回 ""; }
    变量 队列: 整数 = J.获取数组(状态, "__流__");
    如果 (队列 <= 0) { 返回 ""; }
    变量 总数: 整数 = J.数组长度(队列);
    如果 (总数 == 0) { J.删除(队列); 返回 ""; }

    // 按容器分组，保持操作原始先后（前插和追加的相对顺序对结果有影响）
    变量 容器表: 整数 = J.创建数组();   // [容器id…]，用来定顺序
    变量 分组: 整数 = J.创建对象();     // 容器id → ops 数组
    变量 i: 整数 = 0;
    当 (i < 总数) {
        变量 一条: 整数 = J.数组获取对象(队列, i);
        如果 (一条 > 0) {
            变量 容器id: 字符串 = J.获取字符串(一条, "c");
            如果 (J.是否包含键(分组, 容器id) == 0) {
                J.数组添加字符串(容器表, 容器id);
                变量 空组: 整数 = J.创建数组();
                J.设置对象(分组, 容器id, 空组);
                J.删除(空组);
            }
            变量 组: 整数 = J.获取数组(分组, 容器id);
            变量 动作: 字符串 = J.获取字符串(一条, "o");
            变量 op: 整数 = J.创建数组();
            J.数组添加字符串(op, 动作);
            如果 (字符串::等于(动作, "r") == 0) {
                J.数组添加字符串(op, J.获取字符串(一条, "k"));
                如果 (字符串::等于(动作, "d") == 0) {
                    J.数组添加字符串(op, J.获取字符串(一条, "h"));
                }
            }
            J.数组添加对象(组, op);
            J.设置对象(分组, 容器id, 组);
            J.删除(op);
            J.删除(组);
            J.删除(一条);
        }
        i = i + 1;
    }
    J.删除(队列);

    变量 流表: 整数 = J.创建数组();
    变量 组数: 整数 = J.数组长度(容器表);
    变量 j: 整数 = 0;
    当 (j < 组数) {
        变量 容器id: 字符串 = J.数组获取字符串(容器表, j);
        变量 组: 整数 = J.获取数组(分组, 容器id);
        变量 记录: 整数 = J.创建对象();
        J.设置字符串(记录, "c", 容器id);
        J.设置对象(记录, "ops", 组);
        J.数组添加对象(流表, 记录);
        J.删除(记录);
        如果 (组 > 0) { J.删除(组); }
        j = j + 1;
    }
    J.删除(容器表);
    J.删除(分组);

    变量 帧对象: 整数 = J.创建对象();
    J.设置对象(帧对象, "streams", 流表);
    变量 帧文本: 字符串 = J.转字符串(帧对象);
    J.删除(流表);
    J.删除(帧对象);

    // 发过就清空：队列是「这一轮的待发」，不是历史
    变量 空队列: 整数 = J.创建数组();
    J.设置对象(状态, "__流__", 空队列);
    J.删除(空队列);
    返回 帧文本;
}
