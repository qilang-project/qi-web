// qi-web · 账户界面 —— 开箱即用的注册 / 登录 / 登出
//
// Web.账户 只有原语（生成盐/口令哈希/校验口令），页面和路由每个 app 都在重写；
// 三个小项目原先都是「输名字 + 密码，名字没见过就自动建号」—— 省事，但打错一个
// 字就悄悄多一个账号，也分不清「密码错了」和「这人不存在」。这里把注册和登录
// 分开，配上完整页面。
//
// 用法：
//   导入 Web::{账户界面配置, 创建账户界面, 建账户表, 挂载账户路由, 账户当前用户};
//   变量 账户: 账户界面配置 = 创建账户界面(库, "投票人", 会话配置(), "/vote");
//   账户 = 账户品牌(账户, "🗳️ 实时投票", "写个名字就能进。谁投了票，所有人的屏幕会立刻一起动。");
//   建账户表(账户);
//   应用值 = 挂载账户路由(应用值, 账户);
//
// 挂上的路由：
//   GET  /login      登录页          GET  /register  注册页
//   POST /api/login  登录            POST /api/register  注册
//   GET  /logout     登出
//
// 表结构约定（建账户表 会建成这样，也可以自己建、只要列名对得上）：
//   <用户表>(id INTEGER PRIMARY KEY AUTOINCREMENT, <名字列> TEXT UNIQUE,
//            密码盐 TEXT, 密码哈希 TEXT, 创建时间 TEXT)
// 应用可以另加自己的列（要允许为空，本模块 INSERT 时不会填）。
包 Web;

导入 标准库.字符串;
导入 标准库.时间 作为 时间;
导入 Web.查询 作为 查;
导入 Web.账户::{生成盐, 口令哈希, 校验口令};

公开 类型 账户界面配置 {
    库: 整数,
    用户表: 字符串,
    名字列: 字符串,
    会话: 持久会话配置,
    登录后: 字符串,
    应用名: 字符串,
    副标题: 字符串,
    名字标签: 字符串,
    主题令牌: 字符串,
    最短密码: 整数,
    // 现在还收不收新注册。每次请求问一遍，见 账户注册开关。
    准注册: 函数(): 整数,
}

// 名字列默认「昵称」，密码最短 6 位，可用下面几个函数改。
公开 函数 创建账户界面(库: 整数, 用户表: 字符串, 会话: 持久会话配置, 登录后: 字符串) : 账户界面配置 {
    返回 新建 账户界面配置 {
        库: 库,
        用户表: 用户表,
        名字列: "昵称",
        会话: 会话,
        登录后: 登录后,
        应用名: "Qi 应用",
        副标题: "",
        名字标签: "你的名字",
        主题令牌: "",
        最短密码: 6,
        准注册: 闭包(): 整数 { 返回 1; },
    };
}

// 什么时候还收新注册。默认一直收。
//
// ── 为什么是个函数不是个布尔 ────────────────────────────────────
//
// 常见的需求是「第一个人注册完就关门」—— 一个自用的应用，装好之后
// 不该再让陌生人进来。写成布尔的话这个判断只能在启动时做一次，而
// 「首次安装刚注册完、还没重启」恰好就是门最不该开着的那段时间。
//
// 传函数就能每次请求现算：
//
//   账户注册开关(配置, 闭包(): 整数 {
//       如果 (用户数() == 0) { 返回 1; }   // 还没人，放行
//       返回 0;                            // 有人了，关门
//   })
//
// 这样「装完记得关注册」这个一定会被忘掉的步骤就不存在了。
公开 函数 账户注册开关(配置值: 账户界面配置, 判断: 函数(): 整数) : 账户界面配置 {
    变量 新配置: 账户界面配置 = 配置值;
    新配置.准注册 = 判断;
    返回 新配置;
}

函数 注册已关(配置值: 账户界面配置) : 响应 {
    返回 状态响应(403, "Forbidden", "text/html; charset=utf-8",
        账户页头(配置值, "不开放注册")
        + 渲染块(HTML {
            <main class="auth">
                <h1 class="auth-brand">{配置值.应用名}</h1>
                <div class="auth-card">
                    <p class="auth-err">不开放注册</p>
                    <a class="auth-go" href="/login"
                       style="display:block;text-align:center;text-decoration:none">登录</a>
                </div>
            </main>
        })
        + "</body></html>");
}

公开 函数 账户品牌(配置值: 账户界面配置, 应用名: 字符串, 副标题: 字符串) : 账户界面配置 {
    变量 新配置: 账户界面配置 = 配置值;
    新配置.应用名 = 应用名;
    新配置.副标题 = 副标题;
    返回 新配置;
}

公开 函数 账户主题(配置值: 账户界面配置, 令牌: 字符串) : 账户界面配置 {
    变量 新配置: 账户界面配置 = 配置值;
    新配置.主题令牌 = 令牌;
    返回 新配置;
}

公开 函数 账户字段(配置值: 账户界面配置, 名字列: 字符串, 名字标签: 字符串, 最短密码: 整数) : 账户界面配置 {
    变量 新配置: 账户界面配置 = 配置值;
    新配置.名字列 = 名字列;
    新配置.名字标签 = 名字标签;
    新配置.最短密码 = 最短密码;
    返回 新配置;
}

公开 函数 建账户表(配置值: 账户界面配置) : 整数 {
    查.断言标识符(配置值.用户表);
    查.断言标识符(配置值.名字列);
    数据库.执行(配置值.库, "CREATE TABLE IF NOT EXISTS " + 配置值.用户表
        + " (id INTEGER PRIMARY KEY AUTOINCREMENT, " + 配置值.名字列
        + " TEXT UNIQUE, 密码盐 TEXT DEFAULT '', 密码哈希 TEXT DEFAULT '', 创建时间 TEXT)");
    // 老库补列：已有表加不上 UNIQUE，但把密码两列补齐，老用户下次登录就能用
    数据库.执行(配置值.库, "ALTER TABLE " + 配置值.用户表 + " ADD COLUMN 密码盐 TEXT DEFAULT ''");
    数据库.执行(配置值.库, "ALTER TABLE " + 配置值.用户表 + " ADD COLUMN 密码哈希 TEXT DEFAULT ''");
    建持久会话表(配置值.会话);
    返回 0;
}

// ── 查询 ────────────────────────────────────────────────────

公开 函数 账户按名查id(配置值: 账户界面配置, 名字: 字符串) : 整数 {
    返回 查.标量整数带参(配置值.库,
        "SELECT id FROM " + 配置值.用户表 + " WHERE " + 配置值.名字列 + " = ?",
        查.参数一串(名字), "id", 0 - 1);
}

公开 函数 账户名字(配置值: 账户界面配置, 用户id: 整数) : 字符串 {
    返回 查.标量字符串带参(配置值.库,
        "SELECT " + 配置值.名字列 + " AS n FROM " + 配置值.用户表 + " WHERE id = ?",
        查.参数一数(用户id), "n");
}

公开 函数 账户当前用户(上下文值: 上下文, 配置值: 账户界面配置) : 整数 {
    返回 当前会话主体(上下文值, 配置值.会话);
}

// ── 页面 ────────────────────────────────────────────────────

// 登录/注册页的样式**自带一份**，不走框架主题。
//
// 理由是这两页跟应用内部页面的处境不一样：它是很多人看到的第一屏，
// 而且是**唯一一屏**——上面没有导航、没有数据，只有一张卡。主题变量
// 那套是给内容页调色用的，套到这儿的结果是一张灰扑扑的默认卡片。
//
// 一切都在一个 <style> 里，选择器全部 auth- 前缀，不会跟应用样式打架。
函数 账户样式() : 字符串 {
    返回 `<style>
:root{
  --auth-ink:#17171a; --auth-muted:#6b6b73; --auth-line:#e3e3e8;
  --auth-bg:#f5f5f7; --auth-card:#fff; --auth-bad:#c0392b;
}
*{box-sizing:border-box}
body{
  margin:0; min-height:100dvh; display:flex; align-items:center; justify-content:center;
  padding:24px; background:var(--auth-bg); color:var(--auth-ink);
  font:15px/1.6 -apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;
}
.auth{width:100%; max-width:360px}
.auth-brand{font-size:26px; font-weight:650; letter-spacing:-.01em; margin:0}
.auth-sub{color:var(--auth-muted); font-size:14px; margin:6px 0 0}
.auth-card{
  background:var(--auth-card); border:1px solid var(--auth-line);
  border-radius:14px; padding:22px; margin-top:20px;
  box-shadow:0 1px 2px rgba(0,0,0,.04), 0 12px 32px rgba(0,0,0,.06);
}
/* 分段切换：两个等宽格子，选中的那个是白底浮起来的 */
.auth-seg{
  display:grid; grid-template-columns:1fr 1fr; gap:3px;
  background:var(--auth-bg); border-radius:10px; padding:3px; margin-bottom:18px;
}
.auth-seg a{
  text-align:center; padding:7px 0; border-radius:8px; font-size:14px;
  color:var(--auth-muted); text-decoration:none;
}
.auth-seg a.on{background:var(--auth-card); color:var(--auth-ink); font-weight:600;
  box-shadow:0 1px 2px rgba(0,0,0,.06)}
.auth-f{display:block; margin-bottom:12px}
.auth-f span{display:block; font-size:12px; color:var(--auth-muted); margin-bottom:5px}
.auth-f input{
  width:100%; padding:11px 12px; font-size:15px; font-family:inherit;
  color:var(--auth-ink); background:var(--auth-card);
  border:1px solid var(--auth-line); border-radius:9px; outline:none;
  transition:border-color .12s, box-shadow .12s;
}
.auth-f input:focus{border-color:var(--auth-ink); box-shadow:0 0 0 3px rgba(23,23,26,.07)}
.auth-go{
  width:100%; margin-top:6px; padding:12px; font-size:15px; font-weight:600;
  font-family:inherit; color:#fff; background:var(--auth-ink);
  border:0; border-radius:9px; cursor:pointer;
}
.auth-go:hover{opacity:.9}
.auth-go:active{transform:translateY(1px)}
.auth-err{
  margin:0 0 14px; padding:9px 12px; font-size:13px;
  color:var(--auth-bad); background:rgba(192,57,43,.07);
  border:1px solid rgba(192,57,43,.25); border-radius:9px;
}
@media (prefers-color-scheme:dark){
  :root{--auth-ink:#f2f2f4; --auth-muted:#9a9aa3; --auth-line:#333338;
        --auth-bg:#121214; --auth-card:#1c1c1f;}
  .auth-go{color:#121214}
}
</style>
`;
}

函数 账户页头(配置值: 账户界面配置, 标题: 字符串) : 字符串 {
    变量 h: 字符串 = "<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\">";
    h = h + "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">";
    h = h + "<title>" + 转义HTML(标题) + " · " + 转义HTML(配置值.应用名) + "</title>";
    h = h + 账户样式();
    // 应用给了主题令牌就仍然让它生效 —— 有人靠它换主色
    如果 (字符串::字节长度(配置值.主题令牌) > 0) {
        h = h + 主题(配置值.主题令牌);
    }
    h = h + "</head><body>";
    返回 h;
}

// 品牌 + 分段切换 + 可选错误条 + 表单
函数 账户表单壳(配置值: 账户界面配置, 当前页: 字符串, 错误: 字符串, 表单: HTML块) : HTML块 {
    变量 登录标记: 字符串 = "";
    变量 注册标记: 字符串 = "";
    如果 (字符串::等于(当前页, "login") == 1) { 登录标记 = "on"; } 否则 { 注册标记 = "on"; }

    变量 副: HTML块 = 创建片段();
    如果 (字符串::字节长度(配置值.副标题) > 0) {
        副 = HTML { <p class="auth-sub">{配置值.副标题}</p> };
    }
    变量 错误块: HTML块 = 创建片段();
    如果 (字符串::字节长度(错误) > 0) {
        错误块 = HTML { <p class="auth-err">{错误}</p> };
    }

    // 注册关掉时不摆那个页签 —— 摆一个点进去是 403 的入口比没有更气人
    变量 切换: HTML块 = 创建片段();
    如果 (配置值.准注册() == 1) {
        切换 = HTML {
            <nav class="auth-seg">
                <a class={登录标记} href="/login">登录</a>
                <a class={注册标记} href="/register">注册</a>
            </nav>
        };
    }

    返回 HTML {
        <main class="auth">
            <h1 class="auth-brand">{配置值.应用名}</h1>
            {副}
            <div class="auth-card">
                {切换}
                {错误块}
                {表单}
            </div>
        </main>
    };
}

函数 账户登录页(上下文值: 上下文, 配置值: 账户界面配置) : 响应 {
    如果 (账户当前用户(上下文值, 配置值) >= 0) {
        返回 重定向(配置值.登录后);
    }
    变量 表单: HTML块 = HTML {
        <form method="POST" action="/api/login">
            <label class="auth-f">
                <span>{配置值.名字标签}</span>
                <input name="name" required maxlength="20" autofocus autocomplete="username">
            </label>
            <label class="auth-f">
                <span>密码</span>
                <input name="password" type="password" required maxlength="64"
                       autocomplete="current-password">
            </label>
            <button type="submit" class="auth-go">登录</button>
        </form>
    };
    返回 HTML(账户页头(配置值, "登录")
        + 渲染块(账户表单壳(配置值, "login", 百分号解码(查询参数(上下文值, "err")), 表单))
        + "</body></html>");
}

函数 账户注册页(上下文值: 上下文, 配置值: 账户界面配置) : 响应 {
    如果 (配置值.准注册() == 0) { 返回 注册已关(配置值); }
    如果 (账户当前用户(上下文值, 配置值) >= 0) {
        返回 重定向(配置值.登录后);
    }
    // 最短位数写在标签里，不是提示语 —— 它是个约束，得在输入之前看见
    变量 密码标签: 字符串 = "密码（至少 " + 整数转字符串(配置值.最短密码) + " 位）";
    变量 表单: HTML块 = HTML {
        <form method="POST" action="/api/register">
            <label class="auth-f">
                <span>{配置值.名字标签}</span>
                <input name="name" required maxlength="20" autofocus autocomplete="username">
            </label>
            <label class="auth-f">
                <span>{密码标签}</span>
                <input name="password" type="password" required maxlength="64"
                       minlength={整数转字符串(配置值.最短密码)} autocomplete="new-password">
            </label>
            <label class="auth-f">
                <span>再输一遍</span>
                <input name="password2" type="password" required maxlength="64"
                       autocomplete="new-password">
            </label>
            <button type="submit" class="auth-go">注册</button>
        </form>
    };
    返回 HTML(账户页头(配置值, "注册")
        + 渲染块(账户表单壳(配置值, "register", 百分号解码(查询参数(上下文值, "err")), 表单))
        + "</body></html>");
}

// ── 处理 ────────────────────────────────────────────────────

函数 带错误(路径: 字符串, 消息: 字符串) : 响应 {
    返回 重定向(路径 + "?err=" + 百分号编码(消息));
}

函数 账户处理注册(上下文值: 上下文, 配置值: 账户界面配置) : 响应 {
    返回 账户处理注册带回调(上下文值, 配置值, 闭包(uid: 整数): 整数 { 返回 0; });
}

// 页面和处理器**各查一次**。只查页面挡不住直接 POST /api/register 的人，
// 而那正是会去试的人。
函数 账户处理注册带回调(上下文值: 上下文, 配置值: 账户界面配置,
                       注册后: 函数(整数): 整数) : 响应 {
    如果 (配置值.准注册() == 0) { 返回 注册已关(配置值); }
    变量 名字: 字符串 = 字符串::去空白(表单字段(上下文值, "name"));
    变量 密码: 字符串 = 表单字段(上下文值, "password");
    变量 密码二: 字符串 = 表单字段(上下文值, "password2");

    如果 (字符串::字节长度(名字) == 0) {
        返回 带错误("/register", "名字不能为空");
    }
    如果 (字符串::字节长度(密码) < 配置值.最短密码) {
        返回 带错误("/register", "密码至少 " + 整数转字符串(配置值.最短密码) + " 位");
    }
    如果 (字符串::等于(密码, 密码二) == 0) {
        返回 带错误("/register", "两次输入的密码不一样");
    }
    如果 (账户按名查id(配置值, 名字) >= 0) {
        返回 带错误("/register", "「" + 名字 + "」已经被用了，换一个或直接去登录");
    }

    变量 盐: 字符串 = 生成盐();
    变量 参数: 查.参数集 = 查.新参数();
    参数 = 查.加串(参数, 名字);
    参数 = 查.加串(参数, 盐);
    参数 = 查.加串(参数, 口令哈希(盐, 密码));
    参数 = 查.加串(参数, 时间.格式化本地(时间.现在(), "%Y-%m-%d %H:%M:%S"));
    查.执行参数(配置值.库, "INSERT INTO " + 配置值.用户表
        + " (" + 配置值.名字列 + ", 密码盐, 密码哈希, 创建时间) VALUES (?, ?, ?, ?)",
        查.参数文本(参数));

    变量 用户id: 整数 = 账户按名查id(配置值, 名字);
    如果 (用户id < 0) {
        返回 带错误("/register", "注册没成功，请再试一次");
    }
    注册后(用户id);
    返回 写入持久会话Cookie(重定向(配置值.登录后), 配置值.会话, 签发持久会话(配置值.会话, 用户id));
}

函数 账户处理登录(上下文值: 上下文, 配置值: 账户界面配置) : 响应 {
    变量 名字: 字符串 = 字符串::去空白(表单字段(上下文值, "name"));
    变量 密码: 字符串 = 表单字段(上下文值, "password");
    变量 用户id: 整数 = 账户按名查id(配置值, 名字);

    // 名字不存在和密码错误给同一句提示：分开说等于告诉别人哪些名字已注册
    如果 (用户id < 0 或 账户口令正确(配置值, 用户id, 密码) == 0) {
        返回 带错误("/login", "名字或密码不对");
    }
    返回 写入持久会话Cookie(重定向(配置值.登录后), 配置值.会话, 签发持久会话(配置值.会话, 用户id));
}

函数 账户口令正确(配置值: 账户界面配置, 用户id: 整数, 密码: 字符串) : 整数 {
    变量 行JSON: 字符串 = 查.查询参数(配置值.库,
        "SELECT 密码盐, 密码哈希 FROM " + 配置值.用户表 + " WHERE id = ?",
        查.参数一数(用户id));
    返回 校验口令(查.从JSON字符串(行JSON, "密码盐"),
        查.从JSON字符串(行JSON, "密码哈希"), 密码);
}

函数 账户处理登出(上下文值: 上下文, 配置值: 账户界面配置) : 响应 {
    注销当前会话(上下文值, 配置值.会话);
    返回 清除持久会话Cookie(重定向("/login"), 配置值.会话);
}

// ── 挂路由 ──────────────────────────────────────────────────

公开 函数 挂载账户路由(应用值: 应用, 配置值: 账户界面配置) : 应用 {
    返回 挂载账户路由带回调(应用值, 配置值, 闭包(uid: 整数): 整数 { 返回 0; });
}

// 注册成功后想做点什么（发欢迎邮件、放样板数据、建个人索引…）用这个。
// 回调在会话签发之前跑，拿到的是刚建好的用户 id。
公开 函数 挂载账户路由带回调(应用值: 应用, 配置值: 账户界面配置,
                              注册后: 函数(整数): 整数) : 应用 {
    变量 app: 应用 = 获取(应用值, "/login", 闭包(c: 上下文): 响应 { 返回 账户登录页(c, 配置值); });
    app = 获取(app, "/register", 闭包(c: 上下文): 响应 { 返回 账户注册页(c, 配置值); });
    app = 提交(app, "/api/login", 闭包(c: 上下文): 响应 { 返回 账户处理登录(c, 配置值); });
    app = 提交(app, "/api/register", 闭包(c: 上下文): 响应 {
        返回 账户处理注册带回调(c, 配置值, 注册后);
    });
    app = 获取(app, "/logout", 闭包(c: 上下文): 响应 { 返回 账户处理登出(c, 配置值); });
    返回 app;
}
