// qi-web · 指标 —— Prometheus 抓取端点，命名按 OpenTelemetry 语义约定。
//
// 三段：通用注册表（计数器 / 量表 / 直方图）→ HTTP 请求指标 → 口令和端点。
// HTTP 那段不是特例，只是通用层的第一个用户。
//
// ── 一份输出同时喂两边 ──────────────────────────────────────────
//
// Prometheus 直接抓 /metrics；OTel Collector 用 prometheus receiver 抓同一个口，
// 转成 OTLP 往后送。所以指标名用 OTel semconv 那套、只是把点换成下划线
// （`http.server.request.duration` → `http_server_request_duration_seconds`），
// 属性名同理 —— 这正是 Collector 自己做的转换，直接输出转换后的形态，两边都认。
//
// 不自己发 OTLP：那要 protobuf 编码和一条常驻出站连接，而抓取模式能力一样、
// 还多了「进程挂了指标不丢」和「不用配后端地址」。真要 push 用 Collector。
//
// ── 用法 ────────────────────────────────────────────────────────
//
//   指标说明("lessons_generated_total", "出好的课数");
//   计数加("lessons_generated_total", 标签("stage", "text"), 1);
//   量表设("job_queue_depth", "", 队列长度(库));
//   记录耗时("llm_call_duration_seconds", 标签("stage", "skeleton"), 耗时毫秒);
//
// 命名照 Prometheus 的规矩：计数器带 `_total`，时间用**秒**并带 `_seconds`。
// 记录耗时 收的是毫秒（qi 的 时间.现在毫秒 给的就是毫秒），输出时换算成秒 ——
// 收毫秒是为了顺手，露出去必须是基础单位，不然 PromQL 那边的 rate 全是错的。
包 Web;

导入 标准库.字符串;
导入 标准库.时间;
导入 标准库.列表 作为 列表库;
导入 标准库.哈希表 作为 表库;
导入 标准库.同步 作为 同步;
导入 标准库.操作系统 作为 系统;
导入 Web.认证::{Bearer令牌};

// 类型编号
公开 函数 类_计数器() : 整数 { 返回 0; }
公开 函数 类_量表() : 整数 { 返回 1; }
公开 函数 类_直方图() : 整数 { 返回 2; }

// 一条指标最多能长出多少条时间序列（整个进程合计）。
// 撞顶就并进 __other__ 并且让 qi_web_metric_overflow_total 涨 ——
// 悄悄丢指标比没有指标更坏。
公开 函数 系列上限() : 整数 { 返回 512; }

// ── 直方图的桶 ──────────────────────────────────────────────────
//
// 单位**秒**（Prometheus 约定用基础单位）。两组，注册指标时选一组：
//
//   桶组_快  5ms～10s   OTel 给 HTTP 服务端时延的默认建议值
//   桶组_慢  1s～30min  LLM 调用、语音合成、出图这类以秒和分钟计的活儿
//
// 本来只有一组「快」的，业务指标也共用 —— 实测立刻打脸：出一课的
// text 阶段 11.5 秒、audio 阶段 40.7 秒，**所有桶都是 0、全落进 +Inf**，
// 那张直方图除了总数什么都没告诉我。分位数全在最后一个桶里就等于没有分位数。
//
// 只给两组不给自定义：自定义是好事，代价是每个调用点都要想一次桶该怎么切，
// 而多数时候想不明白。「这活儿是毫秒级还是分钟级」倒是人人答得上来。
公开 函数 桶组_快() : 整数 { 返回 0; }
公开 函数 桶组_慢() : 整数 { 返回 1; }

公开 函数 桶数() : 整数 { 返回 11; }

函数 桶上界(桶组: 整数, 下标: 整数) : 浮点数 {
    如果 (桶组 == 桶组_慢()) { 返回 慢桶上界(下标); }
    返回 快桶上界(下标);
}

函数 桶上界文本(桶组: 整数, 下标: 整数) : 字符串 {
    如果 (桶组 == 桶组_慢()) { 返回 慢桶上界文本(下标); }
    返回 快桶上界文本(下标);
}

函数 慢桶上界(下标: 整数) : 浮点数 {
    如果 (下标 == 0) { 返回 1.0; }
    如果 (下标 == 1) { 返回 2.0; }
    如果 (下标 == 2) { 返回 5.0; }
    如果 (下标 == 3) { 返回 10.0; }
    如果 (下标 == 4) { 返回 20.0; }
    如果 (下标 == 5) { 返回 30.0; }
    如果 (下标 == 6) { 返回 60.0; }
    如果 (下标 == 7) { 返回 120.0; }
    如果 (下标 == 8) { 返回 300.0; }
    如果 (下标 == 9) { 返回 600.0; }
    返回 1800.0;
}

函数 慢桶上界文本(下标: 整数) : 字符串 {
    如果 (下标 == 0) { 返回 "1"; }
    如果 (下标 == 1) { 返回 "2"; }
    如果 (下标 == 2) { 返回 "5"; }
    如果 (下标 == 3) { 返回 "10"; }
    如果 (下标 == 4) { 返回 "20"; }
    如果 (下标 == 5) { 返回 "30"; }
    如果 (下标 == 6) { 返回 "60"; }
    如果 (下标 == 7) { 返回 "120"; }
    如果 (下标 == 8) { 返回 "300"; }
    如果 (下标 == 9) { 返回 "600"; }
    返回 "1800";
}

函数 快桶上界(下标: 整数) : 浮点数 {
    如果 (下标 == 0) { 返回 0.005; }
    如果 (下标 == 1) { 返回 0.01; }
    如果 (下标 == 2) { 返回 0.025; }
    如果 (下标 == 3) { 返回 0.05; }
    如果 (下标 == 4) { 返回 0.075; }
    如果 (下标 == 5) { 返回 0.1; }
    如果 (下标 == 6) { 返回 0.25; }
    如果 (下标 == 7) { 返回 0.5; }
    如果 (下标 == 8) { 返回 0.75; }
    如果 (下标 == 9) { 返回 1.0; }
    返回 10.0;
}

函数 快桶上界文本(下标: 整数) : 字符串 {
    如果 (下标 == 0) { 返回 "0.005"; }
    如果 (下标 == 1) { 返回 "0.01"; }
    如果 (下标 == 2) { 返回 "0.025"; }
    如果 (下标 == 3) { 返回 "0.05"; }
    如果 (下标 == 4) { 返回 "0.075"; }
    如果 (下标 == 5) { 返回 "0.1"; }
    如果 (下标 == 6) { 返回 "0.25"; }
    如果 (下标 == 7) { 返回 "0.5"; }
    如果 (下标 == 8) { 返回 "0.75"; }
    如果 (下标 == 9) { 返回 "1"; }
    返回 "10";
}

// ── 存储 ────────────────────────────────────────────────────────
//
// 两层：
//   名   一条**指标**（lessons_generated_total），带类型和一句说明
//   系列 一个 (名, 标签组合)，挂着一串原子计数器
//
// 用**原子**不用普通变量：qi-web 的请求是并发处理的，普通整数加法在竞争下
// 会丢计数。指标丢一两个不致命，但「监控自己就不准」是最不该有的毛病。

变量 名键表: 整数 = 0;      // "名" → 名下标
变量 名文本: 整数 = 0;      // 名下标 → 名
变量 名类型: 整数 = 0;      // 名下标 → 类型编号
变量 名桶组: 整数 = 0;      // 名下标 → 桶组（只对直方图有意义）
变量 名说明: 整数 = 0;      // 名 → HELP 文本（按**名**存不按下标，见 指标说明）
变量 名数: 整数 = 0;

变量 系列键表: 整数 = 0;    // "名\t标签" → 系列下标
变量 系列名下标: 整数 = 0;
变量 系列标签: 整数 = 0;
变量 系列偏移: 整数 = 0;    // 该系列在 原子池 里的起点
变量 原子池: 整数 = 0;
变量 系列数: 整数 = 0;

// 抓取前要调一遍的收集器。**从库里算出来的东西必须放这儿**，
// 不能在业务代码里定时写 gauge：抓取周期由 Prometheus 那边定，
// 业务这边定时刷新要么太勤（白查库）要么太懒（数据是陈的）。
// 对标各家客户端库的 custom collector。
变量 收集器表: 整数 = 0;
变量 收集器数: 整数 = 0;

变量 溢出原子: 整数 = 0;
变量 起始毫秒: 整数 = 0;
变量 指标就绪: 整数 = 0;
变量 注册锁: 整数 = 0;

公开 函数 初始化指标() : 整数 {
    如果 (指标就绪 == 1) { 返回 1; }
    名键表 = 表库::创建字符串表();
    名文本 = 列表库::创建字符串列表();
    名类型 = 列表库::创建整数列表();
    名桶组 = 列表库::创建整数列表();
    名说明 = 表库::创建字符串表();
    系列键表 = 表库::创建字符串表();
    系列名下标 = 列表库::创建整数列表();
    系列标签 = 列表库::创建字符串列表();
    系列偏移 = 列表库::创建整数列表();
    原子池 = 列表库::创建整数列表();
    收集器表 = 列表库::创建指针列表();
    溢出原子 = 同步::创建原子(0);
    注册锁 = 同步::创建锁();
    起始毫秒 = 时间.现在毫秒();
    指标就绪 = 1;
    返回 1;
}

// 指标名必须合法：[a-zA-Z_:][a-zA-Z0-9_:]*
//
// **一个非法名字会让整份输出解析失败** —— 那不是「少一条指标」，
// 是「监控全挂」。所以不报错、直接洗干净：非法字符换成下划线，
// 开头是数字就补一个下划线。宁可名字难看，不能让抓取炸掉。
公开 函数 洗指标名(名: 字符串) : 字符串 {
    变量 n: 整数 = 字符串::字节长度(名);
    如果 (n == 0) { 返回 "unnamed"; }
    变量 出: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 c: 字符串 = 字符串::子串(名, i, 1);
        如果 (是名字符(c) == 1) { 出 = 出 + c; }
        否则 { 出 = 出 + "_"; }
        i = i + 1;
    }
    如果 (是数字符(字符串::子串(出, 0, 1)) == 1) { 返回 "_" + 出; }
    返回 出;
}

// 字符分类走字符集查找 —— qi 的 字符串 模块没有 比较()，也就没法直接
// 判范围。查一个 64 字节的常量串够快，而且一眼能看出允许了哪些。
//
// ⚠ 空串会在任何串里「找到」（位置 0），必须先挡掉，
// 否则洗名字时会把空当成合法字符。
函数 是数字符(c: 字符串) : 整数 {
    如果 (字符串::字节长度(c) == 0) { 返回 0; }
    如果 (字符串::查找("0123456789", c) >= 0) { 返回 1; }
    返回 0;
}

函数 是名字符(c: 字符串) : 整数 {
    如果 (字符串::字节长度(c) == 0) { 返回 0; }
    如果 (字符串::查找(
        "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_:", c) >= 0) {
        返回 1;
    }
    返回 0;
}

// 标签值要转义：反斜杠、双引号、换行。一个没转义的引号会让整份输出
// 解析失败 —— 又是「监控挂掉」而不是「少一条」。
公开 函数 转义标签(值: 字符串) : 字符串 {
    变量 出: 字符串 = 字符串::替换(值, "\\", "\\\\");
    出 = 字符串::替换(出, "\"", "\\\"");
    出 = 字符串::替换(出, "\n", "\\n");
    返回 出;
}

// 拼一组标签。**用它，别自己拼字符串** —— 它负责洗键名和转义值。
公开 函数 标签(键: 字符串, 值: 字符串) : 字符串 {
    返回 洗指标名(键) + "=\"" + 转义标签(值) + "\"";
}

公开 函数 标签二(键1: 字符串, 值1: 字符串, 键2: 字符串, 值2: 字符串) : 字符串 {
    返回 标签(键1, 值1) + "," + 标签(键2, 值2);
}

公开 函数 标签三(键1: 字符串, 值1: 字符串, 键2: 字符串, 值2: 字符串,
                键3: 字符串, 值3: 字符串) : 字符串 {
    返回 标签二(键1, 值1, 键2, 值2) + "," + 标签(键3, 值3);
}

// ── 注册 ────────────────────────────────────────────────────────

// 给一条指标写 HELP。可选 —— 不写就用名字顶上，但看板上光有名字很难懂。
//
// 按**名**存不按下标：说明常常写在指标第一次被用到之前（启动时集中声明），
// 那会儿这个名字还没注册、拿不到下标。而且按名存也就顺手允许了
// 「先写说明后用」这个更自然的顺序。**它绝不创建名字** —— 创建会连类型
// 一起定死，而写说明的人未必知道这条将来是计数器还是直方图。
公开 函数 指标说明(名: 字符串, 一句话: 字符串) : 整数 {
    初始化指标();
    表库::设置字符串(名说明, 洗指标名(名), 一句话);
    返回 1;
}

// 只登记名字和类型，不建任何系列。
//
// 为的是**一次都还没发生时 /metrics 上也有 TYPE 行**：抓取方（尤其是
// 告警规则）见到「指标不存在」和「指标存在但值为 0」的反应完全不同，
// 前者往往是 no data 而不是 0，规则会静默不触发。
公开 函数 注册指标(名: 字符串, 种类: 整数) : 整数 {
    返回 注册指标带桶(名, 种类, 桶组_快());
}

// 直方图选桶组。**要在这条指标第一次被记录之前调** —— 桶组跟名字一起定死，
// 之后改不了：改了的话已经攒下的桶计数就对不上新的 le，那份直方图直接失真。
公开 函数 注册指标带桶(名: 字符串, 种类: 整数, 桶组: 整数) : 整数 {
    初始化指标();
    如果 (名下标带桶(洗指标名(名), 种类, 桶组) < 0) { 返回 0; }
    返回 1;
}

// 找到或建出一条指标名。类型只在**第一次**见到时定下 ——
// 同一个名字先当计数器又当量表是用法错误，这儿以先到的为准，不静默改型：
// 改型会让 Prometheus 那边的历史数据对不上，比拒绝更难查。
函数 名下标(名: 字符串, 种类: 整数) : 整数 {
    返回 名下标带桶(名, 种类, 桶组_快());
}

函数 名下标带桶(名: 字符串, 种类: 整数, 桶组: 整数) : 整数 {
    变量 有的: 字符串 = 表库::获取字符串(名键表, 名);
    如果 (字符串::字节长度(有的) > 0) { 返回 字符串转整数(有的); }

    同步::加锁(注册锁);
    有的 = 表库::获取字符串(名键表, 名);
    如果 (字符串::字节长度(有的) > 0) { 同步::解锁(注册锁); 返回 字符串转整数(有的); }
    变量 新: 整数 = 名数;
    列表库::添加字符串(名文本, 名);
    列表库::添加整数(名类型, 种类);
    列表库::添加整数(名桶组, 桶组);
    名数 = 名数 + 1;
    表库::设置字符串(名键表, 名, 整数转字符串(新));
    同步::解锁(注册锁);
    返回 新;
}

// 找到或建出一条系列，返回它在 原子池 里的起点；-1 表示撞了上限。
//
// ⚠ 建的时候必须加锁并**二次检查**：两条请求同时第一次撞到同一条系列会
// 各建一份，于是同一个标签出现两行 —— Prometheus 当成重复样本，整次抓取报错。
// 只有第一次会走进锁，之后全是无锁表查询，热路径不受影响。
函数 系列起点(名下标值: 整数, 标签串: 字符串, 槽数: 整数) : 整数 {
    变量 键: 字符串 = 整数转字符串(名下标值) + "\t" + 标签串;
    变量 有的: 字符串 = 表库::获取字符串(系列键表, 键);
    如果 (字符串::字节长度(有的) > 0) { 返回 字符串转整数(有的); }

    同步::加锁(注册锁);
    有的 = 表库::获取字符串(系列键表, 键);
    如果 (字符串::字节长度(有的) > 0) { 同步::解锁(注册锁); 返回 字符串转整数(有的); }
    如果 (系列数 >= 系列上限()) { 同步::解锁(注册锁); 返回 0 - 1; }

    变量 起点: 整数 = 列表库::整数列表大小(原子池);
    变量 i: 整数 = 0;
    当 (i < 槽数) {
        列表库::添加整数(原子池, 同步::创建原子(0));
        i = i + 1;
    }
    列表库::添加整数(系列名下标, 名下标值);
    列表库::添加字符串(系列标签, 标签串);
    列表库::添加整数(系列偏移, 起点);
    系列数 = 系列数 + 1;
    表库::设置字符串(系列键表, 键, 整数转字符串(起点));
    同步::解锁(注册锁);
    返回 起点;
}

函数 池加(起点: 整数, 槽: 整数, 增量: 整数) : 整数 {
    变量 句柄: 整数 = 列表库::获取整数(原子池, 起点 + 槽);
    如果 (句柄 == 0) { 返回 0; }
    同步::原子加(句柄, 增量);
    返回 1;
}

函数 池设(起点: 整数, 槽: 整数, 值: 整数) : 整数 {
    变量 句柄: 整数 = 列表库::获取整数(原子池, 起点 + 槽);
    如果 (句柄 == 0) { 返回 0; }
    同步::写原子(句柄, 值);
    返回 1;
}

函数 池读(起点: 整数, 槽: 整数) : 整数 {
    变量 句柄: 整数 = 列表库::获取整数(原子池, 起点 + 槽);
    如果 (句柄 == 0) { 返回 0; }
    返回 同步::读原子(句柄);
}

函数 起点或溢出(名: 字符串, 种类: 整数, 标签串: 字符串, 槽数: 整数) : 整数 {
    初始化指标();
    变量 n: 整数 = 名下标(洗指标名(名), 种类);
    如果 (n < 0) { 返回 0 - 1; }
    变量 起: 整数 = 系列起点(n, 标签串, 槽数);
    如果 (起 < 0) { 同步::原子加(溢出原子, 1); }
    返回 起;
}

// ── 三种指标 ────────────────────────────────────────────────────

// 只增不减。名字该带 `_total`。
公开 函数 计数加(名: 字符串, 标签串: 字符串, 增量: 整数) : 整数 {
    变量 起: 整数 = 起点或溢出(名, 类_计数器(), 标签串, 1);
    如果 (起 < 0) { 返回 0; }
    返回 池加(起, 0, 增量);
}

公开 函数 计数一(名: 字符串, 标签串: 字符串) : 整数 {
    返回 计数加(名, 标签串, 1);
}

// 可增可减的当前值：队列长度、在线连接数、缓存条目数。
公开 函数 量表设(名: 字符串, 标签串: 字符串, 值: 整数) : 整数 {
    变量 起: 整数 = 起点或溢出(名, 类_量表(), 标签串, 1);
    如果 (起 < 0) { 返回 0; }
    返回 池设(起, 0, 值);
}

公开 函数 量表加(名: 字符串, 标签串: 字符串, 增量: 整数) : 整数 {
    变量 起: 整数 = 起点或溢出(名, 类_量表(), 标签串, 1);
    如果 (起 < 0) { 返回 0; }
    返回 池加(起, 0, 增量);
}

// 收**毫秒**，露出去是**秒**。名字该带 `_seconds`。
//
// 收毫秒是因为 时间.现在毫秒() 给的就是毫秒，让调用点自己除 1000 迟早
// 有人用整数除，把 1234ms 变成 1 秒。露出去必须是基础单位，
// 否则 PromQL 里的 histogram_quantile 出来的数全是错的。
公开 函数 记录耗时(名: 字符串, 标签串: 字符串, 毫秒: 整数) : 整数 {
    初始化指标();
    变量 干净名: 字符串 = 洗指标名(名);
    变量 n: 整数 = 名下标(干净名, 类_直方图());
    如果 (n < 0) { 返回 0; }
    变量 起: 整数 = 系列起点(n, 标签串, 2 + 桶数());
    如果 (起 < 0) { 同步::原子加(溢出原子, 1); 返回 0; }

    池加(起, 0, 1);
    池加(起, 1, 毫秒);
    // 累计直方图：落进某个桶，比它大的桶也都加一 —— le 是「小于等于」，
    // 桶之间是包含关系不是互斥的。
    变量 桶组: 整数 = 列表库::获取整数(名桶组, n);
    变量 秒: 浮点数 = 整数转浮点数(毫秒) / 1000.0;
    变量 i: 整数 = 0;
    当 (i < 桶数()) {
        如果 (秒 <= 桶上界(桶组, i)) { 池加(起, 2 + i, 1); }
        i = i + 1;
    }
    返回 1;
}

// 注册一个「抓取前跑一下」的函数。里头通常是查库然后 量表设()。
//
// ⚠ 它在**处理 /metrics 请求的那条线**上同步跑 —— 慢查询会直接变成抓取超时，
// 而 Prometheus 默认 10 秒就放弃。要查库就自己做好缓存（qi-观测 那边
// 用的是 TTL：60 秒内的重复抓取直接复用上次的数）。
公开 函数 加收集器(收集: 函数()) : 整数 {
    初始化指标();
    列表库::添加指针(收集器表, 收集);
    收集器数 = 收集器数 + 1;
    返回 1;
}

函数 跑收集器() : 整数 {
    变量 i: 整数 = 0;
    当 (i < 收集器数) {
        变量 收集: 函数() = 列表库::获取指针(收集器表, i);
        // 一个收集器抛异常不该让整份输出没了 —— 那是「监控全挂」，
        // 而它本来只是一条指标的问题。
        尝试 { 收集(); } 捕获 错误 { }
        i = i + 1;
    }
    返回 1;
}

// ── 输出 ────────────────────────────────────────────────────────

函数 毫秒转秒文本(毫秒: 整数) : 字符串 {
    返回 浮点数转字符串(整数转浮点数(毫秒) / 1000.0);
}

函数 类型名(种类: 整数) : 字符串 {
    如果 (种类 == 类_量表()) { 返回 "gauge"; }
    如果 (种类 == 类_直方图()) { 返回 "histogram"; }
    返回 "counter";
}

函数 包标签(标签串: 字符串) : 字符串 {
    如果 (字符串::字节长度(标签串) == 0) { 返回 ""; }
    返回 "{" + 标签串 + "}";
}

函数 包标签加(标签串: 字符串, 追加: 字符串) : 字符串 {
    如果 (字符串::字节长度(标签串) == 0) { 返回 "{" + 追加 + "}"; }
    返回 "{" + 标签串 + "," + 追加 + "}";
}

// 一条指标的所有系列必须**连在一起**输出，中间不能插别的指标 ——
// Prometheus 见到同名指标分两段会报 "second HELP line"。
// 所以外层按「名」循环，内层扫一遍系列挑出属于它的。
//
// 这是 O(名 × 系列)。名最多十来个、系列封顶 512，抓一次几千次整数比较，
// 而抓取本来就是十几秒一次 —— 换来的是「一定连在一起」这个硬保证。
公开 函数 渲染指标() : 字符串 {
    初始化指标();
    跑收集器();
    变量 出: 字符串 = 内建指标();
    变量 n: 整数 = 0;
    当 (n < 名数) {
        出 = 出 + 渲染一个名(n);
        n = n + 1;
    }
    返回 出;
}

函数 渲染一个名(n: 整数) : 字符串 {
    变量 名: 字符串 = 列表库::获取字符串(名文本, n);
    变量 种类: 整数 = 列表库::获取整数(名类型, n);
    变量 说明: 字符串 = 表库::获取字符串(名说明, 名);
    如果 (字符串::字节长度(说明) == 0) { 说明 = 名; }

    变量 出: 字符串 = "# HELP " + 名 + " " + 一行(说明) + "\n"
        + "# TYPE " + 名 + " " + 类型名(种类) + "\n";
    变量 i: 整数 = 0;
    当 (i < 系列数) {
        如果 (列表库::获取整数(系列名下标, i) == n) {
            出 = 出 + 渲染一条(名, 种类, 列表库::获取整数(名桶组, n), i);
        }
        i = i + 1;
    }
    返回 出;
}

// HELP 里出现换行会截断这一行、后面的内容变成野样本。
函数 一行(文本: 字符串) : 字符串 {
    返回 字符串::替换(字符串::替换(文本, "\n", " "), "\r", " ");
}

函数 渲染一条(名: 字符串, 种类: 整数, 桶组: 整数, i: 整数) : 字符串 {
    变量 标签串: 字符串 = 列表库::获取字符串(系列标签, i);
    变量 起: 整数 = 列表库::获取整数(系列偏移, i);

    如果 (种类 != 类_直方图()) {
        返回 名 + 包标签(标签串) + " " + 整数转字符串(池读(起, 0)) + "\n";
    }

    变量 计数: 整数 = 池读(起, 0);
    变量 出: 字符串 = "";
    变量 b: 整数 = 0;
    当 (b < 桶数()) {
        出 = 出 + 名 + "_bucket" + 包标签加(标签串, "le=\"" + 桶上界文本(桶组, b) + "\"")
            + " " + 整数转字符串(池读(起, 2 + b)) + "\n";
        b = b + 1;
    }
    // +Inf 桶按定义等于总数，必须有，否则这份直方图非法
    出 = 出 + 名 + "_bucket" + 包标签加(标签串, "le=\"+Inf\"")
        + " " + 整数转字符串(计数) + "\n";
    出 = 出 + 名 + "_sum" + 包标签(标签串) + " "
        + 毫秒转秒文本(池读(起, 1)) + "\n";
    出 = 出 + 名 + "_count" + 包标签(标签串) + " " + 整数转字符串(计数) + "\n";
    返回 出;
}

// 指标系统**关于自己**的几条。qi_web_metric_overflow_total 不为零就说明
// 该调 系列上限() 或者有谁在制造高基数标签了。
函数 内建指标() : 字符串 {
    返回 "# HELP qi_web_uptime_seconds 进程启动至今的秒数\n"
        + "# TYPE qi_web_uptime_seconds gauge\n"
        + "qi_web_uptime_seconds " + 毫秒转秒文本(时间.现在毫秒() - 起始毫秒) + "\n"
        + "# HELP qi_web_metric_series 已经建出来的时间序列条数\n"
        + "# TYPE qi_web_metric_series gauge\n"
        + "qi_web_metric_series " + 整数转字符串(系列数) + "\n"
        + "# HELP qi_web_metric_overflow_total 因超出系列上限被丢掉的记录次数\n"
        + "# TYPE qi_web_metric_overflow_total counter\n"
        + "qi_web_metric_overflow_total " + 整数转字符串(同步::读原子(溢出原子)) + "\n";
}

// ── 谁能抓 ──────────────────────────────────────────────────────
//
// /metrics 里是**整张路由表加流量分布**：有哪些接口、各被打了多少次、
// 哪条在报 5xx、慢在哪儿；加上业务指标之后还有队列深度、生成成功率这些。
// 对着公网裸挂等于把系统结构和健康状况一起交出去。
//
// 所以**默认关**：没设 QI_METRICS_TOKEN 就连路由都不注册（跟 qi-观测 看板
// 一个规矩）。忘了配的后果是抓不到，不是被人抓光。
//
// 内网确实不需要口令的，显式写 QI_METRICS_TOKEN=public ——
// 「裸奔」应该是一个决定，不是一次遗忘。
公开 函数 指标口令() : 字符串 {
    返回 字符串::去空白(系统.获取环境变量("QI_METRICS_TOKEN"));
}

公开 函数 指标公开() : 整数 {
    如果 (字符串::等于(指标口令(), "public") == 1) { 返回 1; }
    返回 0;
}

// 只认 Authorization: Bearer。**不收 ?t=** ——
// 查询串会原样进 access log、进反向代理日志、进浏览器历史，
// 那等于把口令抄了好几份到处放。Prometheus 自己支持
// `authorization.credentials_file`，人手 curl 也就多打一个 -H。
函数 能抓吗(上下文值: 上下文) : 整数 {
    如果 (指标公开() == 1) { 返回 1; }
    变量 口令: 字符串 = 指标口令();
    如果 (字符串::字节长度(口令) == 0) { 返回 0; }
    返回 定时安全等于(Bearer令牌(上下文值), 口令);
}

// 逐字节比完再判，不提前 return。
//
// 朴素的 等于() 一遇到不同就返回，耗时正比于「前面对上了几个字节」——
// 理论上能一个字节一个字节试出口令。走网络时这点差异淹没在抖动里，
// 未必真能利用，但这是十行代码就能堵死的一整类问题。
公开 函数 定时安全等于(甲: 字符串, 乙: 字符串) : 整数 {
    变量 甲长: 整数 = 字符串::字节长度(甲);
    变量 乙长: 整数 = 字符串::字节长度(乙);
    // 长度本身藏不住（也没什么价值），先判掉，免得下面还要处理越界
    如果 (甲长 != 乙长) { 返回 0; }
    变量 差: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < 甲长) {
        如果 (字符串::等于(字符串::子串(甲, i, 1), 字符串::子串(乙, i, 1)) == 0) {
            差 = 差 + 1;
        }
        i = i + 1;
    }
    如果 (差 == 0) { 返回 1; }
    返回 0;
}


// ══ HTTP 请求指标 ══════════════════════════════════════════════
//
// 建在上面那套通用注册表之上 —— 它不是特例，只是第一个用户。
//
// ── 基数是这类东西唯一会出的大事 ────────────────────────────────
//
// 标签取的是**路由模板**（`/learn/{id}`），不是真实路径。按真实路径的话
// 一万个主题就是一万条时间序列，把 Prometheus 撑爆 —— 这事有个专门的名字
// 叫 cardinality explosion。模板从 路由.路由模式(处理器索引) 来，
// 那张登记簿是注册路由时顺手记下的。
//
// 状态码用真实码（semconv 要求），但每条路由的码就那么几个，乘出来仍然很小。


公开 函数 时延指标名() : 字符串 { 返回 "http_server_request_duration_seconds"; }
公开 函数 请求数指标名() : 字符串 { 返回 "http_server_requests_total"; }
公开 函数 在飞指标名() : 字符串 { 返回 "http_server_active_requests"; }

// 模板存的是「GET /learn/{id}」，拆成两个属性 —— semconv 里
// http.request.method 和 http.route 是分开的。
函数 模板的方法(模板: 字符串) : 字符串 {
    变量 位: 整数 = 字符串::查找(模板, " ");
    如果 (位 < 0) { 返回 "_OTHER"; }
    返回 字符串::子串(模板, 0, 位);
}

函数 模板的路由(模板: 字符串) : 字符串 {
    变量 位: 整数 = 字符串::查找(模板, " ");
    如果 (位 < 0) { 返回 模板; }
    返回 字符串::子串(模板, 位 + 1, 字符串::字节长度(模板) - 位 - 1);
}

公开 函数 记一次请求(路由模板: 字符串, 状态码: 整数, 耗时毫秒: 整数) : 整数 {
    变量 模板: 字符串 = 路由模板;
    // 没匹配上任何路由的请求也要记 —— 一堆 __unmatched__ 就是有人在扫目录，
    // 或者前端在请求一个不存在的接口。这两件事都值得看见。
    如果 (字符串::字节长度(模板) == 0) { 模板 = "__unmatched__"; }

    变量 标签串: 字符串 = 标签三(
        "http_request_method", 模板的方法(模板),
        "http_route", 模板的路由(模板),
        "http_response_status_code", 整数转字符串(状态码));

    记录耗时(时延指标名(), 标签串, 耗时毫秒);
    计数一(请求数指标名(), 标签串);
    返回 1;
}

公开 函数 指标中间件(下一步: 函数(上下文): 响应, 上下文值: 上下文) : 响应 {
    量表加(在飞指标名(), "", 1);
    变量 起: 整数 = 时间.现在毫秒();
    变量 响应值: 响应 = 下一步(上下文值);
    变量 耗: 整数 = 时间.现在毫秒() - 起;
    量表加(在飞指标名(), "", 0 - 1);

    变量 码: 整数 = 响应值.状态码;
    // 状态码 0 = handler 自己流式写完了（SSE / 分块），当 200 记 ——
    // 跟访问日志那边一个口径，不然两处数字对不上。
    如果 (码 == 0) { 码 = 200; }
    记一次请求(路由模式(上下文值.处理器索引), 码, 耗);
    返回 响应值;
}

公开 函数 使用指标(应用值: 应用) : 应用 {
    初始化指标();
    指标说明(时延指标名(), "HTTP 服务端处理时延");
    指标说明(请求数指标名(), "HTTP 请求总数");
    指标说明(在飞指标名(), "正在处理中的 HTTP 请求数");
    // 先把三条名字登记出来，这样一次请求都还没来的时候 /metrics 上也有
    // TYPE 行 —— 抓取方（尤其是告警规则）见到「指标不存在」和「值为 0」
    // 的反应完全不同：前者是 no data，规则会静默不触发。
    注册指标(时延指标名(), 类_直方图());
    注册指标(请求数指标名(), 类_计数器());
    量表设(在飞指标名(), "", 0);
    返回 使用中间件(应用值, 指标中间件);
}

// ── 端点 ────────────────────────────────────────────────────────

// Content-Type 必须是这个 —— Prometheus 按它判版本，写成 text/plain
// 也能抓，但写全了 OTel Collector 那边少一次猜。
公开 函数 指标响应() : 响应 {
    返回 新建 响应 {
        状态码: 200,
        状态文本: "OK",
        头部: "Content-Type: text/plain; version=0.0.4; charset=utf-8",
        主体: 渲染指标()
    };
}

// 口令不对一律 **404**，不是 401 —— 401 等于回答了「这儿确实有个 /metrics」，
// 而这正是扫描器想知道的第一件事。合法抓取方带着口令，拿到的是 200。
函数 指标处理器(上下文值: 上下文) : 响应 {
    如果 (能抓吗(上下文值) == 0) {
        返回 新建 响应 {
            状态码: 404,
            状态文本: "Not Found",
            头部: "Content-Type: text/plain; charset=utf-8",
            主体: "404 Not Found"
        };
    }
    返回 指标响应();
}

// 挂 /metrics 并启用 HTTP 统计。
//
// **没配口令时统计照常跑，只是不开口子** —— 线上临时想看，配上环境变量
// 重启就有，不用改代码。
公开 函数 挂指标(应用值: 应用) : 应用 {
    返回 挂指标于(应用值, "/metrics");
}

公开 函数 挂指标于(应用值: 应用, 路径: 字符串) : 应用 {
    变量 新应用: 应用 = 使用指标(应用值);
    如果 (字符串::字节长度(指标口令()) == 0) {
        打印行("· " + 路径 + " 未开放：设 QI_METRICS_TOKEN=<一串随机字符> 才会挂上"
            + "（内网确实不需要口令就写 QI_METRICS_TOKEN=public）");
        返回 新应用;
    }
    如果 (指标公开() == 1) {
        打印行("⚠ " + 路径 + " 是公开的（QI_METRICS_TOKEN=public）—— "
            + "确认这个口只有内网能到");
    }
    返回 获取(新应用, 路径, 指标处理器);
}
