// qi-web · 轻量 HTML Block
//
// 不解析新模板语法，只提供安全、可组合的字符串构建器：文本默认转义，属性值
// 默认转义；只有 块加原文 明确允许插入已经确认安全的 HTML。
包 Web.HTML块;

导入 标准库.字符串;
导入 标准库.正则;
导入 标准库.JSON 作为 J;
导入 Web.请求::{HTML转义};
导入 Web.元信息::{转义属性};

公开 类型 HTML块 {
    标签: 字符串,
    属性: 字符串,
    内容: 字符串,
    // 这个块整个来自一次 HTML{} 模板求值时，记下它的「静态计划」和「动态槽位值」。
    //
    // 用处是结构化 diff：同一个模板连续两帧，静态计划一模一样，差异**全部**落在
    // 槽位里。实时页面据此只发变化的那几个槽位（客户端拿首帧发来的计划自己重渲），
    // 而不是按字节比对整段 HTML —— 后者在列表中间插一行时基本退化成全量。
    //
    // 一旦这个块被 块加子块/块加文本 之类改过，计划就描述不了它了，两个字段清空
    // 退回全量路径。空串 = 没有模板出身。
    计划: 字符串,
    槽位JSON: 字符串,
    // 1 = 这个块是一次 `对于={项 在 表}` 循环的产物。
    //
    // 循环块的出身长得不一样：计划是**每一项**的计划（所有项共用一份，编译期常量），
    // 槽位JSON 是「每项槽位数组」的数组 —— [[项0的槽位…], [项1的槽位…], …]。
    // 这样列表改一项只需要发那一项的那个槽位，而不是整段列表 HTML。
    是循环: 整数,
}

函数 断言HTML名称(名称: 字符串) {
    如果 (正则.是否匹配("^[A-Za-z][\\p{L}\\p{N}:_-]*$", 名称) == 0) {
        抛出 "非法 HTML 标签或属性名：" + 名称;
    }
}

公开 函数 创建块(标签: 字符串) : HTML块 {
    如果 (字符串::字节长度(标签) > 0) { 断言HTML名称(标签); }
    返回 新建 HTML块 { 标签: 标签, 属性: "", 内容: "", 计划: "", 槽位JSON: "", 是循环: 0 };
}

公开 函数 创建片段() : HTML块 {
    返回 创建块("");
}

函数 是URL属性(名称: 字符串) : 整数 {
    变量 低: 字符串 = 字符串::转小写(名称);
    如果 (字符串::等于(低, "href") == 1 或 字符串::等于(低, "src") == 1
        或 字符串::等于(低, "action") == 1 或 字符串::等于(低, "formaction") == 1
        或 字符串::等于(低, "poster") == 1 或 字符串::等于(低, "cite") == 1
        或 字符串::等于(低, "xlink:href") == 1 或 字符串::等于(低, "data-href") == 1
        或 字符串::等于(低, "data-src") == 1 或 字符串::等于(低, "data-action") == 1
        或 字符串::等于(低, "data-formaction") == 1 或 字符串::等于(低, "data-poster") == 1) { 返回 1; }
    返回 0;
}

函数 断言安全URL(URL值: 字符串) {
    变量 值: 字符串 = 字符串::去空白(URL值);
    如果 (正则.是否匹配("[\\x00-\\x1F\\x7F]", 值) == 1) {
        抛出 "URL 不能包含控制字符";
    }
    如果 (正则.是否匹配("^(//|\\\\)", 值) == 1) {
        抛出 "不允许协议相对 URL：" + URL值;
    }
    变量 低: 字符串 = 字符串::转小写(值);
    如果 (正则.是否匹配("^[a-z][a-z0-9+.-]*:", 低) == 1
        与 正则.是否匹配("^(https?:|mailto:|tel:)", 低) == 0) {
        抛出 "不安全的 URL 协议：" + URL值;
    }
}

// 块被手工改过之后，原来的模板计划就对不上了 —— 清掉，退回全量路径。
函数 清模板出身(块值: HTML块) : HTML块 {
    块值.计划 = "";
    块值.槽位JSON = "";
    块值.是循环 = 0;
    返回 块值;
}

// 这个块是不是整个来自一次模板求值（能走槽位 diff）
公开 函数 块有模板(块值: HTML块) : 整数 {
    如果 (字符串::字节长度(块值.计划) > 0) { 返回 1; }
    返回 0;
}

公开 函数 块计划(块值: HTML块) : 字符串 { 返回 块值.计划; }
公开 函数 块槽位(块值: HTML块) : 字符串 { 返回 块值.槽位JSON; }

// ── 嵌套出身 ────────────────────────────────────────────────────
//
// 一个 HTML{} 里插另一个 HTML{}（`{侧栏(用户)}`）时，子块**不能**在这里就拍成
// 字符串 —— 拍平了父帧只看得见一大坨 HTML，改子块里一个字就得整坨重发。
//
// 所以子块在父模板的槽位里存成一个「信封」：
//   __QI_HTML_C__{"p":<子计划>,"s":[子槽位…],"h":"<已渲染的 HTML>"}
// p/s 给 diff 用（相邻两帧子计划相同 → 只发变化的子槽位，还能再往下套），
// h 给渲染用（父块这一处直接贴现成的 HTML，不重算）。
//
// 循环块（`对于={}`）用另一个标记，s 是「每项槽位数组」的数组：
//   __QI_HTML_L__{"p":<每项计划>,"s":[[项0…],[项1…]],"h":"<整段列表 HTML>"}
//
// 没有模板出身的块（手工 块加子块 拼的）照旧退回 __QI_HTML_H__ + 整段 HTML。
函数 __qi_html子块值(块值: HTML块) : 字符串 {
    如果 (块有模板(块值) == 0) {
        返回 "__QI_HTML_H__" + 渲染块(块值);
    }
    变量 信封: 整数 = J.创建对象();
    变量 计划对象: 整数 = J.解码(块值.计划);
    变量 槽位对象: 整数 = J.解码(块值.槽位JSON);
    // 设置对象 是**克隆**进去的，这两个临时句柄还得自己删，否则每帧漏一个
    J.设置对象(信封, "p", 计划对象);
    J.设置对象(信封, "s", 槽位对象);
    J.设置字符串(信封, "h", 渲染块(块值));
    变量 文本: 字符串 = J.转字符串(信封);
    J.删除(计划对象);
    J.删除(槽位对象);
    J.删除(信封);
    如果 (块值.是循环 == 1) {
        返回 "__QI_HTML_L__" + 文本;
    }
    返回 "__QI_HTML_C__" + 文本;
}

// ── 循环块的累加 ────────────────────────────────────────────────
//
// `对于={项 在 表}` 被编译成「建容器 → 每项塞一个 __qi_html模板(每项计划, […]) → 返回容器」。
// 关键是所有项**共用同一份编译期常量计划**，只有槽位不同 —— 正是 Phoenix
// comprehension 的形状。以前这里走 块加子块，一进去出身就被清了，整段列表塌成
// 一个槽位；现在容器自己攒住每项的槽位。

函数 __qi_html循环开始(每项计划: 字符串) : HTML块 {
    变量 块值: HTML块 = 创建片段();
    块值.计划 = 每项计划;
    块值.槽位JSON = "[]";
    块值.是循环 = 1;
    返回 块值;
}

函数 __qi_html循环加项(容器: HTML块, 项块: HTML块) : HTML块 {
    // 直接拼内容，**不走 块加子块** —— 那个会清掉容器的出身
    容器.内容 = 容器.内容 + 渲染块(项块);
    容器.槽位JSON = 数组尾插(容器.槽位JSON, 项块.槽位JSON);
    返回 容器;
}

// JSON 数组文本尾部追加一个已经是合法 JSON 的值（这里是「某一项的槽位数组」）。
// 纯字符串拼接，不解码再编码 —— 两边都是可信的框架产物，且列表长了之后
// 反复 解码/转字符串 会是 O(n²)。
函数 数组尾插(数组文本: 字符串, 元素文本: 字符串) : 字符串 {
    变量 长度值: 整数 = 字符串::字节长度(数组文本);
    如果 (长度值 < 2) { 返回 "[" + 元素文本 + "]"; }
    变量 里面: 字符串 = 字符串::子串(数组文本, 1, 长度值 - 2);
    如果 (字符串::字节长度(里面) == 0) { 返回 "[" + 元素文本 + "]"; }
    返回 "[" + 里面 + "," + 元素文本 + "]";
}

// 挂属性会改渲染结果，所以**必须**清模板出身。
//
// 以前不清：`块点击(HTML{<div>…</div>}, "加一")` 服务端渲染出
// `<div data-click="加一">`，但计划里的属性表还是空的 —— 客户端拿计划重渲得到
// 不带 data-click 的 <div>，morph 一比对就把这个属性从真实 DOM 上**抹掉**。
// 表现是「按钮点第一下好使，服务端回帧之后就再也点不动了」，控制台一声不吭。
公开 函数 块属性(块值: HTML块, 名称: 字符串, 值: 字符串) : HTML块 {
    断言可挂属性(块值, 名称);
    断言HTML名称(名称);
    变量 低: 字符串 = 字符串::转小写(名称);
    如果 (正则.是否匹配("^on", 低) == 1) {
        抛出 "不允许内联事件属性，请使用 data-* 事件：" + 名称;
    }
    如果 (字符串::等于(低, "style") == 1) {
        抛出 "动态 style 需要 CSS 上下文转义，请改用 class";
    }
    如果 (字符串::等于(低, "srcset") == 1) {
        抛出 "srcset 包含多个 URL，暂不支持动态设置";
    }
    如果 (字符串::等于(低, "srcdoc") == 1) {
        抛出 "srcdoc 是独立 HTML 上下文，暂不支持动态设置";
    }
    如果 (是URL属性(低) == 1) { 断言安全URL(值); }
    块值.属性 = 块值.属性 + " " + 名称 + "=\"" + 转义属性(值) + "\"";
    返回 清模板出身(块值);
}

// 片段（无标签）没有地方放属性，渲染时会被整个丢掉 —— 与其静默无效，不如当场报。
函数 断言可挂属性(块值: HTML块, 名称: 字符串) {
    如果 (字符串::字节长度(块值.标签) == 0) {
        抛出 "片段没有标签，挂不了属性「" + 名称 + "」：先 创建块(\"div\") 之类包一层";
    }
}

// 模板源码中的静态属性由开发者控制，允许 style 等静态内容；属性名和值仍转义。
// on* 仍拒绝，事件统一走 data-*，避免在模板语法里混入 JavaScript 上下文。
// 只给 模板节点 用：它在「盖上模板出身之前」建元素，所以既不清出身也不查片段
// （计划里的属性节点只会挂在 k=="e" 的元素上）。
函数 块静态属性(块值: HTML块, 名称: 字符串, 值: 字符串) : HTML块 {
    断言HTML名称(名称);
    变量 低: 字符串 = 字符串::转小写(名称);
    如果 (正则.是否匹配("^on", 低) == 1) {
        抛出 "HTML 模板不允许内联事件属性：" + 名称;
    }
    如果 (是URL属性(低) == 1) { 断言安全URL(值); }
    块值.属性 = 块值.属性 + " " + 名称 + "=\"" + 转义属性(值) + "\"";
    返回 块值;
}

公开 函数 块布尔属性(块值: HTML块, 名称: 字符串) : HTML块 {
    断言可挂属性(块值, 名称);
    断言HTML名称(名称);
    块值.属性 = 块值.属性 + " " + 名称;
    返回 清模板出身(块值);
}

函数 是布尔属性(名称: 字符串) : 整数 {
    变量 低: 字符串 = 字符串::转小写(名称);
    如果 (字符串::等于(低, "allowfullscreen") == 1 或 字符串::等于(低, "async") == 1
        或 字符串::等于(低, "autofocus") == 1 或 字符串::等于(低, "autoplay") == 1
        或 字符串::等于(低, "checked") == 1 或 字符串::等于(低, "controls") == 1
        或 字符串::等于(低, "default") == 1 或 字符串::等于(低, "defer") == 1
        或 字符串::等于(低, "disabled") == 1 或 字符串::等于(低, "formnovalidate") == 1
        或 字符串::等于(低, "hidden") == 1 或 字符串::等于(低, "inert") == 1
        或 字符串::等于(低, "ismap") == 1 或 字符串::等于(低, "itemscope") == 1
        或 字符串::等于(低, "loop") == 1 或 字符串::等于(低, "multiple") == 1
        或 字符串::等于(低, "muted") == 1 或 字符串::等于(低, "nomodule") == 1
        或 字符串::等于(低, "novalidate") == 1 或 字符串::等于(低, "open") == 1
        或 字符串::等于(低, "playsinline") == 1 或 字符串::等于(低, "readonly") == 1
        或 字符串::等于(低, "required") == 1 或 字符串::等于(低, "reversed") == 1
        或 字符串::等于(低, "selected") == 1) { 返回 1; }
    返回 0;
}

公开 函数 块加文本(块值: HTML块, 文本值: 字符串) : HTML块 {
    块值.内容 = 块值.内容 + HTML转义(文本值);
    返回 清模板出身(块值);
}

公开 函数 块加原文(块值: HTML块, 安全HTML: 字符串) : HTML块 {
    块值.内容 = 块值.内容 + 安全HTML;
    返回 清模板出身(块值);
}

公开 函数 块加子块(块值: HTML块, 子块: HTML块) : HTML块 {
    块值.内容 = 块值.内容 + 渲染块(子块);
    返回 清模板出身(块值);
}

公开 函数 块点击(块值: HTML块, 事件名: 字符串) : HTML块 {
    返回 块属性(块值, "data-click", 事件名);
}

公开 函数 块输入(块值: HTML块, 事件名: 字符串) : HTML块 {
    返回 块属性(块值, "data-input", 事件名);
}

公开 函数 块提交(块值: HTML块, 事件名: 字符串) : HTML块 {
    返回 块属性(块值, "data-submit", 事件名);
}

公开 函数 块事件值(块值: HTML块, 名称: 字符串, 值: 字符串) : HTML块 {
    断言HTML名称(名称);
    返回 块属性(块值, "data-value-" + 名称, 值);
}

公开 函数 块键(块值: HTML块, 键: 字符串) : HTML块 {
    返回 块属性(块值, "data-key", 键);
}

函数 __qi_html循环块(构建: 函数(): HTML块) : HTML块 {
    返回 构建();
}

函数 __qi_html渲染块组(块表: 数组<HTML块>) : 字符串 {
    变量 结果值: 字符串 = "";
    对于 块值 在 块表 {
        结果值 = 结果值 + 渲染块(块值);
    }
    返回 结果值;
}

函数 是空元素(标签: 字符串) : 整数 {
    变量 低: 字符串 = 字符串::转小写(标签);
    如果 (字符串::等于(低, "area") == 1 或 字符串::等于(低, "base") == 1
        或 字符串::等于(低, "br") == 1 或 字符串::等于(低, "col") == 1
        或 字符串::等于(低, "embed") == 1 或 字符串::等于(低, "hr") == 1
        或 字符串::等于(低, "img") == 1 或 字符串::等于(低, "input") == 1
        或 字符串::等于(低, "link") == 1 或 字符串::等于(低, "meta") == 1
        或 字符串::等于(低, "param") == 1 或 字符串::等于(低, "source") == 1
        或 字符串::等于(低, "track") == 1 或 字符串::等于(低, "wbr") == 1) { 返回 1; }
    返回 0;
}

公开 函数 渲染块(块值: HTML块) : 字符串 {
    如果 (字符串::字节长度(块值.标签) == 0) { 返回 块值.内容; }
    如果 (是空元素(块值.标签) == 1) {
        如果 (字符串::字节长度(块值.内容) > 0) { 抛出 "HTML 空元素不能包含内容：" + 块值.标签; }
        返回 "<" + 块值.标签 + 块值.属性 + ">";
    }
    返回 "<" + 块值.标签 + 块值.属性 + ">" + 块值.内容 + "</" + 块值.标签 + ">";
}

函数 模板节点(节点: 整数, 值表: 数组<字符串>) : HTML块 {
    如果 (J.是否包含键(节点, "q") == 1) {
        变量 条件索引: 整数 = J.获取整数(节点, "q");
        如果 (条件索引 < 0 或 条件索引 >= 长度(值表)) { 抛出 "HTML 模板条件索引越界"; }
        变量 条件值: 字符串 = 值表[条件索引];
        如果 (字符串::等于(条件值, "__QI_HTML_B0__") == 1) { 返回 创建片段(); }
        如果 (字符串::等于(条件值, "__QI_HTML_B1__") == 0) {
            抛出 "HTML 条件节点只接受布尔值";
        }
    }
    变量 类: 字符串 = J.获取字符串(节点, "k");
    如果 (字符串::等于(类, "t") == 1) {
        返回 块加文本(创建片段(), J.获取字符串(节点, "v"));
    }
    如果 (字符串::等于(类, "d") == 1) {
        变量 动态索引: 整数 = J.获取整数(节点, "i");
        如果 (动态索引 < 0 或 动态索引 >= 长度(值表)) { 抛出 "HTML 模板正文索引越界"; }
        变量 动态值: 字符串 = 值表[动态索引];
        如果 (字符串::字符数量(动态值) < 13) { 抛出 "HTML 正文动态值类型无效"; }
        变量 类型标记: 字符串 = 字符串::字符子串(动态值, 0, 13);
        变量 实际值: 字符串 = 字符串::字符子串(动态值, 13, 字符串::字符数量(动态值));
        如果 (字符串::等于(类型标记, "__QI_HTML_H__") == 1) {
            返回 块加原文(创建片段(), 实际值);
        }
        如果 (字符串::等于(类型标记, "__QI_HTML_T__") == 1) {
            返回 块加文本(创建片段(), 实际值);
        }
        // 子模板 / 循环信封：渲染只要现成的 h，p 和 s 是给 diff 用的
        如果 (字符串::等于(类型标记, "__QI_HTML_C__") == 1
              或 字符串::等于(类型标记, "__QI_HTML_L__") == 1) {
            返回 块加原文(创建片段(), 信封HTML(实际值));
        }
        抛出 "HTML 正文动态值类型无效";
    }

    变量 块值: HTML块 = 创建片段();
    如果 (字符串::等于(类, "e") == 1) {
        块值 = 创建块(J.获取字符串(节点, "n"));
        变量 属性表: 整数 = J.获取数组(节点, "a");
        变量 ai: 整数 = 0;
        当 (ai < J.数组长度(属性表)) {
            变量 属性: 整数 = J.数组获取对象(属性表, ai);
            变量 属性类: 字符串 = J.获取字符串(属性, "k");
            变量 名称: 字符串 = J.获取字符串(属性, "n");
            如果 (字符串::等于(属性类, "b") == 1) {
                块值 = 块布尔属性(块值, 名称);
            } 否则 如果 (字符串::等于(属性类, "s") == 1) {
                块值 = 块静态属性(块值, 名称, J.获取字符串(属性, "v"));
            } 否则 如果 (字符串::等于(属性类, "d") == 1) {
                变量 属性索引: 整数 = J.获取整数(属性, "i");
                如果 (属性索引 < 0 或 属性索引 >= 长度(值表)) { 抛出 "HTML 模板属性索引越界：" + 名称; }
                变量 动态属性: 字符串 = 值表[属性索引];
                如果 (字符串::等于(动态属性, "__QI_HTML_B1__") == 1) {
                    如果 (是布尔属性(名称) == 0) { 抛出 "HTML 属性不是布尔属性：" + 名称; }
                    块值 = 块布尔属性(块值, 名称);
                } 否则 如果 (字符串::等于(动态属性, "__QI_HTML_B0__") == 1) {
                    如果 (是布尔属性(名称) == 0) { 抛出 "HTML 属性不是布尔属性：" + 名称; }
                    // 假布尔属性不输出。
                } 否则 {
                    如果 (字符串::字符数量(动态属性) < 13) { 抛出 "HTML 动态属性值类型无效：" + 名称; }
                    变量 属性标记: 字符串 = 字符串::字符子串(动态属性, 0, 13);
                    变量 属性值: 字符串 = 字符串::字符子串(动态属性, 13, 字符串::字符数量(动态属性));
                    如果 (字符串::等于(属性标记, "__QI_HTML_S__") == 1) {
                        块值 = 块属性(块值, 名称, 属性值);
                    } 否则 {
                        抛出 "HTML 动态属性值类型无效：" + 名称;
                    }
                }
            } 否则 {
                抛出 "HTML 模板属性节点类型无效：" + 属性类;
            }
            J.删除(属性);
            ai = ai + 1;
        }
        J.删除(属性表);
    }

    变量 子表: 整数 = J.获取数组(节点, "c");
    变量 ci: 整数 = 0;
    当 (ci < J.数组长度(子表)) {
        变量 子节点: 整数 = J.数组获取对象(子表, ci);
        块值 = 块加子块(块值, 模板节点(子节点, 值表));
        J.删除(子节点);
        ci = ci + 1;
    }
    J.删除(子表);
    如果 (字符串::等于(类, "e") == 0 与 字符串::等于(类, "f") == 0) {
        抛出 "HTML 模板节点类型无效：" + 类;
    }
    返回 块值;
}

// 编译器 HTML { ... } 的内部落点。计划由编译器生成，不接受业务代码手写模板文本。
函数 __qi_html模板(计划JSON: 字符串, 值表: 数组<字符串>) : HTML块 {
    变量 根: 整数 = J.解码(计划JSON);
    如果 (根 <= 0) { 抛出 "HTML 模板计划无效"; }
    变量 块值: HTML块 = 模板节点(根, 值表);
    J.删除(根);
    // 记下出身：计划是静态的，槽位值是这一帧的动态部分。
    // 必须在 模板节点 之后打 —— 它内部用 块加子块 拼装，会一路清掉出身。
    块值.计划 = 计划JSON;
    块值.槽位JSON = 槽位转JSON(值表);
    返回 块值;
}

// ── 槽位差异（结构化 diff 的服务端一半）──────────────────────────
//
// 相邻两帧、同一个计划 → 差异全在槽位里。这里逐槽位比对，**并且会往嵌套里钻**：
//
//   槽位值一样            → 不发
//   普通值变了            → 发新值
//   子模板信封、子计划相同 → {"c": {子槽位的 parts}}      —— 只发子块里变的那几个
//   循环信封、每项计划相同 → {"l": {"n": 新项数, "i": {项号: …}}}
//                            项号 → 对象 = 那一项内部的 parts（就地改）
//                            项号 → 数组 = 那一项的完整槽位（新增，或槽位数变了）
//
// 换句话说「20 项列表改第 7 项的标题」发的是
// {"parts":{"2":{"l":{"n":20,"i":{"7":{"1":"__QI_HTML_T__新标题"}}}}}}，
// 而不是整段列表 HTML。列表中间插一行时后面每项的槽位会跟着挪位（都算「改了」），
// 但发的仍然只是槽位、不含静态结构 —— 这才是大头。
//
// 返回 parts 对象的 JSON 文本；没有差异或算不出来（槽位数对不上）返回空串，
// 调用方据此退回全量。
公开 函数 模板槽位差异(旧槽位JSON: 字符串, 新槽位JSON: 字符串) : 字符串 {
    变量 旧: 整数 = J.解码(旧槽位JSON);
    变量 新: 整数 = J.解码(新槽位JSON);
    如果 (旧 <= 0 或 新 <= 0) {
        如果 (旧 > 0) { J.删除(旧); }
        如果 (新 > 0) { J.删除(新); }
        返回 "";
    }
    变量 变化: 整数 = J.创建对象();
    变量 变化数: 整数 = 槽位差异(旧, 新, 变化);
    J.删除(旧);
    J.删除(新);
    如果 (变化数 <= 0) {
        J.删除(变化);
        返回 "";
    }
    变量 文本: 字符串 = J.转字符串(变化);
    J.删除(变化);
    返回 文本;
}

// 逐槽位比对，变化写进 变化 对象。返回变化条数；-1 = 两边槽位数不同（没法比，走全量）。
函数 槽位差异(旧数组: 整数, 新数组: 整数, 变化: 整数) : 整数 {
    变量 旧数: 整数 = J.数组长度(旧数组);
    变量 新数: 整数 = J.数组长度(新数组);
    如果 (旧数 != 新数) { 返回 0 - 1; }
    变量 变化数: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < 新数) {
        变量 旧值: 字符串 = J.数组获取字符串(旧数组, i);
        变量 新值: 字符串 = J.数组获取字符串(新数组, i);
        如果 (字符串::等于(旧值, 新值) == 0) {
            写一处差异(变化, 整数转字符串(i), 旧值, 新值);
            变化数 = 变化数 + 1;
        }
        i = i + 1;
    }
    返回 变化数;
}

函数 值标记(值: 字符串) : 字符串 {
    如果 (字符串::字符数量(值) < 13) { 返回 ""; }
    返回 字符串::字符子串(值, 0, 13);
}

函数 剥标记(值: 字符串) : 字符串 {
    返回 字符串::字符子串(值, 13, 字符串::字符数量(值));
}

// 一个槽位的差异：能钻进去就钻，钻不进去就整值替换
函数 写一处差异(变化: 整数, 键: 字符串, 旧值: 字符串, 新值: 字符串) : 整数 {
    变量 旧标记: 字符串 = 值标记(旧值);
    变量 新标记: 字符串 = 值标记(新值);
    如果 (字符串::等于(旧标记, 新标记) == 1) {
        如果 (字符串::等于(新标记, "__QI_HTML_C__") == 1) {
            变量 子: 整数 = 子模板差异(旧值, 新值);
            如果 (子 > 0) {
                J.设置对象(变化, 键, 子);
                J.删除(子);
                返回 1;
            }
        }
        如果 (字符串::等于(新标记, "__QI_HTML_L__") == 1) {
            变量 环: 整数 = 循环差异(旧值, 新值);
            如果 (环 > 0) {
                J.设置对象(变化, 键, 环);
                J.删除(环);
                返回 1;
            }
        }
    }
    J.设置字符串(变化, 键, 新值);
    返回 1;
}

// 两个信封的计划是不是同一个（换模板了就没法增量，得整块重发）
函数 计划相同(旧封: 整数, 新封: 整数) : 整数 {
    变量 旧计划: 整数 = J.获取对象(旧封, "p");
    变量 新计划: 整数 = J.获取对象(新封, "p");
    如果 (旧计划 <= 0 或 新计划 <= 0) {
        如果 (旧计划 > 0) { J.删除(旧计划); }
        如果 (新计划 > 0) { J.删除(新计划); }
        返回 0;
    }
    变量 同: 整数 = 0;
    如果 (字符串::等于(J.转字符串(旧计划), J.转字符串(新计划)) == 1) { 同 = 1; }
    J.删除(旧计划);
    J.删除(新计划);
    返回 同;
}

// 子模板：{"c": {子槽位 parts}}；不适用返回 0
函数 子模板差异(旧值: 字符串, 新值: 字符串) : 整数 {
    变量 旧封: 整数 = J.解码(剥标记(旧值));
    变量 新封: 整数 = J.解码(剥标记(新值));
    如果 (旧封 <= 0 或 新封 <= 0 或 计划相同(旧封, 新封) == 0) {
        如果 (旧封 > 0) { J.删除(旧封); }
        如果 (新封 > 0) { J.删除(新封); }
        返回 0;
    }
    变量 旧槽: 整数 = J.获取数组(旧封, "s");
    变量 新槽: 整数 = J.获取数组(新封, "s");
    变量 子变化: 整数 = J.创建对象();
    变量 条数: 整数 = 0 - 1;
    如果 (旧槽 > 0 与 新槽 > 0) { 条数 = 槽位差异(旧槽, 新槽, 子变化); }
    如果 (旧槽 > 0) { J.删除(旧槽); }
    如果 (新槽 > 0) { J.删除(新槽); }
    J.删除(旧封);
    J.删除(新封);
    如果 (条数 <= 0) {
        J.删除(子变化);
        返回 0;
    }
    变量 包装: 整数 = J.创建对象();
    J.设置对象(包装, "c", 子变化);
    J.删除(子变化);
    返回 包装;
}

// 循环：{"l": {"n": 新项数, "i": {项号: parts对象 或 完整槽位数组}}}；不适用返回 0
函数 循环差异(旧值: 字符串, 新值: 字符串) : 整数 {
    变量 旧封: 整数 = J.解码(剥标记(旧值));
    变量 新封: 整数 = J.解码(剥标记(新值));
    如果 (旧封 <= 0 或 新封 <= 0 或 计划相同(旧封, 新封) == 0) {
        如果 (旧封 > 0) { J.删除(旧封); }
        如果 (新封 > 0) { J.删除(新封); }
        返回 0;
    }
    变量 旧项表: 整数 = J.获取数组(旧封, "s");
    变量 新项表: 整数 = J.获取数组(新封, "s");
    J.删除(旧封);
    J.删除(新封);
    如果 (旧项表 <= 0 或 新项表 <= 0) {
        如果 (旧项表 > 0) { J.删除(旧项表); }
        如果 (新项表 > 0) { J.删除(新项表); }
        返回 0;
    }

    变量 旧项数: 整数 = J.数组长度(旧项表);
    变量 新项数: 整数 = J.数组长度(新项表);
    变量 项映射: 整数 = J.创建对象();
    变量 改动: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < 新项数) {
        变量 新项: 整数 = J.数组获取数组(新项表, i);
        如果 (新项 > 0) {
            如果 (i < 旧项数) {
                变量 旧项: 整数 = J.数组获取数组(旧项表, i);
                变量 项变化: 整数 = J.创建对象();
                变量 条数: 整数 = 0 - 1;
                如果 (旧项 > 0) { 条数 = 槽位差异(旧项, 新项, 项变化); }
                如果 (条数 > 0) {
                    // 就地改：只发这一项里变了的槽位
                    J.设置对象(项映射, 整数转字符串(i), 项变化);
                    改动 = 改动 + 1;
                } 否则如果 (条数 < 0) {
                    // 槽位数都对不上了（同一计划不该发生，保守起见整项换）
                    J.设置对象(项映射, 整数转字符串(i), 新项);
                    改动 = 改动 + 1;
                }
                J.删除(项变化);
                如果 (旧项 > 0) { J.删除(旧项); }
            } 否则 {
                // 新增的项：整份槽位（结构不用发，客户端有每项计划）
                J.设置对象(项映射, 整数转字符串(i), 新项);
                改动 = 改动 + 1;
            }
            J.删除(新项);
        }
        i = i + 1;
    }
    J.删除(旧项表);
    J.删除(新项表);

    // 项数变了也得发（哪怕留下的项一个字没动，客户端要按 n 截断）
    如果 (改动 == 0 与 新项数 == 旧项数) {
        J.删除(项映射);
        返回 0;
    }
    变量 环: 整数 = J.创建对象();
    J.设置整数(环, "n", 新项数);
    J.设置对象(环, "i", 项映射);
    J.删除(项映射);
    变量 包装: 整数 = J.创建对象();
    J.设置对象(包装, "l", 环);
    J.删除(环);
    返回 包装;
}

// 从子模板 / 循环信封里取出已渲染好的 HTML（"h" 字段）
函数 信封HTML(信封文本: 字符串) : 字符串 {
    变量 信封: 整数 = J.解码(信封文本);
    如果 (信封 <= 0) { 抛出 "HTML 子模板信封无效"; }
    变量 出: 字符串 = J.获取字符串(信封, "h");
    J.删除(信封);
    返回 出;
}

函数 槽位转JSON(值表: 数组<字符串>) : 字符串 {
    变量 数组对象: 整数 = J.创建数组();
    对于 值 在 值表 {
        J.数组添加字符串(数组对象, 值);
    }
    变量 文本: 字符串 = J.转字符串(数组对象);
    J.删除(数组对象);
    返回 文本;
}
