包 主程序;
导入 标准库.字符串;
导入 标准库.列表 作为 列表库;
导入 Web::{HTML块, 渲染块, 块计划, 块槽位, 模板槽位差异};

函数 徽章(数量: 整数) : HTML块 {
    返回 HTML { <span class="qi-badge">共 {整数转字符串(数量)} 项</span> };
}

函数 页(标题: 字符串, 名单: 字符串) : HTML块 {
    变量 名表: 数组<字符串> = 列表库::转字符串数组(字符串::分割(名单, ","));
    返回 HTML {
        <div class="board">
            <h1>{标题}</h1>
            <p>{徽章(长度(名表))}</p>
            <ul><li 对于={名 在 名表} data-key={名} class="qi-item"><span>{名}</span><button data-click="删" data-value-name={名}>删</button></li></ul>
        </div>
    };
}

变量 上一槽位: 字符串 = "";

函数 一步(说明: 字符串, 块值: HTML块) {
    打印行("STEP\t" + 说明);
    如果 (字符串::字节长度(上一槽位) == 0) {
        打印行("PLAN\t" + 块计划(块值));
        打印行("SLOT\t" + 块槽位(块值));
    } 否则 {
        打印行("PART\t" + 模板槽位差异(上一槽位, 块槽位(块值)));
    }
    上一槽位 = 块槽位(块值);
    打印行("HTML\t" + 渲染块(块值));
    打印行("~~~步骤结束~~~");
}

函数 入口() {
    一步("首帧", 页("看板", "甲,乙,丙,丁"));
    一步("改中间一项", 页("看板", "甲,改过的乙,丙,丁"));
    一步("末尾加一项", 页("看板", "甲,改过的乙,丙,丁,戊"));
    一步("删到只剩两项", 页("看板", "甲,改过的乙"));
    一步("只改标题", 页("新标题", "甲,改过的乙"));
    一步("开头插一项（后面全挪位）", 页("新标题", "零,甲,改过的乙"));
}
