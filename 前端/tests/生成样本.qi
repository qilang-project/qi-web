包 主程序;
导入 标准库.字符串;
导入 Web::{HTML块, 渲染块, 块计划, 块槽位, 创建片段, 块加原文};

函数 徽章(名: 字符串, 分: 整数) : HTML块 {
    返回 HTML { <span class="qi-badge"><b>{名}</b>{整数转字符串(分)}</span> };
}

函数 样例(名: 字符串, 分: 整数, 高亮: 布尔, 原文: 字符串) : HTML块 {
    返回 HTML {
        <div class="card" data-key={名}>
            <b>{名}</b> <span>{整数转字符串(分)} 分</span>
            <input type="checkbox" checked={高亮}>
            <img src="/a.png" alt={名}>
            <br>
            <p 如果={高亮}>高亮了</p>
            {块加原文(创建片段(), 原文)}
        </div>
    };
}

// 嵌套子模板 + 循环，两种新信封各来一份
函数 列表样例(标题: 字符串, 名表: 数组<字符串>, 分: 整数) : HTML块 {
    返回 HTML {
        <section>
            <h2>{标题}</h2>
            <p>徽章：{徽章(标题, 分)}</p>
            <ul><li 对于={名 在 名表} data-key={名} class="qi-item">{名}</li></ul>
        </section>
    };
}

// PLAN / SLOT 都是单行 JSON，HTML 里有真换行 —— 所以 HTML 用哨兵行收尾
函数 一行(b: HTML块) {
    打印行("PLAN\t" + 块计划(b));
    打印行("SLOT\t" + 块槽位(b));
    打印行("HTML\t" + 渲染块(b));
    打印行("~~~样本结束~~~");
}

函数 入口() {
    一行(样例("三宝", 50, 真, "<em>原文</em>"));
    一行(样例("<script>x</script>", 0, 假, "<i>i</i>"));
    一行(样例("引号\"注入", 999, 真, ""));
    一行(列表样例("排行", ["甲", "乙", "丙"], 7));
    一行(列表样例("空表", [], 0));
    一行(徽章("单独的子模板", 1));
}
