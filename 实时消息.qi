// Qi Web - 实时消息（服务端主动推：定时器 / 后台任务 / 自投消息）
//
// 对标 Phoenix LiveView 的 `handle_info` + `Process.send_after` + `start_async`。
//
// ── 它解决什么 ────────────────────────────────────────────────────
//
// 实时页面.qi 的连接循环是**纯被动**的：死等客户端事件 → 处理 → 回帧。
// 于是两类需求做不了：
//   1. 没人点也要动的页面 —— 时钟、倒计时、轮询进度、自动刷新
//   2. 慢活儿 —— 点一下要问 AI（3 秒）。放在 事件处理函数 里，这 3 秒整条连接
//      都卡着，连「正在思考…」都发不出去，用户看到的是页面死了
//
// 这里给每条连接配一个**邮箱**，并把连接循环从「死等客户端」改成
// 「等一小会儿客户端 → 抽干邮箱 → 再等一小会儿」。任何线程都能往邮箱投消息，
// 循环收到就走 消息处理函数，然后和普通事件一样重渲染下发。
//
// ── 三个用户函数变四个 ────────────────────────────────────────────
//   初始状态函数() : 整数
//   渲染函数(状态) : 字符串
//   事件处理函数(状态, 事件名, 载荷JSON) : 整数        —— 客户端来的
//   消息处理函数(状态, 消息名, 载荷JSON) : 整数        —— 服务端自己来的（新）
// 两个处理函数签名一模一样，返回新/同状态句柄。
//
// ── 用法 ──────────────────────────────────────────────────────────
//
//   应用值 = 实时路由带消息(应用值, "/clock", 初始状态, 渲染, 处理事件, 处理消息);
//
//   函数 处理消息(状态: 整数, 消息名: 字符串, 载荷: 字符串) : 整数 {
//       如果 (字符串::等于(消息名, "__上线__") == 1) {
//           实时定时(状态, 1000, "滴答", "{}");        // 开表
//       }
//       如果 (字符串::等于(消息名, "滴答") == 1) {
//           J.设置整数(状态, "秒", J.获取整数(状态, "秒") + 1);
//           实时定时(状态, 1000, "滴答", "{}");        // 自己续下一拍
//       }
//       返回 状态;
//   }
//
// 慢活儿（AI、外部 HTTP）：事件处理里立刻把状态改成「思考中」并返回 ——
// 那一帧马上就发出去了 —— 真正的活在后台跑，出结果再进邮箱：
//
//   函数 处理事件(状态: 整数, 事件名: 字符串, 载荷: 字符串) : 整数 {
//       如果 (字符串::等于(事件名, "提问") == 1) {
//           J.设置整数(状态, "思考中", 1);
//           变量 问题: 字符串 = 取载荷字段(载荷, "text");
//           实时异步(状态, "回答", 闭包(): 字符串 { 返回 问大模型(问题); });
//       }
//       返回 状态;
//   }
//
// ── 保留消息名 ────────────────────────────────────────────────────
//   __上线__   连接建好、首帧已发之后立刻投一条。在这里开定时器 / 起后台任务
//              （初始状态函数 里还没有邮箱，开不了）。
//
// ── 状态里的保留键 ────────────────────────────────────────────────
//   "__邮箱__"  本连接的邮箱句柄，由框架写入。渲染函数不要用这个键。
//   事件/消息处理函数返回**新**状态句柄也没关系，框架每次都会重新盖上这个键。
//
// ── 生命周期 ──────────────────────────────────────────────────────
// 邮箱随连接生随连接灭。连接断开时邮箱关闭，之后所有投递（包括还在排队的
// 定时器）返回 0 并被丢弃 —— 邮箱句柄单调递增永不复用，迟到的定时器绝不会
// 打进后来那条连接的邮箱。所以「页面关了，定时器还在跑」这种事不会发生。
//
// ── 代价 ──────────────────────────────────────────────────────────
// 带消息的连接循环每 100ms 醒一次查邮箱（不带消息的路由仍是纯阻塞，零开销）。
// 也就是说定时消息最坏迟 100ms 到，够用且几乎不耗 CPU。
// 真正的 select(socket, 邮箱) 需要往运行时塞 eventfd/pipe 唤醒通道，
// 收益（省下每秒 10 次空转）撑不起那份复杂度，先不做。
//
// ── 跨连接推送不在这里 ────────────────────────────────────────────
// 这份是**每连接**的。要「一个人操作，同 topic 所有人都更新」用 实时广播.qi 的
// 频道广播 / 频道指令 —— 那条路服务端任意 goroutine 直接推，不经邮箱。
包 Web;

导入 标准库.字符串;
导入 标准库.WebSocket 作为 WS;
导入 标准库.JSON 作为 J;
导入 标准库.邮箱 作为 邮箱库;

// 连接循环等客户端的单次时限（毫秒）。超时就去查邮箱，然后回来接着等。
// 调小 = 定时消息更准、空转更多；调大 = 反之。100ms 是「人眼看不出延迟」和
// 「每秒 10 次空转」之间的折中。
函数 消息轮询毫秒() : 整数 {
    返回 100;
}

// ── 给业务代码用的 API ──────────────────────────────────────────

// 取本连接的邮箱句柄；0 = 这条路由没开消息（用的是不带消息的 实时路由_*）
公开 函数 实时邮箱(状态: 整数) : 整数 {
    如果 (J.是否包含键(状态, "__邮箱__") == 0) {
        返回 0;
    }
    返回 J.获取整数(状态, "__邮箱__");
}

// 立刻给自己投一条消息（下一轮循环就会被 消息处理函数 收到）。
// 用来把一件事拆成几拍：处理完这拍，投下一拍，中间那帧先发出去。
公开 函数 实时自投(状态: 整数, 消息名: 字符串, 载荷JSON: 字符串) : 整数 {
    变量 邮箱句柄: 整数 = 实时邮箱(状态);
    如果 (邮箱句柄 == 0) { 返回 0; }
    返回 邮箱库::投递(邮箱句柄, 消息名, 载荷JSON);
}

// 延迟 毫秒 后给自己投一条消息（对标 Process.send_after）。
// 要周期性的就在收到时再定一次 —— 显式续拍比隐式重复好debug，
// 而且页面进了「不需要再动」的状态就自然停了，不用管取消。
公开 函数 实时定时(状态: 整数, 延迟毫秒: 整数, 消息名: 字符串, 载荷JSON: 字符串) : 整数 {
    变量 邮箱句柄: 整数 = 实时邮箱(状态);
    如果 (邮箱句柄 == 0) { 返回 0; }
    返回 邮箱库::定时投递(邮箱句柄, 延迟毫秒, 消息名, 载荷JSON);
}

// 后台跑一件慢活儿，跑完把返回值当载荷投进邮箱（对标 start_async）。
//
// 调用后**立即返回**，本轮渲染帧照常发出去 —— 这就是「先显示正在思考…」的做法。
// 任务函数在另一个协程里跑，**不要在里面碰状态句柄**（状态归连接循环独有），
// 要什么值先在闭包外取出来捕获进去。
公开 函数 实时异步(状态: 整数, 消息名: 字符串, 任务函数: 函数(): 字符串) : 整数 {
    变量 邮箱句柄: 整数 = 实时邮箱(状态);
    如果 (邮箱句柄 == 0) { 返回 0; }
    启动 跑异步任务(邮箱句柄, 消息名, 任务函数);
    返回 1;
}

// 任务函数抛异常时投的载荷；用 异步错误() 判断。
//
// 必须投点什么出去：不投的话页面就永远停在「正在思考…」，
// 而且是最难查的那种 —— 没有报错，只是不动了。
函数 跑异步任务(邮箱句柄: 整数, 消息名: 字符串, 任务函数: 函数(): 字符串) : 整数 {
    变量 结果值: 字符串 = "";
    变量 出错: 字符串 = "";
    尝试 {
        结果值 = 任务函数();
    } 捕获 错误 {
        出错 = 错误;
    }
    如果 (字符串::字节长度(出错) > 0) {
        变量 错误对象: 整数 = J.创建对象();
        J.设置字符串(错误对象, "错误", 出错);
        变量 文本: 字符串 = J.转字符串(错误对象);
        J.删除(错误对象);
        返回 邮箱库::投递(邮箱句柄, 消息名, 文本);
    }
    返回 邮箱库::投递(邮箱句柄, 消息名, 结果值);
}

// 异步任务的载荷是不是「出错了」；是则返回错误文本，不是返回空串。
//
// 只有载荷恰好是 {"错误": "..."} 才算错 —— 任务正常返回的文本
// （哪怕不是 JSON）都会老老实实返回空串。
公开 函数 异步错误(载荷JSON: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(载荷JSON);
    如果 (对象 <= 0) { 返回 ""; }
    变量 文本: 字符串 = "";
    如果 (J.是否包含键(对象, "错误") == 1) {
        文本 = J.获取字符串(对象, "错误");
    }
    J.删除(对象);
    返回 文本;
}

// ── 注册带消息的实时路由 ────────────────────────────────────────

// 字符串渲染版
公开 函数 实时路由带消息(应用值: 应用, 路径: 字符串,
                        初始状态函数: 函数(): 整数,
                        渲染函数: 函数(整数): 字符串,
                        事件处理函数: 函数(整数, 字符串, 字符串): 整数,
                        消息处理函数: 函数(整数, 字符串, 字符串): 整数) : 应用 {
    变量 ws路径: 字符串 = 实时WS路径(路径);
    变量 页面处理器: 函数(上下文): 响应 = 闭包(上下文值: 上下文): 响应 {
        变量 首屏状态: 整数 = 初始状态函数();
        变量 初始片段: 字符串 = 安全首屏(渲染函数, 首屏状态);
        J.删除(首屏状态);
        返回 HTML(实时页面布局("Qi 实时页面", ws路径, 初始片段));
    };
    应用值 = 获取(应用值, 路径, 页面处理器);
    变量 ws处理器: 函数(整数): 整数 = 闭包(ws句柄: 整数): 整数 {
        返回 消息连接循环(ws句柄, 初始状态函数, 渲染函数, 事件处理函数, 消息处理函数);
    };
    返回 WS路由(应用值, ws路径, ws处理器);
}

// HTML块 渲染版：多一层结构化 diff（同模板的相邻两帧只发变化的槽位）
公开 函数 实时块路由带消息(应用值: 应用, 路径: 字符串,
                          初始状态函数: 函数(): 整数,
                          块渲染函数: 函数(整数): HTML块,
                          事件处理函数: 函数(整数, 字符串, 字符串): 整数,
                          消息处理函数: 函数(整数, 字符串, 字符串): 整数) : 应用 {
    变量 渲染函数: 函数(整数): 字符串 = 闭包(状态: 整数): 字符串 {
        返回 安全首屏块(块渲染函数, 状态);
    };
    返回 实时路由带消息(应用值, 路径, 初始状态函数, 渲染函数, 事件处理函数, 消息处理函数);
}

// 只挂 WS 端点，页面外壳自己写（和 实时WS路由带准入 一个分工）
公开 函数 实时WS路由带消息(应用值: 应用, ws路径: 字符串,
                          初始状态函数: 函数(): 整数,
                          渲染函数: 函数(整数): 字符串,
                          事件处理函数: 函数(整数, 字符串, 字符串): 整数,
                          消息处理函数: 函数(整数, 字符串, 字符串): 整数) : 应用 {
    变量 ws处理器: 函数(整数): 整数 = 闭包(ws句柄: 整数): 整数 {
        返回 消息连接循环(ws句柄, 初始状态函数, 渲染函数, 事件处理函数, 消息处理函数);
    };
    返回 WS路由(应用值, ws路径, ws处理器);
}

// ── 连接循环 ────────────────────────────────────────────────────

// 和 实时页面.qi 的 实时事件循环 同构，差别只在两处：
//   1. 等客户端用 接收文本超时，超时就去抽邮箱（这是全部的意义所在）
//   2. 每次处理函数返回后重新盖上 "__邮箱__" 键（处理函数可以换状态句柄）
函数 消息连接循环(ws句柄: 整数,
                初始状态函数: 函数(): 整数,
                渲染函数: 函数(整数): 字符串,
                事件处理函数: 函数(整数, 字符串, 字符串): 整数,
                消息处理函数: 函数(整数, 字符串, 字符串): 整数) : 整数 {
    返回 消息事件循环(ws句柄, 初始状态函数(), 渲染函数, 事件处理函数, 消息处理函数);
}

// 带准入的版本：首帧必须是 __订阅__，载荷交给 准入函数 换一个「身份」字符串，
// 换不出来（空串）就是没登录/会话过期 → 明确告知再断开。
//
// **必须发拒绝帧再断**，不能静默 return：客户端只看到断线会一直指数退避重连，
// 页面永远停在「正在打开…」占位符上，用户根本不知道是登录失效了。
// （实时页面.qi 的 实时准入连接循环 也是这么处理的，同一个道理。）
//
// 订阅载荷是**服务端渲染首屏时烤进 window.QI_LIVE.sub 的**，客户端只负责回传。
// 所以「读 cookie 认人」发生在那次普通 GET 里，这儿只验它给的凭据。
函数 消息准入连接循环(ws句柄: 整数,
                    准入函数: 函数(字符串): 字符串,
                    初始状态函数: 函数(字符串): 整数,
                    渲染函数: 函数(整数): 字符串,
                    事件处理函数: 函数(整数, 字符串, 字符串): 整数,
                    消息处理函数: 函数(整数, 字符串, 字符串): 整数) : 整数 {
    变量 首帧: 字符串 = WS::接收文本(ws句柄);
    如果 (字符串::字节长度(首帧) == 0) { 返回 0; }

    变量 是订阅: 整数 = 0;
    变量 订阅载荷: 字符串 = "{}";
    变量 首帧对象: 整数 = J.解码(首帧);
    如果 (首帧对象 > 0) {
        如果 (字符串::等于(J.获取字符串(首帧对象, "event"), "__订阅__") == 1) {
            是订阅 = 1;
            如果 (J.是否包含键(首帧对象, "payload") == 1) {
                变量 载荷对象: 整数 = J.获取对象(首帧对象, "payload");
                如果 (载荷对象 > 0) {
                    订阅载荷 = J.转字符串(载荷对象);
                    J.删除(载荷对象);
                }
            }
        }
        J.删除(首帧对象);
    }
    如果 (是订阅 == 0) { 返回 0; }

    变量 身份: 字符串 = 准入函数(订阅载荷);
    如果 (字符串::字节长度(身份) == 0) {
        发送拒绝(ws句柄, "登录已失效，请重新登录");
        返回 0;
    }
    返回 消息事件循环(ws句柄, 初始状态函数(身份), 渲染函数, 事件处理函数, 消息处理函数);
}

// 两条路（带准入 / 不带）共用的那个循环。状态由调用方备好传进来 ——
// 差别只在「状态怎么来」，邮箱、首帧、抽干邮箱、收尾清理全是一样的。
函数 消息事件循环(ws句柄: 整数,
                状态入: 整数,
                渲染函数: 函数(整数): 字符串,
                事件处理函数: 函数(整数, 字符串, 字符串): 整数,
                消息处理函数: 函数(整数, 字符串, 字符串): 整数) : 整数 {
    变量 状态: 整数 = 状态入;
    变量 邮箱句柄: 整数 = 邮箱库::创建();
    J.设置整数(状态, "__邮箱__", 邮箱句柄);

    变量 上一帧: 字符串 = 渲染函数(状态);
    实时发送整区(ws句柄, 上一帧);
    发送帧尾(ws句柄, 状态, 1);

    // 首帧已经在客户端了，这时才让业务有机会开定时器 / 起后台任务。
    // 放在这里而不是 初始状态函数 里，是因为那时邮箱还不存在。
    邮箱库::投递(邮箱句柄, "__上线__", "{}");

    变量 继续循环: 整数 = 1;
    当 (继续循环 == 1) {
        变量 消息: 字符串 = WS::接收文本超时(ws句柄, 消息轮询毫秒());
        如果 (字符串::字节长度(消息) > 0) {
            变量 事件名: 字符串 = 帧事件名(消息);
            如果 (字符串::字节长度(事件名) > 0) {
                状态 = 事件处理函数(状态, 事件名, 帧载荷(消息));
                J.设置整数(状态, "__邮箱__", 邮箱句柄);
                上一帧 = 推一帧(ws句柄, 上一帧, 渲染函数(状态), 状态);
            }
        } 否则 {
            // 空串：超时（连接还在）或对端断了 —— 用 已连接 区分
            如果 (WS::已连接(ws句柄) == 0) {
                继续循环 = 0;
            }
        }

        // 抽干邮箱。一轮里可能积了好几条（比如定时器和异步结果撞一起），
        // 每条各自处理并各自发帧 —— 合并成一帧会吞掉中间态。
        如果 (继续循环 == 1) {
            变量 还有: 整数 = 1;
            当 (还有 == 1) {
                变量 信: 字符串 = 邮箱库::取出(邮箱句柄);
                如果 (字符串::字节长度(信) == 0) {
                    还有 = 0;
                } 否则 {
                    变量 信对象: 整数 = J.解码(信);
                    如果 (信对象 > 0) {
                        变量 消息名: 字符串 = J.获取字符串(信对象, "m");
                        变量 载荷: 字符串 = J.获取字符串(信对象, "p");
                        J.删除(信对象);
                        状态 = 消息处理函数(状态, 消息名, 载荷);
                        J.设置整数(状态, "__邮箱__", 邮箱句柄);
                        上一帧 = 推一帧(ws句柄, 上一帧, 渲染函数(状态), 状态);
                    }
                }
            }
        }
    }

    // 先关邮箱再释放状态：关掉之后所有迟到的定时器投递都变成 no-op
    邮箱库::关闭(邮箱句柄);
    // 连接没了就把没传完的临时文件清掉 —— 不清的话用户关个标签页就留一个 .part
    上传连接结束(状态);
    J.删除(状态);
    返回 0;
}

// 发一帧（走增量 diff）+ 指令 / 流 / 兜底 ACK；返回新的「上一帧」
函数 推一帧(ws句柄: 整数, 上一帧: 字符串, 新帧: 字符串, 状态: 整数) : 字符串 {
    发送帧尾(ws句柄, 状态, 实时发送增量(ws句柄, 上一帧, 新帧));
    返回 新帧;
}

// 一帧文本 → 业务事件名；心跳/订阅/解析失败都返回空串（不当业务事件派发）
函数 帧事件名(帧文本: 字符串) : 字符串 {
    变量 帧对象: 整数 = J.解码(帧文本);
    如果 (帧对象 <= 0) { 返回 ""; }
    变量 事件名: 字符串 = J.获取字符串(帧对象, "event");
    J.删除(帧对象);
    如果 (字符串::等于(事件名, "__心跳__") == 1) { 返回 ""; }
    如果 (字符串::等于(事件名, "__订阅__") == 1) { 返回 ""; }
    返回 事件名;
}

// 一帧文本 → payload 子对象的 JSON 文本；没有就是 "{}"
函数 帧载荷(帧文本: 字符串) : 字符串 {
    变量 帧对象: 整数 = J.解码(帧文本);
    如果 (帧对象 <= 0) { 返回 "{}"; }
    变量 载荷串: 字符串 = "{}";
    如果 (J.是否包含键(帧对象, "payload") == 1) {
        变量 载荷对象: 整数 = J.获取对象(帧对象, "payload");
        如果 (载荷对象 > 0) {
            载荷串 = J.转字符串(载荷对象);
        }
    }
    J.删除(帧对象);
    返回 载荷串;
}
