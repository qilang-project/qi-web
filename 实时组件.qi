// Qi Web - 实时组件（对标 Phoenix LiveComponent）
//
// ── 它解决什么 ────────────────────────────────────────────────────
//
// 页面一大，`事件处理函数` 就变成一条几十个分支的 if 链，`初始状态函数` 里
// 各个部件的键混在一个平铺的 JSON 对象里，改一处要通读全部。组件把这两件事
// 按部件切开：**自己的状态、自己的事件处理、自己的模板**。
//
// 「只重渲这棵子树」这件事**不用组件也已经成立** —— 结构化 diff 会算出没变的
// 子块一个字节都不发（见 HTML块.qi 的嵌套出身）。组件补的是另外两样：
// 状态隔离和事件路由。
//
// ── 用法 ──────────────────────────────────────────────────────────
//
//   函数 计数器初始() : 整数 {
//       变量 s: 整数 = J.创建对象(); J.设置整数(s, "n", 0); 返回 s;
//   }
//   函数 计数器渲染(s: 整数) : HTML块 {
//       返回 HTML { <button data-click="加">{整数转字符串(J.获取整数(s,"n"))}</button> };
//   }
//   函数 计数器处理(s: 整数, 事件名: 字符串, 载荷: 字符串) : 整数 {
//       如果 (字符串::等于(事件名, "加") == 1) { J.设置整数(s, "n", J.获取整数(s,"n") + 1); }
//       返回 s;
//   }
//   函数 计数器() : 实时组件 { 返回 创建组件("counter", 计数器初始, 计数器渲染, 计数器处理); }
//
//   // 页面模板里插一个（组件内部的事件自动路由给它，不经过页面）
//   函数 渲染(状态: 整数) : HTML块 {
//       返回 HTML { <div><h1>首页</h1>{渲染组件(状态, 计数器())}</div> };
//   }
//
//   // 页面的事件处理开头先让组件挑走属于它们的
//   函数 处理事件(状态: 整数, 事件名: 字符串, 载荷: 字符串) : 整数 {
//       如果 (组件事件(状态, 计数器(), 事件名, 载荷) == 1) { 返回 状态; }
//       …页面自己的事件…
//       返回 状态;
//   }
//
// ── 路由是怎么做到的 ──────────────────────────────────────────────
//
// 渲染组件 给子树套一层 `<div data-target="组件id">`。客户端上行事件时会往上
// 找最近的 `[data-target]`，把它的值放进载荷的保留键 `__target__`。
// 组件事件 只认 `__target__` 等于自己 id 的事件 —— 所以页面和组件用同名事件
// （两处都叫「删除」）也不会串。
//
// ── 状态放在哪 ────────────────────────────────────────────────────
//
// 页面状态里的保留键 `__组件__<id>`，值是该组件自己的 JSON 对象句柄。
// 首次 渲染组件 / 组件事件 时按 初始函数 建好。页面状态被释放时一起释放
// （J 的句柄树随根对象走）。
//
// ⚠ 组件 id 用 ASCII，和 CSS 选择器/DOM id 一个口径。
包 Web;

导入 标准库.字符串;
导入 标准库.JSON 作为 J;

公开 类型 实时组件 {
    id: 字符串,
    初始: 函数(): 整数,
    渲染: 函数(整数): HTML块,
    处理: 函数(整数, 字符串, 字符串): 整数,
}

公开 函数 创建组件(id: 字符串, 初始函数: 函数(): 整数,
                  渲染函数: 函数(整数): HTML块,
                  处理函数: 函数(整数, 字符串, 字符串): 整数) : 实时组件 {
    如果 (字符串::字节长度(id) == 0) { 抛出 "组件 id 不能为空"; }
    返回 新建 实时组件 { id: id, 初始: 初始函数, 渲染: 渲染函数, 处理: 处理函数 };
}

函数 组件键(id: 字符串) : 字符串 {
    返回 "__组件__" + id;
}

// 取这个组件在本连接里的状态；第一次调用时按 初始 建好。
//
// 页面的 渲染函数 想读组件状态（比如在标题里显示计数）也可以用这个，
// 但**别在页面里改它** —— 改归组件的 处理函数 管，不然两边都能写就没有隔离可言了。
公开 函数 组件状态(页面状态: 整数, 组件: 实时组件) : 整数 {
    变量 键: 字符串 = 组件键(组件.id);
    如果 (J.是否包含键(页面状态, 键) == 1) {
        变量 已有: 整数 = J.获取整数(页面状态, 键);
        如果 (已有 > 0) { 返回 已有; }
    }
    变量 新状态: 整数 = (组件.初始)();
    J.设置整数(页面状态, 键, 新状态);
    返回 新状态;
}

// 在页面模板里插入这个组件：`{渲染组件(状态, 计数器())}`
//
// 外面这层 <div data-target> 是事件路由的锚点，同时也让组件成为父模板槽位里的
// 一个**独立子模板** —— 组件没变化时父帧一个字节都不用带它。
公开 函数 渲染组件(页面状态: 整数, 组件: 实时组件) : HTML块 {
    变量 子状态: 整数 = 组件状态(页面状态, 组件);
    变量 子块: HTML块 = (组件.渲染)(子状态);
    返回 HTML { <div class="qi-component" data-target={组件.id} data-key={组件.id}>{子块}</div> };
}

// 这个事件是不是发给这个组件的；是则就地处理并返回 1，否则返回 0。
//
// 页面的 事件处理函数 开头逐个问一遍即可：
//   如果 (组件事件(状态, 甲(), 事件名, 载荷) == 1) { 返回 状态; }
//   如果 (组件事件(状态, 乙(), 事件名, 载荷) == 1) { 返回 状态; }
公开 函数 组件事件(页面状态: 整数, 组件: 实时组件, 事件名: 字符串, 载荷JSON: 字符串) : 整数 {
    如果 (字符串::等于(事件目标(载荷JSON), 组件.id) == 0) { 返回 0; }
    变量 子状态: 整数 = 组件状态(页面状态, 组件);
    变量 新子状态: 整数 = (组件.处理)(子状态, 事件名, 载荷JSON);
    // 处理函数可以返回一个**新**句柄（整个换掉状态），那就把挂点改过去
    如果 (新子状态 != 子状态) {
        J.设置整数(页面状态, 组件键(组件.id), 新子状态);
    }
    返回 1;
}

// 载荷里的 __target__ —— 客户端从最近的 [data-target] 祖先带上来的组件 id。
// 没有就是空串（发给页面本身的事件）。
公开 函数 事件目标(载荷JSON: 字符串) : 字符串 {
    变量 载荷: 整数 = J.解码(载荷JSON);
    如果 (载荷 <= 0) { 返回 ""; }
    变量 目标: 字符串 = "";
    如果 (J.是否包含键(载荷, "__target__") == 1) {
        目标 = J.获取字符串(载荷, "__target__");
    }
    J.删除(载荷);
    返回 目标;
}
