// Qi Web - 数据表：一堆行 + 一份列规格 → 一张能用的表。
//
// ── 为什么这块是缺的 ────────────────────────────────────────────
//
// 框架里有查询构造器（查询.qi，73 个函数）、有分页（分页.qi，三种分页栏）、
// 有表单（表单.qi，7 个校验器 6 种字段）—— **唯独没有把行渲染成表的东西**。
// 于是每个后台自己手搓 `<table>` 循环，然后各自缺各自的：
//
//   奇仓 控制台.结果表 / 问数.问结果表   两份近亲复制
//   家有小奇 书架、看板、AI笔记         各写各的
//
// 手搓的表无一例外地缺：排序、空状态、数字右对齐、长文本截断、行内操作。
// 不是因为难，是因为每次都在赶别的事，这些"下次再说"的东西永远没有下次。
//
// ── 列类型驱动格式，这才是重点 ──────────────────────────────────
//
// 省几行 HTML 不值得做一个组件。真正的价值是**类型决定呈现**：数字右对齐、
// 等宽数字、千分位。人手写一定会漏，而漏了之后一列数字就没法一眼比大小 ——
// 那正是一列数字存在的全部意义。
//
// ── 排序走 URL，不走内部状态 ────────────────────────────────────
//
// 点表头 push `?排=列名&向=降`，由 处理参数 收到后重查。机制（轻路由 data-patch
// + 处理参数）本来就有，只是没人把它跟表头接起来。好处是排序状态在地址栏里：
// 刷新、分享、后退都对。存进 LiveView 内部状态的话这三样全丢。
包 Web;

导入 标准库.字符串;
导入 标准库.JSON 作为 J;
导入 Web.HTML块::{HTML块, HTML, 创建片段, 创建块, 块属性, 块加子块, 块加文本};
导入 Web.查询::{查询器, 生成SQL, 生成计数SQL, 生成参数JSON, 查询分页, 排序};
导入 Web.分页::{分页参数, 分页信息, 创建分页信息};
导入 标准库.数据库 作为 数据库;

// ── 列规格 ──────────────────────────────────────────────────────
//
// 键 是 JSON 里的字段名，标题 是表头显示的字。两者分开是必须的：
// 字段名来自数据库（英文、下划线），标题给人看（中文）。

公开 类型 列规格 {
    字符串 键;
    字符串 标题;
    字符串 类型;     // 文本 / 数字 / 金额 / 时间 / 布尔
    整数 可排;       // 1 = 表头可点
    整数 截断;       // >0 = 超过这么多字符就省略号，0 = 不截
}

公开 函数 列文本(标题: 字符串, 键: 字符串) : 列规格 {
    返回 新建 列规格 { 键: 键, 标题: 标题, 类型: "文本", 可排: 1, 截断: 0 };
}

// 数字列：右对齐 + 等宽数字 + 千分位。**这三样是一起的** ——
// 只右对齐不等宽，字符宽度不同的数字仍然对不齐；只等宽不加千分位，
// 七位数还是得一位一位数。
公开 函数 列数字(标题: 字符串, 键: 字符串) : 列规格 {
    返回 新建 列规格 { 键: 键, 标题: 标题, 类型: "数字", 可排: 1, 截断: 0 };
}

公开 函数 列金额(标题: 字符串, 键: 字符串) : 列规格 {
    返回 新建 列规格 { 键: 键, 标题: 标题, 类型: "金额", 可排: 1, 截断: 0 };
}

公开 函数 列时间(标题: 字符串, 键: 字符串) : 列规格 {
    返回 新建 列规格 { 键: 键, 标题: 标题, 类型: "时间", 可排: 1, 截断: 0 };
}

公开 函数 列布尔(标题: 字符串, 键: 字符串) : 列规格 {
    返回 新建 列规格 { 键: 键, 标题: 标题, 类型: "布尔", 可排: 0, 截断: 0 };
}

// 长文本列：截断到 n 个字符，完整内容进 title（鼠标悬停可见）。
// 不截的话一条备注就能把整张表撑变形。
公开 函数 列长文本(标题: 字符串, 键: 字符串, 截到几字: 整数) : 列规格 {
    返回 新建 列规格 { 键: 键, 标题: 标题, 类型: "文本", 可排: 0, 截断: 截到几字 };
}

公开 函数 列不可排(列: 列规格) : 列规格 {
    返回 新建 列规格 { 键: 列.键, 标题: 列.标题, 类型: 列.类型, 可排: 0, 截断: 列.截断 };
}

// ── 表的选项 ────────────────────────────────────────────────────

公开 类型 表选项 {
    字符串 排序列;     // 当前按哪列排（空 = 没排）
    字符串 排序向;     // "升" / "降"
    字符串 基础路径;   // 表头链接的基路径，如 "/admin/members"
    字符串 空话;       // 一行都没有时说什么
    整数 带序号;       // 1 = 最左边加一列行号
}

公开 函数 表选项默认() : 表选项 {
    返回 新建 表选项 {
        排序列: "", 排序向: "升", 基础路径: "",
        // 空状态**必须有话**。空白的表格看起来像加载失败，而"还没有数据"
        // 和"加载失败"对用户是完全不同的两件事。
        空话: "还没有数据", 带序号: 0
    };
}

公开 函数 表选项排序(选: 表选项, 列: 字符串, 向: 字符串) : 表选项 {
    返回 新建 表选项 {
        排序列: 列, 排序向: 向, 基础路径: 选.基础路径,
        空话: 选.空话, 带序号: 选.带序号
    };
}

公开 函数 表选项路径(选: 表选项, 路径: 字符串) : 表选项 {
    返回 新建 表选项 {
        排序列: 选.排序列, 排序向: 选.排序向, 基础路径: 路径,
        空话: 选.空话, 带序号: 选.带序号
    };
}

公开 函数 表选项空话(选: 表选项, 话: 字符串) : 表选项 {
    返回 新建 表选项 {
        排序列: 选.排序列, 排序向: 选.排序向, 基础路径: 选.基础路径,
        空话: 话, 带序号: 选.带序号
    };
}

公开 函数 表选项带序号(选: 表选项) : 表选项 {
    返回 新建 表选项 {
        排序列: 选.排序列, 排序向: 选.排序向, 基础路径: 选.基础路径,
        空话: 选.空话, 带序号: 1
    };
}

// ── 从数据推列 ──────────────────────────────────────────────────
//
// 探查第一行的键，全部当文本列。给"先看看数据长什么样"用，
// **不建议进产品界面**：键序不保证（见 J.键列表 的注释），列序会跳。
公开 函数 推断列(行JSON: 字符串) : 数组<列规格> {
    变量 表: 整数 = J.解码(行JSON);
    如果 (表 <= 0 或 J.数组长度(表) == 0) {
        如果 (表 > 0) { J.删除(表); }
        返回 数组<列规格>(0);
    }
    变量 首行: 整数 = J.数组获取对象(表, 0);
    变量 键: 数组<字符串> = J.键列表(首行);
    变量 出: 数组<列规格> = 数组<列规格>(长度(键));
    对于 i 在 0 直到 长度(键) { 出[i] = 列文本(键[i], 键[i]); }
    J.删除(首行);
    J.删除(表);
    返回 出;
}

// ── 渲染 ────────────────────────────────────────────────────────

公开 函数 数据表(行JSON: 字符串, 列: 数组<列规格>) : HTML块 {
    返回 数据表带选项(行JSON, 列, 表选项默认());
}

公开 函数 数据表带选项(行JSON: 字符串, 列: 数组<列规格>, 选: 表选项) : HTML块 {
    变量 表: 整数 = J.解码(行JSON);
    变量 行数: 整数 = 0;
    如果 (表 > 0) { 行数 = J.数组长度(表); }
    如果 (行数 == 0) {
        如果 (表 > 0) { J.删除(表); }
        返回 HTML { <p class="qi-table-empty">{选.空话}</p> };
    }

    变量 头: HTML块 = 创建片段();
    如果 (选.带序号 == 1) {
        头 = 块加子块(头, HTML { <th class="qi-table-idx">#</th> });
    }
    对于 c 在 0 直到 长度(列) { 头 = 块加子块(头, 表头格(列[c], 选)); }

    变量 身: HTML块 = 创建片段();
    对于 r 在 0 直到 行数 {
        变量 行: 整数 = J.数组获取对象(表, r);
        变量 格组: HTML块 = 创建片段();
        如果 (选.带序号 == 1) {
            格组 = 块加子块(格组, HTML {
                <td class="qi-table-idx">{整数转字符串(r + 1)}</td>
            });
        }
        对于 c 在 0 直到 长度(列) {
            格组 = 块加子块(格组, 一个格(行, 列[c]));
        }
        身 = 块加子块(身, HTML { <tr>{格组}</tr> });
        J.删除(行);
    }
    J.删除(表);

    返回 HTML {
        <table class="qi-table"><thead><tr>{头}</tr></thead><tbody>{身}</tbody></table>
    };
}

// 表头。可排的列做成轻路由链接：点一下换排序，再点一下反向。
//
// 用 data-patch 不用 data-click：**排序属于地址**，不属于组件内部状态。
// 走 data-click 的话刷新一下排序就没了，链接分享出去也不带排序。
函数 表头格(列: 列规格, 选: 表选项) : HTML块 {
    变量 类: 字符串 = "qi-table-head " + 对齐类(列.类型);
    如果 (列.可排 == 0 或 字符串::字节长度(选.基础路径) == 0) {
        返回 HTML { <th class={类}>{列.标题}</th> };
    }
    // 当前就按这列排 → 点它反向；否则按它升序
    变量 下一向: 字符串 = "升";
    变量 记号: 字符串 = "";
    如果 (字符串::等于(选.排序列, 列.键) == 1) {
        如果 (字符串::等于(选.排序向, "升") == 1) {
            下一向 = "降"; 记号 = " ↑";
        } 否则 {
            下一向 = "升"; 记号 = " ↓";
        }
    }
    变量 去: 字符串 = 选.基础路径 + "?排=" + 列.键 + "&向=" + 下一向;
    返回 HTML {
        <th class={类}>
            <a class="qi-table-sort" data-patch={去} href={去}>{列.标题 + 记号}</a>
        </th>
    };
}

函数 一个格(行: 整数, 列: 列规格) : HTML块 {
    // **取显示值**不是 获取字符串：后者只认字符串，数字列会渲染成一片空白，
    // 而一列空白看起来像"本来就没数据"，不像 bug。
    变量 原: 字符串 = J.取显示值(行, 列.键);
    变量 类: 字符串 = "qi-table-cell " + 对齐类(列.类型);

    如果 (字符串::等于(列.类型, "数字") == 1) {
        返回 HTML { <td class={类}>{加千分位(原)}</td> };
    }
    如果 (字符串::等于(列.类型, "金额") == 1) {
        返回 HTML { <td class={类}>{加币号(加千分位(补两位小数(原)), "¥")}</td> };
    }
    如果 (列.截断 > 0 与 字符串::字符数量(原) > 列.截断) {
        // 完整内容进 title：截断是为了版式，不是为了藏信息
        返回 HTML {
            <td class={类} title={原}>{字符串::字符子串(原, 0, 列.截断) + "…"}</td>
        };
    }
    返回 HTML { <td class={类}>{原}</td> };
}

// 数字和金额右对齐，其余左对齐。
//
// 数字列必须右对齐 —— 左对齐的数字列，位数不同的数就没法一眼比大小，
// 而"一眼比大小"是这一列存在的理由。
函数 对齐类(类型名: 字符串) : 字符串 {
    如果 (字符串::等于(类型名, "数字") == 1) { 返回 "qi-num"; }
    如果 (字符串::等于(类型名, "金额") == 1) { 返回 "qi-num"; }
    返回 "qi-txt";
}

// 整数部分每三位插一个逗号。小数部分和负号原样保留。
//
// 不用区域设置：服务端渲染，locale 是服务器的不是用户的，用它只会让同一份
// 数据在两台机器上显示成两个样。
// 金额补齐到**恰好两位小数**。
//
// 库里回来的浮点数打印出来是 "103500.0"（Rust 的 Display 只给必要位数），
// 直接摆进金额列就是「¥103,500.0」—— 一栏钱里有的一位有的两位，
// 上下对不齐，看着像没做完。钱只有两位小数这件事是硬事实，不是偏好，
// 所以放在框架层而不是每个应用各写一遍。
//
// 非数字（"N/A"、"—"、空）原样退回：这一列里混着占位符是正常的。
// 币号加在**负号后面**：`-¥10,951.76`，不是 `¥-10,951.76`。
//
// 后者是直接把符号拼在前面的自然结果，也是错的 —— 中文和英文排版里
// 负号都在货币符号外面。一栏数字里混着这两种写法，扫起来会绊一下。
公开 函数 加币号(数文: 字符串, 币号: 字符串) : 字符串 {
    如果 (字符串::开始于(数文, "-") == 1) {
        返回 "-" + 币号 + 字符串::子串从位置(数文, 1);
    }
    返回 币号 + 数文;
}

公开 函数 补两位小数(数文: 字符串) : 字符串 {
    如果 (字符串::字节长度(数文) == 0) { 返回 ""; }
    变量 本: 字符串 = 数文;
    变量 负: 字符串 = "";
    如果 (字符串::开始于(本, "-") == 1) {
        负 = "-";
        本 = 字符串::子串从位置(本, 1);
    }
    变量 点: 整数 = 字符串::查找(本, ".");
    变量 整: 字符串 = 本;
    变量 小: 字符串 = "";
    如果 (点 >= 0) {
        整 = 字符串::子串(本, 0, 点);
        小 = 字符串::子串从位置(本, 点 + 1);
    }
    如果 (全是数字(整) == 0) { 返回 数文; }
    如果 (字符串::字节长度(小) > 0 与 全是数字(小) == 0) { 返回 数文; }

    如果 (字符串::字节长度(小) == 0) { 小 = "00"; }
    否则 如果 (字符串::字节长度(小) == 1) { 小 = 小 + "0"; }
    // 多于两位就**截断**不四舍五入：这一层是排版，不是算术。
    // 要圆到分应该在算的时候圆（见 界面.保留两位），在这儿圆等于
    // 让显示层悄悄改数。
    否则 { 小 = 字符串::子串(小, 0, 2); }
    返回 负 + 整 + "." + 小;
}

公开 函数 加千分位(数文: 字符串) : 字符串 {
    如果 (字符串::字节长度(数文) == 0) { 返回 ""; }
    变量 负: 字符串 = "";
    变量 本: 字符串 = 数文;
    如果 (字符串::开始于(本, "-") == 1) {
        负 = "-";
        本 = 字符串::子串从位置(本, 1);
    }
    变量 点: 整数 = 字符串::查找(本, ".");
    变量 整: 字符串 = 本;
    变量 尾: 字符串 = "";
    如果 (点 >= 0) {
        整 = 字符串::子串(本, 0, 点);
        尾 = 字符串::子串从位置(本, 点);
    }
    // 不是纯数字就原样退回（可能是 "N/A"、日期、或者别的什么）
    如果 (全是数字(整) == 0) { 返回 数文; }

    变量 n: 整数 = 字符串::字节长度(整);
    变量 出: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < n) {
        // 从左往右数，剩余位数是 3 的倍数且不在开头时插逗号
        如果 (i > 0 与 (n - i) % 3 == 0) { 出 = 出 + ","; }
        出 = 出 + 字符串::子串(整, i, 1);
        i = i + 1;
    }
    返回 负 + 出 + 尾;
}

函数 全是数字(s: 字符串) : 整数 {
    变量 n: 整数 = 字符串::字节长度(s);
    如果 (n == 0) { 返回 0; }
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 c: 字符串 = 字符串::子串(s, i, 1);
        如果 (字符串::查找("0123456789", c) < 0) { 返回 0; }
        i = i + 1;
    }
    返回 1;
}

// ── 从 URL 读排序 ───────────────────────────────────────────────
//
// 配 处理参数 用：查询串里取 排/向，白名单校验之后才能拼进 ORDER BY。
// **不校验就是一条注入** —— 列名是从地址栏来的。

公开 函数 读排序(查询JSON: 字符串, 列: 数组<列规格>, 默认列: 字符串) : 表选项 {
    变量 根: 整数 = J.解码(查询JSON);
    变量 想排: 字符串 = "";
    变量 想向: 字符串 = "升";
    如果 (根 > 0) {
        想排 = J.获取字符串(根, "排");
        变量 v: 字符串 = J.获取字符串(根, "向");
        如果 (字符串::等于(v, "降") == 1) { 想向 = "降"; }
        J.删除(根);
    }
    // 白名单：只认列规格里真有、且标了可排的那些
    变量 认了: 字符串 = "";
    对于 i 在 0 直到 长度(列) {
        如果 (列[i].可排 == 1 与 字符串::等于(列[i].键, 想排) == 1) {
            认了 = 想排;
        }
    }
    如果 (字符串::字节长度(认了) == 0) { 认了 = 默认列; }
    变量 出: 表选项 = 表选项默认();
    返回 表选项排序(出, 认了, 想向);
}

// 排序选项 → SQL 的 ORDER BY 片段。列名已经过 读排序 的白名单，可以直接拼。
公开 函数 排序SQL(选: 表选项) : 字符串 {
    如果 (字符串::字节长度(选.排序列) == 0) { 返回 ""; }
    变量 向: 字符串 = "ASC";
    如果 (字符串::等于(选.排序向, "降") == 1) { 向 = "DESC"; }
    返回 " ORDER BY \"" + 选.排序列 + "\" " + 向;
}

// ── 查询器 → 分页 → 表格 一条龙 ─────────────────────────────────
//
// 现在的写法是手写两条 SQL：一条取数据、一条 count。**它们会漂** ——
// 加了个 WHERE 忘了同步到 count，分页总数就是错的，而页面上完全看不出来：
// 页码栏显示 10 页，翻到第 4 页就空了。这类 bug 能活很久。
//
// 查询构造器本来就能从**同一个构造器**出两条 SQL（生成SQL / 生成计数SQL），
// 只是没人把它跟分页、表格接起来。接起来之后条件只写一次，两条 SQL 必然一致。

公开 类型 列表页 {
    字符串 行JSON;
    分页信息 页信息;
}

// 跑 count + 当前页，返回行和分页信息。
//
// **count 先跑**：它不带 ORDER/LIMIT，跑失败说明条件本身有问题，
// 这时候没必要再发第二条。
公开 函数 列一页(查: 查询器, 页参: 分页参数, 表设: 表选项) : 列表页 {
    变量 计数SQL: 字符串 = 生成计数SQL(查);
    变量 参数: 字符串 = 生成参数JSON(查);
    变量 总数: 整数 = 数出总数(查.库, 计数SQL, 参数);

    // 排序来自表设（已过白名单，见 读排序），分页来自页参
    变量 查2: 查询器 = 查;
    如果 (字符串::字节长度(表设.排序列) > 0) {
        变量 向: 字符串 = "ASC";
        如果 (字符串::等于(表设.排序向, "降") == 1) { 向 = "DESC"; }
        查2 = 排序(查2, 表设.排序列, 向);
    }
    查2 = 查询分页(查2, 页参.页码, 页参.每页);

    变量 行: 字符串 = 数据库.查询参数(查.库, 生成SQL(查2), 生成参数JSON(查2));
    返回 新建 列表页 { 行JSON: 行, 页信息: 创建分页信息(页参, 总数) };
}

函数 数出总数(库: 整数, SQL: 字符串, 参数JSON: 字符串) : 整数 {
    变量 行JSON: 字符串 = 数据库.查询参数(库, SQL, 参数JSON);
    变量 表: 整数 = J.解码(行JSON);
    变量 n: 整数 = 0;
    如果 (表 > 0 与 J.数组长度(表) > 0) {
        变量 行: 整数 = J.数组获取对象(表, 0);
        n = J.获取整数(行, "计数值");
        J.删除(行);
    }
    如果 (表 > 0) { J.删除(表); }
    返回 n;
}

// ── 样式 ────────────────────────────────────────────────────────
//
// 一份能用的默认样式。类名全带 qi-table- 前缀，应用要覆盖直接写同名规则即可。
公开 函数 数据表样式() : 字符串 {
    返回 `<style>
.qi-table{border-collapse:collapse; width:100%; font-size:13px}
.qi-table th{
  text-align:left; font-weight:600; white-space:nowrap;
  border-bottom:1px solid currentColor; padding:6px 10px 6px 0;
  opacity:.7;
}
.qi-table td{
  padding:5px 10px 5px 0;
  border-bottom:1px solid color-mix(in srgb, currentColor 12%, transparent);
}
/* 数字列：右对齐 + 等宽数字。两样缺一不可 —— 只右对齐的话，
   字符宽度不同的数字仍然对不齐，一列数字还是没法一眼比大小。 */
.qi-table .qi-num{text-align:right; font-variant-numeric:tabular-nums}
.qi-table .qi-txt{text-align:left}
.qi-table .qi-table-idx{width:1%; white-space:nowrap; opacity:.45; text-align:right}
.qi-table .qi-table-sort{color:inherit; text-decoration:none; cursor:pointer}
.qi-table .qi-table-sort:hover{text-decoration:underline}
.qi-table-empty{opacity:.6; font-size:13px; padding:10px 0}
</style>
`;
}
