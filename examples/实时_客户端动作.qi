// 客户端动作（对标 Phoenix JS commands）
//
// 跑：qi run examples/实时_客户端动作.qi   然后开 http://127.0.0.1:41553/
//
// 页面右上角有个每秒自己跳的计数，用来把这件事演清楚：**服务端的帧一直在来**。
// 在这个前提下看三件事：
//
//   1. 点「展开」—— 不经服务端，当场展开。而且带了 data-js-keep，
//      后面无论来多少帧都不会被合上。
//   2. 下面那个对照块没写 data-js-keep —— 客户端给它加的 class 会在下一帧
//      被服务端的版本覆盖掉。这是**故意留着看的**，不是 bug。
//   3. 「保存」这个按钮客户端和服务端各干各的：客户端立刻闪一下（0 延迟），
//      服务端那趟该多久还是多久。
包 主程序;

导入 标准库.字符串;
导入 标准库.JSON 作为 J;
导入 Web::{
    应用, 创建应用, 配置, 运行应用, HTML块, 渲染块, 实时路由带消息,
    动作, 新动作, 动作值, 切类, 加类, 聚焦, 闪一下,
    实时指令, 指令_动作, 实时定时
};

函数 初始状态() : 整数 {
    变量 状态: 整数 = J.创建对象();
    J.设置整数(状态, "秒", 0);
    J.设置整数(状态, "存了几次", 0);
    返回 状态;
}

// 一次点击做三件事：翻转面板、翻转箭头、顺手把焦点送进搜索框
函数 展开动作() : 动作 {
    变量 链: 动作 = 切类(新动作(), "#详情", "open");
    链 = 切类(链, "#箭头", "转90");
    链 = 聚焦(链, "#搜索框");
    返回 链;
}

函数 渲染(状态: 整数) : 字符串 {
    变量 块: HTML块 = HTML {
        <div>
            <h1>客户端动作</h1>
            <p class="qi-muted">服务端每秒推一帧：<b id="秒">{整数转字符串(J.获取整数(状态, "秒"))}</b> 秒</p>

            <h2>1 · 展开折叠（不经服务端）</h2>
            <button data-js-click={动作值(展开动作())}>
                <span id="箭头" class="ar" data-js-keep>▸</span> 展开
            </button>
            <div id="详情" class="fold" data-js-keep>
                <input id="搜索框" placeholder="展开时自动聚焦这里">
                <p>这一块的 class 归客户端管（data-js-keep），服务端的帧再多也合不上它。</p>
            </div>

            <h2>2 · 对照：没写 data-js-keep</h2>
            <button data-js-click={动作值(加类(新动作(), "#对照", "high"))}>给它加个 class</button>
            <div id="对照" class="fold">
                加上之后，**下一帧就被服务端的版本覆盖掉**了。这是 morph 的既定行为，
                不是 bug —— 客户端改 DOM 和服务端驱动 UI 天生冲突，只能显式划线。
            </div>

            <h2>3 · 客户端 + 服务端各干各的</h2>
            <button
                data-js-click={动作值(闪一下(新动作(), "", "hit", 400))}
                data-click="保存">保存</button>
            <p>已保存 <b id="次数">{整数转字符串(J.获取整数(状态, "存了几次"))}</b> 次
               —— 按钮自己立刻闪一下（0 延迟），计数由服务端回帧更新。</p>

            <h2>4 · 服务端下发动作</h2>
            <button data-click="提醒">让服务端叫客户端闪一下标题</button>
        </div>
    };
    返回 渲染块(块);
}

函数 处理事件(状态: 整数, 事件名: 字符串, 载荷JSON: 字符串) : 整数 {
    如果 (字符串::等于(事件名, "保存") == 1) {
        J.设置整数(状态, "存了几次", J.获取整数(状态, "存了几次") + 1);
    }
    // 服务端也能叫客户端跑动作（对标 JS.exec）：「保存成功那一行闪一下」就是它
    如果 (字符串::等于(事件名, "提醒") == 1) {
        实时指令(状态, 指令_动作(闪一下(新动作(), "h1", "hit", 800)));
    }
    返回 状态;
}

函数 处理消息(状态: 整数, 消息名: 字符串, 载荷JSON: 字符串) : 整数 {
    如果 (字符串::等于(消息名, "__上线__") == 1) {
        实时定时(状态, 1000, "滴答", "{}");
    }
    如果 (字符串::等于(消息名, "滴答") == 1) {
        J.设置整数(状态, "秒", J.获取整数(状态, "秒") + 1);
        实时定时(状态, 1000, "滴答", "{}");
    }
    返回 状态;
}

函数 入口() {
    变量 应用值: 应用 = 配置(创建应用(), "127.0.0.1", 41553);
    应用值 = 实时路由带消息(应用值, "/", 初始状态, 渲染, 处理事件, 处理消息);
    打印行("客户端动作：http://127.0.0.1:41553/");
    运行应用(应用值);
}
