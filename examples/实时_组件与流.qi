// 实时组件 + 实时流 —— LiveComponent 与 Streams 各来一个
//
// 跑：qi run examples/实时_组件与流.qi   然后开 http://127.0.0.1:41552/
//
// 页面上两块东西，各自演示一件事：
//
//   计数器（实时组件）—— 状态是它自己的，事件也是它自己的。页面的 处理事件 里
//   只有一行「先问问组件要不要」。两个计数器实例用同一份代码、不同 id，
//   互不干扰；点其中一个，另一个连字节都不会下发（结构化 diff 认得出没变）。
//
//   消息流（实时流）—— 服务端**一条消息都不存**。发一条就往客户端推一条，
//   跟已经有多少条完全无关。容器写了 data-ignore，整页重渲不碰它。
包 主程序;

导入 标准库.字符串;
导入 标准库.JSON 作为 J;
导入 Web::{
    应用, 创建应用, 配置, 运行应用, HTML块,
    实时块路由_无鉴权, 实时组件, 创建组件, 渲染组件, 组件事件, 组件状态,
    流追加, 流删除, 流清空, 实时指令, 指令_滚动, 转义HTML
};

// ── 组件：一个计数器 ────────────────────────────────────────────

函数 计数器初始() : 整数 {
    变量 状态: 整数 = J.创建对象();
    J.设置整数(状态, "n", 0);
    返回 状态;
}

函数 计数器渲染(状态: 整数) : HTML块 {
    返回 HTML {
        <div class="qi-card">
            <b>{整数转字符串(J.获取整数(状态, "n"))}</b>
            <button data-click="加">+1</button>
            <button class="ghost" data-click="清零">清零</button>
        </div>
    };
}

函数 计数器处理(状态: 整数, 事件名: 字符串, 载荷JSON: 字符串) : 整数 {
    如果 (字符串::等于(事件名, "加") == 1) {
        J.设置整数(状态, "n", J.获取整数(状态, "n") + 1);
    }
    // 注意「清零」这个事件名页面上也有一个（清空消息流），但它们**不会串** ——
    // 事件带着最近的 data-target 上来，框架照 id 路由
    如果 (字符串::等于(事件名, "清零") == 1) {
        J.设置整数(状态, "n", 0);
    }
    返回 状态;
}

函数 左计数器() : 实时组件 {
    返回 创建组件("left", 计数器初始, 计数器渲染, 计数器处理);
}

函数 右计数器() : 实时组件 {
    返回 创建组件("right", 计数器初始, 计数器渲染, 计数器处理);
}

// ── 页面 ────────────────────────────────────────────────────────

函数 初始状态() : 整数 {
    变量 状态: 整数 = J.创建对象();
    J.设置整数(状态, "下条消息号", 0);
    返回 状态;
}

函数 渲染(状态: 整数) : HTML块 {
    // 两个计数器加起来的和 —— 页面读组件状态是可以的，改就不行了
    变量 合计: 整数 = J.获取整数(组件状态(状态, 左计数器()), "n")
                    + J.获取整数(组件状态(状态, 右计数器()), "n");
    返回 HTML {
        <div>
            <h1>组件与流</h1>
            <p class="qi-muted">两个计数器共 {整数转字符串(合计)} 次</p>
            <div class="qi-row">{渲染组件(状态, 左计数器())}{渲染组件(状态, 右计数器())}</div>

            <h2>消息流</h2>
            <p class="qi-muted">服务端一条都不存；下面这些全是流进来的</p>
            <form data-submit="发言">
                <input name="text" placeholder="说点什么" autocomplete="off">
                <button type="submit">发送</button>
            </form>
            <button class="ghost" data-click="清零">清空消息</button>
            <ul id="msgs" class="qi-list" data-ignore></ul>
        </div>
    };
}

函数 处理事件(状态: 整数, 事件名: 字符串, 载荷JSON: 字符串) : 整数 {
    // 先让组件挑走属于自己的事件（带 data-target 的）
    如果 (组件事件(状态, 左计数器(), 事件名, 载荷JSON) == 1) { 返回 状态; }
    如果 (组件事件(状态, 右计数器(), 事件名, 载荷JSON) == 1) { 返回 状态; }

    如果 (字符串::等于(事件名, "发言") == 1) {
        变量 载荷: 整数 = J.解码(载荷JSON);
        变量 文本: 字符串 = "";
        如果 (载荷 > 0) { 文本 = J.获取字符串(载荷, "text"); J.删除(载荷); }
        如果 (字符串::字节长度(文本) > 0) {
            变量 号: 整数 = J.获取整数(状态, "下条消息号") + 1;
            J.设置整数(状态, "下条消息号", 号);
            变量 键: 字符串 = "m" + 整数转字符串(号);
            流追加(状态, "msgs", 键, HTML {
                <li data-key={键} class="qi-item">
                    <span>{文本}</span>
                    <button class="icon" data-click="撤回" data-value-key={键}>×</button>
                </li>
            });
            实时指令(状态, 指令_滚动("#msgs"));
        }
    }

    如果 (字符串::等于(事件名, "撤回") == 1) {
        变量 载荷: 整数 = J.解码(载荷JSON);
        如果 (载荷 > 0) {
            流删除(状态, "msgs", J.获取字符串(载荷, "key"));
            J.删除(载荷);
        }
    }

    // 页面自己的「清零」= 清空消息流（组件那个同名事件已经在上面被挑走了）
    如果 (字符串::等于(事件名, "清零") == 1) {
        流清空(状态, "msgs");
        J.设置整数(状态, "下条消息号", 0);
    }

    返回 状态;
}

函数 入口() {
    变量 应用值: 应用 = 配置(创建应用(), "127.0.0.1", 41552);
    应用值 = 实时块路由_无鉴权(应用值, "/", 初始状态, 渲染, 处理事件);
    打印行("组件与流：http://127.0.0.1:41552/");
    运行应用(应用值);
}
