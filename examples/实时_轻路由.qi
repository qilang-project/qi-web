// 轻路由（对标 Phoenix live_patch / handle_params）
//
// 跑：qi run examples/实时_轻路由.qi   然后开 http://127.0.0.1:41554/
//
// 三个标签页 + 一个翻页。都改 URL（能收藏、能分享、后退键管用），但**不重建连接**：
// 页面上那个「本连接换过 N 次 URL」是累加的，切标签页时只 +1、不会归零 ——
// 要是走 `指令_跳转`（整页刷新），每次都会变回 1。
//
// 直接开 http://127.0.0.1:41554/?tab=已完成 也对：首屏是服务端按真实 URL 直出的，
// 不会先渲一遍默认标签页再跳一下。
包 主程序;

导入 标准库.字符串;
导入 标准库.JSON 作为 J;
导入 Web::{
    应用, 创建应用, 配置, 运行应用, HTML块, 渲染块, 转义HTML,
    实时块路由带参数, 取查询, 取查询整数,
    实时指令, 指令_跳转参数, 实时定时
};

函数 初始状态() : 整数 {
    变量 状态: 整数 = J.创建对象();
    J.设置字符串(状态, "标签页", "待办");
    J.设置整数(状态, "页码", 1);
    J.设置整数(状态, "换过几次", 0);
    返回 状态;
}

// URL 变了就会走这里 —— 首屏、连上、点 data-patch、前进后退、服务端 push，全走它
函数 处理参数(状态: 整数, 路径: 字符串, 查询JSON: 字符串) : 整数 {
    变量 标签页: 字符串 = 取查询(查询JSON, "tab");
    如果 (字符串::字节长度(标签页) == 0) { 标签页 = "待办"; }
    J.设置字符串(状态, "标签页", 标签页);
    J.设置整数(状态, "页码", 取查询整数(查询JSON, "page", 1));
    J.设置整数(状态, "换过几次", J.获取整数(状态, "换过几次") + 1);
    返回 状态;
}

函数 标签(当前: 字符串, 名字: 字符串) : HTML块 {
    变量 类名: 字符串 = "tab";
    如果 (字符串::等于(当前, 名字) == 1) { 类名 = "tab on"; }
    变量 地址: 字符串 = "?tab=" + 名字;
    返回 HTML { <a class={类名} data-patch={地址} href={地址}>{名字}</a> };
}

函数 渲染(状态: 整数) : HTML块 {
    变量 当前: 字符串 = J.获取字符串(状态, "标签页");
    变量 页码: 整数 = J.获取整数(状态, "页码");
    返回 HTML {
        <div>
            <h1>轻路由</h1>
            <p class="qi-muted">
                本连接换过 <b>{整数转字符串(J.获取整数(状态, "换过几次"))}</b> 次 URL ——
                这个数只增不减，说明连接从头到尾是同一条
            </p>

            <nav class="qi-row">
                {标签(当前, "待办")}{标签(当前, "进行中")}{标签(当前, "已完成")}
            </nav>

            <div class="qi-card">
                <h2>{转义HTML(当前)}</h2>
                <p>第 {整数转字符串(页码)} 页</p>
                <a data-patch={"?tab=" + 当前 + "&page=" + 整数转字符串(页码 + 1)}
                   href={"?tab=" + 当前 + "&page=" + 整数转字符串(页码 + 1)}>下一页 →</a>
            </div>

            <p><button data-click="回第一页">服务端把我送回第一页</button></p>
            <p class="qi-muted">地址栏跟着变；浏览器后退键也管用。</p>
        </div>
    };
}

函数 处理事件(状态: 整数, 事件名: 字符串, 载荷JSON: 字符串) : 整数 {
    如果 (字符串::等于(事件名, "回第一页") == 1) {
        // 服务端主动改 URL（对标 push_patch）：不刷新页面，连接照旧
        实时指令(状态, 指令_跳转参数("?tab=" + J.获取字符串(状态, "标签页")));
    }
    返回 状态;
}

函数 入口() {
    变量 应用值: 应用 = 配置(创建应用(), "127.0.0.1", 41554);
    应用值 = 实时块路由带参数(应用值, "/", 初始状态, 渲染, 处理事件, 处理参数);
    打印行("轻路由：http://127.0.0.1:41554/");
    运行应用(应用值);
}
