// 表单原语（对标 Phoenix 的 changeset / to_form / <.input>）
//
// 跑：qi run examples/实时_表单校验.qi   然后开 http://127.0.0.1:41555/
//
// 一张注册表单，把「每张表单都要重写一遍」的三件事演一遍：
//   1. 边打字边校验，错误就挂在出错的那个字段旁边
//   2. 提交没过时**用户填的东西还在**，不用重填
//   3. 「必填 / 至少 6 位 / 两次密码一致 / 格式」这些判断各写一行，不是各抄一段
//
// 注意一进页面是干净的 —— 没有一上来就糊一脸红字。错误只有在 动过(表) 之后
// 才渲染，也就是用户确实输入过或者点过提交。
包 主程序;

导入 标准库.字符串;
导入 标准库.JSON 作为 J;
导入 Web::{
    应用, 创建应用, 配置, 运行应用, HTML块, 实时块路由_无鉴权, 转义HTML,
    表单, 新表单, 取表单, 存表单, 表单载入, 动过, 表单有错, 表单值,
    校验必填, 校验最短, 校验最长, 校验相等, 校验匹配, 校验整数范围,
    文本字段, 密码字段, 邮箱字段, 数字字段, 多行字段
};

函数 初始状态() : 整数 {
    变量 状态: 整数 = J.创建对象();
    J.设置字符串(状态, "注册成功的名字", "");
    存表单(状态, 新表单());
    返回 状态;
}

// 校验规则集中一处，边打字和点提交走的是**同一份**
函数 校验(表: 表单) : 表单 {
    表 = 校验必填(表, "name", "请填名字");
    表 = 校验最长(表, "name", 20, "名字最多 20 个字");
    表 = 校验必填(表, "mail", "请填邮箱");
    表 = 校验匹配(表, "mail", "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$", "邮箱格式不对");
    表 = 校验必填(表, "age", "请填年龄");
    表 = 校验整数范围(表, "age", 1, 120, "年龄要在 1 到 120 之间");
    表 = 校验最短(表, "pass", 6, "密码至少 6 位");
    表 = 校验相等(表, "pass", "pass2", "两次密码不一样");
    表 = 校验最长(表, "intro", 100, "自我介绍最多 100 字");
    返回 表;
}

函数 渲染(状态: 整数) : HTML块 {
    变量 表: 表单 = 取表单(状态);
    变量 成功名: 字符串 = J.获取字符串(状态, "注册成功的名字");
    返回 HTML {
        <div>
            <h1>注册</h1>
            <p class="qi-muted">边打字边校验；提交没过时填过的东西都还在。</p>

            <p class="qi-ok-line" 如果={字符串::字节长度(成功名) > 0}>
                ✅ 注册成功：{转义HTML(成功名)}
            </p>

            <form data-change="校验" data-submit="注册">
                {文本字段(表, "name", "名字")}
                {邮箱字段(表, "mail", "邮箱")}
                {数字字段(表, "age", "年龄")}
                {密码字段(表, "pass", "密码（至少 6 位）")}
                {密码字段(表, "pass2", "再打一遍")}
                {多行字段(表, "intro", "自我介绍（可留空，最多 100 字）")}
                <button type="submit">注册</button>
            </form>
        </div>
    };
}

函数 处理事件(状态: 整数, 事件名: 字符串, 载荷JSON: 字符串) : 整数 {
    // 边打字边校验：只更新表单，不做别的
    如果 (字符串::等于(事件名, "校验") == 1) {
        存表单(状态, 校验(动过(表单载入(取表单(状态), 载荷JSON))));
    }

    如果 (字符串::等于(事件名, "注册") == 1) {
        变量 表: 表单 = 校验(动过(表单载入(取表单(状态), 载荷JSON)));
        如果 (表单有错(表) == 0) {
            // 真正的业务在这里；成功之后把表单清空
            J.设置字符串(状态, "注册成功的名字", 表单值(表, "name"));
            表 = 新表单();
        } 否则 {
            J.设置字符串(状态, "注册成功的名字", "");
        }
        存表单(状态, 表);
    }
    返回 状态;
}

函数 入口() {
    变量 应用值: 应用 = 配置(创建应用(), "127.0.0.1", 41555);
    应用值 = 实时块路由_无鉴权(应用值, "/", 初始状态, 渲染, 处理事件);
    打印行("表单校验：http://127.0.0.1:41555/");
    运行应用(应用值);
}
