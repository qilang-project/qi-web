// 实时页面 —— 服务端主动推（定时器 + 后台慢任务）
//
// 跑：qi run examples/实时_时钟与异步.qi   然后开 http://127.0.0.1:41551/
//
// 这个例子的两件事，用普通 实时路由_无鉴权 都做不了：
//   1. 秒表：没人点也要每秒动一下
//   2. 「算一道慢题」：点下去要 2 秒才有结果，但页面必须立刻显示「计算中…」，
//      而且这 2 秒里秒表不能停、按钮不能失灵
//
// 关键在于 实时异步 调用后**立刻返回**：本轮渲染帧（带「计算中…」）当场就发出去了，
// 真正的活在另一个协程里跑，出结果再经邮箱回到 处理消息，触发第二帧。
包 主程序;

导入 标准库.字符串;
导入 标准库.日期时间 作为 时间;
导入 标准库.JSON 作为 J;
导入 Web::{
    应用, 创建应用, 配置, 运行应用,
    实时路由带消息, 实时定时, 实时异步, 异步错误, 转义HTML
};

函数 初始状态() : 整数 {
    变量 状态: 整数 = J.创建对象();
    J.设置整数(状态, "秒", 0);
    J.设置整数(状态, "走着", 0);
    J.设置整数(状态, "计算中", 0);
    J.设置字符串(状态, "结果值", "");
    返回 状态;
}

函数 渲染(状态: 整数) : 字符串 {
    变量 走着: 整数 = J.获取整数(状态, "走着");
    变量 片段: 字符串 = "<h1>" + 整数转字符串(J.获取整数(状态, "秒")) + " 秒</h1>";

    如果 (走着 == 1) {
        片段 = 片段 + "<button data-click=\"停\">暂停</button>";
    } 否则 {
        片段 = 片段 + "<button data-click=\"走\">开始</button>";
    }
    片段 = 片段 + " <button class=\"ghost\" data-click=\"归零\">归零</button>";

    片段 = 片段 + "<div class=\"qi-card\">";
    如果 (J.获取整数(状态, "计算中") == 1) {
        // 秒表在这 2 秒里照常跳 —— 慢任务没有挡住连接循环
        片段 = 片段 + "<p class=\"qi-muted\">计算中…（秒表照走，说明没卡住）</p>";
    } 否则 {
        片段 = 片段 + "<button data-click=\"算\">算一道慢题（2 秒）</button>";
        变量 结果值: 字符串 = J.获取字符串(状态, "结果值");
        如果 (字符串::字节长度(结果值) > 0) {
            片段 = 片段 + "<p>结果：" + 转义HTML(结果值) + "</p>";
        }
    }
    片段 = 片段 + "</div>";
    返回 片段;
}

函数 处理事件(状态: 整数, 事件名: 字符串, 载荷JSON: 字符串) : 整数 {
    如果 (字符串::等于(事件名, "走") == 1 与 J.获取整数(状态, "走着") == 0) {
        J.设置整数(状态, "走着", 1);
        实时定时(状态, 1000, "滴答", "{}");
    }
    // 暂停不需要「取消定时器」：滴答 到了发现 走着==0 就不再续拍，自然停
    如果 (字符串::等于(事件名, "停") == 1) {
        J.设置整数(状态, "走着", 0);
    }
    如果 (字符串::等于(事件名, "归零") == 1) {
        J.设置整数(状态, "秒", 0);
    }

    如果 (字符串::等于(事件名, "算") == 1) {
        J.设置整数(状态, "计算中", 1);
        // 闭包在另一个协程里跑，**不能碰状态句柄**（状态归连接循环独有）；
        // 要用的值先在外面取出来捕获进去
        变量 起点: 整数 = J.获取整数(状态, "秒");
        实时异步(状态, "算好了", 闭包(): 字符串 {
            时间.睡眠毫秒(2000);
            返回 "从第 " + 整数转字符串(起点) + " 秒开始算的，答案是 42";
        });
    }
    返回 状态;
}

函数 处理消息(状态: 整数, 消息名: 字符串, 载荷JSON: 字符串) : 整数 {
    // 框架在首帧发完之后自动投一条，用来开表 / 起后台任务
    // （初始状态函数 里还没有邮箱，开不了）
    如果 (字符串::等于(消息名, "__上线__") == 1) {
        J.设置整数(状态, "走着", 1);
        实时定时(状态, 1000, "滴答", "{}");
    }

    如果 (字符串::等于(消息名, "滴答") == 1 与 J.获取整数(状态, "走着") == 1) {
        J.设置整数(状态, "秒", J.获取整数(状态, "秒") + 1);
        实时定时(状态, 1000, "滴答", "{}");   // 显式续下一拍
    }

    如果 (字符串::等于(消息名, "算好了") == 1) {
        J.设置整数(状态, "计算中", 0);
        变量 错文: 字符串 = 异步错误(载荷JSON);
        如果 (字符串::字节长度(错文) > 0) {
            J.设置字符串(状态, "结果值", "出错了：" + 错文);
        } 否则 {
            J.设置字符串(状态, "结果值", 载荷JSON);
        }
    }
    返回 状态;
}

函数 入口() {
    变量 应用值: 应用 = 配置(创建应用(), "127.0.0.1", 41551);
    应用值 = 实时路由带消息(应用值, "/", 初始状态, 渲染, 处理事件, 处理消息);
    打印行("秒表 + 异步慢任务：http://127.0.0.1:41551/");
    运行应用(应用值);   // 实时页面依赖 WS 升级，必须用同步 运行应用
}
