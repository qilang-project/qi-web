// 上传（对标 Phoenix allow_upload / live_file_input）
//
// 跑：qi run examples/实时_上传.qi   然后开 http://127.0.0.1:41556/
//
// 选文件（或者直接把文件拖到虚线框里）。文件跟着已经建好的 WebSocket 一块块送，
// 服务端边收边落盘，每收一块更新一次进度 —— 进度条就是普通的状态 → HTML，
// 这个文件里没有一行页面脚本。
//
// 传的过程中「保存」是灰的；传完点保存，文件才从「上传条目」变成业务数据。
包 主程序;

导入 标准库.字符串;
导入 标准库.JSON 作为 J;
导入 Web::{
    应用, 创建应用, 配置, 运行应用, HTML块, 实时块路由_无鉴权, 转义HTML,
    上传设置, 允许上传, 上传处理, 上传输入, 上传进度, 上传完成表, 上传空闲, 清空上传
};

函数 初始状态() : 整数 {
    变量 状态: 整数 = J.创建对象();
    // 一组上传：名字、接受什么、单个上限、最多几个、落到哪
    允许上传(状态, 上传设置("照片", "image/*", 4000000, 3, "/tmp/qi上传演示"));
    J.设置字符串(状态, "已存", "");
    返回 状态;
}

函数 渲染(状态: 整数) : HTML块 {
    变量 已存: 字符串 = J.获取字符串(状态, "已存");
    返回 HTML {
        <div>
            <h1>上传</h1>
            <p class="qi-muted">最多 3 张图，单张 4MB 以内。可以直接把文件拖进下面的框。</p>

            <div class="qi-card" data-upload-drop="照片">
                {上传输入(状态, "照片", "选照片，或拖进来")}
                {上传进度(状态, "照片")}
            </div>

            <p>
                <button data-click="保存" 如果={上传空闲(状态, "照片")}>保存</button>
                <span class="qi-muted" 如果={上传空闲(状态, "照片") == 假}>正在传…</span>
            </p>

            <div class="qi-card" 如果={字符串::字节长度(已存) > 0}>
                <h2>已存进业务的文件</h2>
                <pre class="qi-pre">{转义HTML(已存)}</pre>
            </div>
        </div>
    };
}

函数 处理事件(状态: 整数, 事件名: 字符串, 载荷JSON: 字符串) : 整数 {
    // 上传相关的帧（开始 / 每一块 / 取消）先让框架挑走
    如果 (上传处理(状态, 事件名, 载荷JSON) == 1) { 返回 状态; }

    如果 (字符串::等于(事件名, "保存") == 1) {
        // 完成表里每条是 {"id","name","size","done","err","path"}；
        // 真实应用在这里把 path 记进数据库、或者搬到最终目录
        变量 完成: 字符串 = 上传完成表(状态, "照片");
        变量 表: 整数 = J.解码(完成);
        变量 汇总: 字符串 = J.获取字符串(状态, "已存");
        如果 (表 > 0) {
            变量 总数: 整数 = J.数组长度(表);
            变量 i: 整数 = 0;
            当 (i < 总数) {
                变量 条目: 整数 = J.数组获取对象(表, i);
                如果 (条目 > 0) {
                    汇总 = 汇总 + J.获取字符串(条目, "name") + "  ("
                        + 整数转字符串(J.获取整数(条目, "size")) + " 字节)  → "
                        + J.获取字符串(条目, "path") + "\n";
                    J.删除(条目);
                }
                i = i + 1;
            }
            J.删除(表);
        }
        J.设置字符串(状态, "已存", 汇总);
        // 消费完把条目清掉（**不删文件** —— 文件已经归业务了）
        清空上传(状态, "照片");
    }
    返回 状态;
}

函数 入口() {
    变量 应用值: 应用 = 配置(创建应用(), "127.0.0.1", 41556);
    应用值 = 实时块路由_无鉴权(应用值, "/", 初始状态, 渲染, 处理事件);
    打印行("上传：http://127.0.0.1:41556/   （落盘到 /tmp/qi上传演示）");
    运行应用(应用值);
}
