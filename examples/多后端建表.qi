// qi-web 示例 · 一份建表声明 → 三个后端的 DDL
//
// 证明 建表.qi 的方言层：同一个 卡片表(后端) 声明，在 sqlite / postgres / mysql
// 下产出三段语义等价、语法各自合法的 CREATE TABLE，并在 SQLite 上真跑一遍
// （建表 → 插入 → 读回默认值），确认生成的 DDL 不只是字符串对得上。
//
// 运行：qi run qi-web/examples/多后端建表.qi
包 主程序;

导入 标准库.字符串;
导入 标准库.数据库;
导入 Web.建表::{
    表定义, 新建表, 当前后端,
    列自增主键, 列整数, 列文本, 列长文本, 列浮点, 列布尔, 列时间戳,
    非空, 唯一, 默认文本, 默认整数, 默认浮点, 默认布尔, 默认当前时间,
    唯一组, 生成建表SQL, 事务建表,
    当前时间表达式, 冲突更新子句
};
导入 Web.迁移::{执行迁移, 当前迁移版本};
导入 Web.查询::{行集, 新建行, 置文本, 置整数, 插入, 表, 计数, 标量字符串};

函数 断言(条件: 整数, 消息: 字符串) {
    如果 (条件 == 0) { 抛出 消息; }
}

函数 断言串(实际: 字符串, 期望: 字符串, 消息: 字符串) {
    如果 字符串::等于(实际, 期望) == 0 {
        抛出 消息 + "\n  期望：" + 期望 + "\n  实际：" + 实际;
    }
}

// ── 唯一的一份声明 ──────────────────────────────────────────────
// 除了开头那个 后端 字符串，下面没有任何一处方言。
函数 卡片表(后端: 字符串) : 表定义 {
    变量 定义: 表定义 = 新建表(后端, "卡片");
    定义 = 列自增主键(定义, "id");
    定义 = 非空(列整数(定义, "用户id"));
    定义 = 默认文本(非空(列文本(定义, "标题")), "无题");
    定义 = 唯一(列文本(定义, "编号"));
    定义 = 列长文本(定义, "正文");
    定义 = 默认浮点(列浮点(定义, "权重"), 1.5);
    定义 = 默认布尔(非空(列布尔(定义, "已归档")), 假);
    定义 = 默认当前时间(列时间戳(定义, "创建时间"));
    定义 = 默认整数(列整数(定义, "复习次数"), 0);
    定义 = 唯一组(定义, "用户id, 编号");
    返回 定义;
}

// ── 三段 DDL ────────────────────────────────────────────────────
函数 核对三后端() {
    变量 SQLiteDDL: 字符串 = 生成建表SQL(卡片表("sqlite"));
    打印行("── sqlite ──\n" + SQLiteDDL);
    断言串(SQLiteDDL,
        "CREATE TABLE IF NOT EXISTS 卡片 ("
        + "id INTEGER PRIMARY KEY AUTOINCREMENT, "
        + "用户id INTEGER NOT NULL, "
        + "标题 TEXT NOT NULL DEFAULT '无题', "
        + "编号 TEXT UNIQUE, "
        + "正文 TEXT, "
        + "权重 REAL DEFAULT 1.5, "
        + "已归档 INTEGER NOT NULL DEFAULT 0, "
        + "创建时间 TEXT DEFAULT (datetime('now')), "
        + "复习次数 INTEGER DEFAULT 0"
        + ", UNIQUE (用户id, 编号))",
        "SQLite DDL 不符");

    变量 PG串: 字符串 = 生成建表SQL(卡片表("postgres"));
    打印行("── postgres ──\n" + PG串);
    断言串(PG串,
        "CREATE TABLE IF NOT EXISTS 卡片 ("
        + "id BIGSERIAL PRIMARY KEY, "
        + "用户id BIGINT NOT NULL, "
        + "标题 TEXT NOT NULL DEFAULT '无题', "
        + "编号 TEXT UNIQUE, "
        + "正文 TEXT, "
        + "权重 DOUBLE PRECISION DEFAULT 1.5, "
        + "已归档 BOOLEAN NOT NULL DEFAULT FALSE, "
        + "创建时间 TIMESTAMPTZ DEFAULT now(), "
        + "复习次数 BIGINT DEFAULT 0"
        + ", UNIQUE (用户id, 编号))",
        "PostgreSQL DDL 不符");

    变量 MySQL串: 字符串 = 生成建表SQL(卡片表("mysql"));
    打印行("── mysql ──\n" + MySQL串);
    断言串(MySQL串,
        "CREATE TABLE IF NOT EXISTS 卡片 ("
        + "id BIGINT AUTO_INCREMENT PRIMARY KEY, "
        + "用户id BIGINT NOT NULL, "
        + "标题 VARCHAR(255) NOT NULL DEFAULT '无题', "
        + "编号 VARCHAR(255) UNIQUE, "
        + "正文 TEXT, "
        + "权重 DOUBLE DEFAULT 1.5, "
        + "已归档 TINYINT(1) NOT NULL DEFAULT 0, "
        + "创建时间 DATETIME DEFAULT CURRENT_TIMESTAMP, "
        + "复习次数 BIGINT DEFAULT 0"
        + ", UNIQUE (用户id, 编号)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4",
        "MySQL DDL 不符");
}

// ── 别名与 DML 侧片段 ───────────────────────────────────────────
函数 核对片段() {
    断言串(生成建表SQL(卡片表("postgresql")), 生成建表SQL(卡片表("pg")),
        "postgresql / pg 应规范到同一后端");
    断言串(生成建表SQL(卡片表("mariadb")), 生成建表SQL(卡片表("mysql")),
        "mariadb 应规范到 mysql");

    断言串(当前时间表达式("sqlite"), "datetime('now')", "sqlite 当前时间表达式不符");
    断言串(当前时间表达式("postgres"), "now()", "postgres 当前时间表达式不符");
    断言串(当前时间表达式("mysql"), "NOW()", "mysql 当前时间表达式不符");

    变量 冲突PG: 字符串 = 冲突更新子句("postgres", "用户id, 编号", "标题, 权重");
    打印行("── upsert postgres ──\n" + 冲突PG);
    断言串(冲突PG,
        " ON CONFLICT (用户id, 编号) DO UPDATE SET 标题 = excluded.标题, 权重 = excluded.权重",
        "PG upsert 子句不符");
    断言串(冲突更新子句("sqlite", "用户id, 编号", "标题, 权重"), 冲突PG,
        "SQLite 与 PG 的 upsert 语法应一致");

    变量 冲突MySQL: 字符串 = 冲突更新子句("mysql", "用户id, 编号", "标题, 权重");
    打印行("── upsert mysql ──\n" + 冲突MySQL);
    断言串(冲突MySQL,
        " ON DUPLICATE KEY UPDATE 标题 = VALUES(标题), 权重 = VALUES(权重)",
        "MySQL upsert 子句不符");
}

// ── 护栏：不该产出的 DDL 必须当场报错，而不是留到线上炸 ─────────
函数 核对护栏() {
    变量 中招: 整数 = 0;

    尝试 {
        变量 坏定义: 表定义 = 新建表("mysql", "笔记");
        坏定义 = 唯一(列长文本(坏定义, "正文"));   // MySQL 的 TEXT 不能整列唯一
        生成建表SQL(坏定义);
    } 捕获 错误 {
        中招 = 中招 + 1;
    }
    断言(中招 == 1, "MySQL 长文本唯一索引应被拒绝");

    尝试 {
        变量 坏定义2: 表定义 = 新建表("sqlite", "笔记");
        坏定义2 = 非空(坏定义2);                   // 没有可修饰的列
    } 捕获 错误 {
        中招 = 中招 + 1;
    }
    断言(中招 == 2, "无待定列时的修饰应被拒绝");

    尝试 {
        变量 坏定义3: 表定义 = 新建表("sqlite", "笔记");
        坏定义3 = 列文本(坏定义3, "标题; DROP TABLE 卡片");
    } 捕获 错误 {
        中招 = 中招 + 1;
    }
    断言(中招 == 3, "非法列名应被拒绝");

    // 默认值里的单引号按 SQL 标准双写（三家一致）。
    变量 引号定义: 表定义 = 新建表("sqlite", "书");
    引号定义 = 默认文本(列文本(引号定义, "出版社"), "O'Reilly");
    断言(字符串::包含(生成建表SQL(引号定义), "DEFAULT 'O''Reilly'") == 1,
        "默认值单引号未按 SQL 标准转义");
    打印行("── 护栏 ──\n三条非法声明全部当场抛出；默认值单引号转义正确");
}

// ── 真跑一遍：迁移里建表 → 插入 → 读回默认值 ──────────────────
函数 迁移一(事务: 整数) : 整数 {
    返回 事务建表(事务, 卡片表(当前后端()));
}

函数 核对真库() {
    变量 库: 整数 = 数据库.连接(":memory:");
    断言(执行迁移(库, "模式迁移", 1, "创建卡片", 迁移一) == 1, "建表迁移失败");
    断言(当前迁移版本(库, "模式迁移") == 1, "迁移版本未推进");

    变量 一行: 行集 = 新建行();
    一行 = 置整数(一行, "用户id", 7);
    一行 = 置文本(一行, "编号", "K-001");
    断言(插入(库, "卡片", 一行) > 0, "插入失败");
    断言(计数(表(库, "卡片")) == 1, "应有一行");

    变量 标题值: 字符串 = 标量字符串(库, "SELECT 标题 FROM 卡片", "标题");
    断言串(标题值, "无题", "列默认值未生效");
    数据库.关闭(库);
    打印行("── SQLite 实跑 ──\n迁移建表成功，插入后 标题 取到默认值「" + 标题值 + "」");
}

函数 入口() {
    核对三后端();
    核对片段();
    核对护栏();
    核对真库();
    打印行("\n多后端建表：同一份声明在 sqlite / postgres / mysql 上产出三段等价 DDL，全部核对通过");
}
