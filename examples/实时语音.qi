// 实时语音示例：对着浏览器说英语，AI 用语音回答。
//
//   浏览器 ⇄(WS-A)⇄ 本程序 ⇄(WS-B, wss + Authorization)⇄ 百炼实时语音模型
//
// 跑：
//   export DASHSCOPE_API_KEY=sk-…
//   QI_PACKAGES_PATH=… qi run 实时语音.qi
//   浏览器打开 http://127.0.0.1:41777/
//
// 页面本身是一个 LiveView 页（状态指示由服务端渲染），麦克风和音频播放归
// data-hook 里的 JS 管 —— 这正是 hook 存在的理由：AudioContext / WebSocket /
// 定时器这类有生命周期的东西，服务端渲染碰不了，得有人在 mounted 建、
// destroyed 拆。转写文字量大又高频，留在客户端直接写 DOM，不往服务端绕。
//
// ⚠ JS 里的标识符一律英文 —— 中文只写在 qi 里。
包 主程序;

导入 标准库.字符串;
导入 标准库.JSON 作为 J;
导入 标准库.操作系统 作为 系统;
导入 Web::{
    应用, 创建应用, 配置,
    实时路由_无鉴权, 实时语音路由,
    转义HTML, 运行应用
};

导入 ./语音前端;

// 百炼实时语音端点。换 OpenAI Realtime 只改这一行 + 实时语音.qi 里的会话帧。
常量 模型网址: 字符串 = "wss://dashscope.aliyuncs.com/api-ws/v1/realtime?model=qwen3-omni-flash-realtime";

常量 系统提示: 字符串 = "You are a friendly English speaking partner for a Chinese learner. "
    + "Always reply in English only. Keep every reply under two short sentences. "
    + "Speak slowly and clearly, and gently correct obvious grammar mistakes.";

// ── 服务端状态：只存一个连接状态字 ────────────────────────────────
//
// 音频完全不经过 LiveView 这条连接（它走 /voice/ws），这里只是让「现在到哪一步了」
// 由服务端渲染 —— 顺带证明两条 WS 连接可以在同一个页面上和平共处。
函数 初始状态() : 整数 {
    变量 状态: 整数 = J.创建对象();
    J.设置字符串(状态, "阶段", "idle");
    返回 状态;
}

函数 阶段说法(阶段: 字符串) : 字符串 {
    如果 (字符串::等于(阶段, "connecting") == 1) { 返回 "正在连接语音服务…"; }
    如果 (字符串::等于(阶段, "listening") == 1) { 返回 "在听你说 —— 直接开口就行"; }
    如果 (字符串::等于(阶段, "speaking") == 1) { 返回 "AI 正在回答…"; }
    如果 (字符串::等于(阶段, "error") == 1) { 返回 "出错了，看下面的日志"; }
    返回 "麦克风没开";
}

函数 渲染(状态: 整数) : 字符串 {
    变量 阶段: 字符串 = J.获取字符串(状态, "阶段");
    // 按钮文字**由服务端渲染**，hook 不去改它。
    // 试过让 JS 写 textContent —— 下一帧 morph 就按服务端的模板改回去了，
    // 麦克风明明开着按钮却写着「开麦克风」。凡是服务端渲染过的东西，
    // 状态就得回服务端走一圈（hook 已经在 push 阶段了，这里直接用）。
    变量 按钮文字: 字符串 = "开麦克风";
    如果 (字符串::等于(阶段, "idle") == 0 与 字符串::等于(阶段, "error") == 0) {
        按钮文字 = "关麦克风";
    }
    变量 片段: 字符串 = 语音脚本();
    片段 = 片段 + "<h1>对着说英语</h1>";
    片段 = 片段 + "<p class=\"qi-muted\">点开麦克风，直接说话；说完停一下，AI 会用语音回答。</p>";
    片段 = 片段 + "<p><button data-hook=\"VoiceMic\" data-key=\"mic\" id=\"mic\" class=\"block\">"
                + 按钮文字 + "</button></p>";
    片段 = 片段 + "<p class=\"qi-badge\">" + 转义HTML(阶段说法(阶段)) + "</p>";
    // 转写和日志由 hook 直接写：量大、高频，往服务端绕一圈没有意义。
    // data-ignore 保子树不被 morph 覆盖，data-key 保节点身份不被换掉。
    片段 = 片段 + "<h3>它听到 / 它说的</h3>";
    片段 = 片段 + "<div id=\"transcript\" class=\"qi-card\" data-key=\"tr\" data-ignore></div>";
    片段 = 片段 + "<h3>日志</h3>";
    片段 = 片段 + "<pre id=\"log\" class=\"qi-pre\" data-key=\"log\" data-ignore></pre>";
    返回 片段;
}

// hook 把「现在到哪一步」推上来（ctx.push），服务端只负责显示。
函数 处理事件(状态: 整数, 事件名: 字符串, 载荷JSON: 字符串) : 整数 {
    如果 (字符串::等于(事件名, "语音阶段") == 1) {
        变量 载荷: 整数 = J.解码(载荷JSON);
        如果 (载荷 > 0) {
            J.设置字符串(状态, "阶段", J.获取字符串(载荷, "phase"));
            J.删除(载荷);
        }
    }
    返回 状态;
}

函数 入口() {
    变量 密钥: 字符串 = 系统.获取环境变量("DASHSCOPE_API_KEY");
    如果 (字符串::字节长度(密钥) == 0) {
        打印行("请先 export DASHSCOPE_API_KEY=…（密钥只留在服务器，不会下发给浏览器）");
        返回;
    }
    变量 端口: 整数 = 41777;
    变量 应用值: 应用 = 创建应用();
    应用值 = 配置(应用值, "127.0.0.1", 端口);
    应用值 = 实时路由_无鉴权(应用值, "/", 初始状态, 渲染, 处理事件);
    应用值 = 实时语音路由(应用值, "/voice/ws", 模型网址, 密钥, 系统提示);
    打印行("实时语音示例：http://127.0.0.1:" + 整数转字符串(端口) + "/");
    运行应用(应用值);
}
